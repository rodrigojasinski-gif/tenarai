  #**************************************************************************************
  INPUT_FILENAME=${JOBNAME}_step515_oemrecs_sort.tmp
  OUTPUT_HTRANS=${JOBNAME}_step530_htrans_${JOBFILE_OEMCTRY}.tmp
  OUTPUT_PTRANS=${JOBNAME}_step530_ptrans_${JOBFILE_OEMCTRY}.tmp
