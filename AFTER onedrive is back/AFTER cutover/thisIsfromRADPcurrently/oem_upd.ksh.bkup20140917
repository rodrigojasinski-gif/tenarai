#!/bin/ksh
echo "RCS $Id: oem_upd.ksh,v 1.11 2010/04/10 20:35:06 jw97143 Exp $"
set -xv
print ProcessId = $$
#*************************************************************************************************
# PROCNAME oem_upd.ksh   OEM Update Job Script
#*************************************************************************************************
trap 'oem_abndalrt.ksh $?' err
export PROCNAME=$(basename $0 .ksh_run)
export MPTUSERID=`cat ${RACE}/prm/zmptpass.prm`
export LOGFILE=$(basename ${JOBLOGNAME})
#*************************************************************************************************
#  Build environment variables for the job (based on jobname)
#*************************************************************************************************
. oem_job.ksh
. oem_job_notify.ksh
#*************************************************************************************************

#STEP Step010R
  export STEPNAME=Step010R
  echo "    Start " ${STEPNAME} "    "$(date)
  oem_job_status_update.ksh "R" "${STEPNAME} Delete datasets"
  #***************************************************************************************
  #  Step010R - Delete datasets that will be created in future steps
  #***************************************************************************************
  rm -f ${RACE}/dat/${JOBNAME}*.tmp*
  rm -f ${RACE}/tmp/${JOBNAME}*
  
  # Temporary while running parallel processing for Reverse Supersession Analysis
  rm -f ${RACE}/rpt/${JOBNAME}*new*
  rm -f ${RACE}/rpt/${JOBNAME}*old*
  #^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  

#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#
#  Steps 020 thru 090 are ONLY run for jobs 
#  which require "Reverse Analysis" processing
#
#STEP Step020R
  export STEPNAME=Step020R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Delete datasets"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Delete datasets"
    #*********************************************************************************************
    #  Step020R - Delete datasets
    #*********************************************************************************************
    rm -f ${RACE}/dat/${JOBNAME}_htrans_1_generate.tmp
    rm -f ${RACE}/dat/${JOBNAME}_rtrans_1_generate.tmp
  fi


#STEP Step030R
  export STEPNAME=Step030R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Sort NTRANS by trans, old part, and new part"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Sort NTRANS by trans, old part, and new part"
    #*********************************************************************************************
    #  Step030R - Sort NTRANS by trans, old part, and new part prior to Supersession Analysis 
    #             Program use.                             
    #*********************************************************************************************
    SORTIN_FILE=${RACE}/dat/${REFORMATJOB}_ntrans.tmp
    SORTOUT_FILE=${RACE}/dat/${JOBNAME}_ntrans_sort.tmp
    #      +---------|----------|-----------|
    #      |TRANSCODE| OLD PART | NEW PART  |
    #      +---------|----------|-----------|
    sort -u -k1.1,1.1 -k1.7,1.31 -k1.32,1.56 -o ${SORTOUT_FILE} ${SORTIN_FILE}
  fi


#STEP Step040R - COBOL
  export STEPNAME=Step040R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Executes mptz012 - Supersession Analysis Program"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Executes mptz012 - Supersession Analysis Program"
    #*********************************************************************************************
    #  Step040R - Executes mptz012 - Supersession Analysis Program
    #             Note:  The HTRANS file doesn't go anywhere.
    #*********************************************************************************************
    export DD_PARMIN1=${RACE}/prm/${JOBPARM}.prm
    export DD_PARMIN2=${RACE}/prm/zmpt032.prm
    export DD_TRANSIN=${RACE}/dat/${JOBNAME}_ntrans_sort.tmp
    export DD_RTRANOUT=${RACE}/dat/${JOBNAME}_rtrans_1_generate.tmp
    export DD_HTRANOUT=${RACE}/dat/${JOBNAME}_htrans_1_generate.tmp
    export DD_AUDITRPT=${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX}.pip
          printpipe -o ${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX}
          printpipe -r ${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX} rpt   
    mptz012 2>&1 
          printpipe -c ${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX}
  fi


#STEP Step041R - PL/SQL
  export STEPNAME=Step041R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Executes pkg_oem_upd_rtrans_1_generate - Supersession Analysis Program"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Executes pkg_oem_upd_rtrans_1_generate - Supersession Analysis Program"
    #*********************************************************************************************
    #  Step041R - Executes pkg_oem_upd_rtrans_1_generate
    #             Note:  The HTRANS file doesn't go anywhere.
    #*********************************************************************************************    
    NTRANSIN=${REFORMATJOB}_ntrans.tmp
    RTRANSOUT=${JOBNAME}_rtrans_1_generate.new.tmp
    HTRANSOUT=${JOBNAME}_htrans_1_generate.new.tmp  
             REPORT_FILENAME=${JOBNAME}b_sana${REPORTSUFFIX}.new.pip
    printpipe -o ${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX}.new
    printpipe -r ${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX}.new rpt
#----------------------------------------------------------------------------------------
(sqlplus -s << % 2>&1)
${MPTUSERID}
SET ECHO ON;
SET FEEDBACK ON;
SET VERIFY ON;
SET LINESIZE 80;
SET SERVEROUTPUT ON;
whenever sqlerror exit sql.sqlcode
    exec pkg_oem_upd_rtrans_1_generate.p_main_procedure(p_update_job           => '${JOBNAME}',          \
                                                        p_log_directory        => '${OBJ_LOGDIR}',       \
                                                        p_log_filename         => '${LOGFILE}',          \
                                                        p_ntrans_in_directory  => '${OBJ_DATDIR}',       \
                                                        p_ntrans_in_filename   => '${NTRANSIN}',         \
                                                        p_rtrans_out_directory => '${OBJ_DATDIR}',       \
                                                        p_rtrans_out_filename  => '${RTRANSOUT}',        \
                                                        p_htrans_out_directory => '${OBJ_DATDIR}',       \
                                                        p_htrans_out_filename  => '${HTRANSOUT}',        \
                                                        p_report_directory     => '${OBJ_RPTDIR}',       \
                                                        p_report_filename      => '${REPORT_FILENAME}',  \
                                                        p_debug_level          => '1',                   \
                                                        p_dbms_profiler_flag   => '${RACE_DBMS_PROFILER_FLAG}');
QUIT;
%
#----------------------------------------------------------------------------------------
    printpipe -c ${RACE}/rpt/${JOBNAME}b_sana${REPORTSUFFIX}.new
  fi

#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#STEP Step042
  export STEPNAME=Step042
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "Skipping ${STEPNAME} Comparing Report Counters"
  else
    #----------------------------------------------------------------------
    COBOL_REPORT=`ls -r1 ${RACE}/rpt/${JOBNAME}b_sana*.rpt | head -1`
    PLSQL_REPORT=`ls -r1 ${RACE}/rpt/${JOBNAME}b_sana*new*.rpt | head -1`
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep '** TOTAL - NEW TRANSACTIONS' ${COBOL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep '** Total - New Transactions' ${PLSQL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK ** Total New Transactions Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Total New Transactions Count Different\n"  > ${MAIL_TEXT}
      echo " "                                        >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}             >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}             >> ${MAIL_TEXT}
      echo " "                                        >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Total New Transactions Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Total New Transactions Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep '** TOTAL TRANSACTIONS WITH MATCHING SUPER' ${COBOL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }'  )
    PLSQL_COUNT=$(grep '** Total Transactions With Matching Super' ${PLSQL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Total Transactions With Matching Supersessions Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Total Transactions With Matching Supersessions Count Different!\n" > ${MAIL_TEXT}
      echo " "                                                                >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}                                     >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}                                     >> ${MAIL_TEXT}
      echo " "                                                                >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Total Transactions With Matching Supersessions Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Total Transactions With Matching Supersessions Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep '** TOTAL SUPERSESSIONS WITHOUT MATCHING TRANS' ${COBOL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep '** Total Supersessions Without Matching Trans' ${PLSQL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Total Supersessions Without Matching Trans Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Total Supersessions Without Matching Trans Count Different!\n" > ${MAIL_TEXT}
      echo " "                                                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}                                 >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}                                 >> ${MAIL_TEXT}
      echo " "                                                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Total Supersessions Without Matching Trans Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Total Supersessions Without Matching Trans Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep '** TOTAL REVERSE SUPERSESSION TRANS WRITTEN' ${COBOL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep '** Total Reverse Supersession Trans Written' ${PLSQL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ] 
    then
      echo "OK ** Total Reverse Supersession Trans Written Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "** Total Reverse Supersession Trans Written Count Different!\n" > ${MAIL_TEXT}
      echo " "                                                             >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}                                  >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}                                  >> ${MAIL_TEXT}
      echo " "                                                             >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Total Reverse Supersession Trans Written Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Total Reverse Supersession Trans Written Count Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep '** TOTAL HISTORICAL SUPERSESSION TRANS WRITTEN' ${COBOL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep '** Total Historical Supersession Trans Written' ${PLSQL_REPORT} | tr -d ',' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK ** Total Historical Supersession Trans Written Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "** Total Historical Supersession Trans Written Count Different!\n" > ${MAIL_TEXT}
      echo " "                                                                >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}                                     >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}                                     >> ${MAIL_TEXT}
      echo " "                                                                >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Total Historical Supersession Trans Written!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Total Historical Supersession Trans Written!" ${MAIL_TO} < ${MAIL_TEXT}
      fi     
    fi
    ###################################################################################################################################
    # COMPARE RTrans Files
    OLD_FILE=${RACE}/dat/${JOBNAME}_rtrans_1_generate.tmp
    OLD_FILE_SORTED=${RACE}/dat/${JOBNAME}_rtrans_1_generate.old.sort.tmp
    sort -o ${OLD_FILE_SORTED} ${OLD_FILE}
    NEW_FILE=${RACE}/dat/${JOBNAME}_rtrans_1_generate.new.tmp
    NEW_FILE_SORTED=${RACE}/dat/${JOBNAME}_rtrans_1_generate.new.sort.tmp
    sort -o ${NEW_FILE_SORTED} ${NEW_FILE}    
    #DIFF_FILE_RTRANS=${RACE}/dat/${JOBNAME}_rtrans_1_generate.diff.tmp
    DIFF_FILE_RTRANS=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_1_generate_diff.dat(+1)" NEW 1)
    # Turn trap off since "diff" will return a 1 if files are different
    # The trap is turned back on after the "if"
    trap - err        
    diff -wb ${OLD_FILE_SORTED} ${NEW_FILE_SORTED} > ${DIFF_FILE_RTRANS}         
    if [ -s ${DIFF_FILE_RTRANS} ]
    then
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "${JOBNAME} mptz012 Reverse Files Different\n"  > ${MAIL_TEXT}
      echo ${DIFF_FILE_RTRANS}                            >> ${MAIL_TEXT} 
      echo " "                                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: mptz012r Reverse Files Different!" ${MAIL_TO} < ${MAIL_TEXT}
        trap 'oem_abndalrt.ksh $?' err
        exit 777
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: mptz012r Reverse Files Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    else
      # Cleanup Files used to compare RTrans 
      rm -f ${NEW_FILE}
      rm -f ${OLD_FILE_SORTED}
      rm -f ${NEW_FILE_SORTED}
    fi
    trap 'oem_abndalrt.ksh $?' err
    ###################################################################################################################################
    ###################################################################################################################################
    # COMPARE HTrans Files
    OLD_FILE=${RACE}/dat/${JOBNAME}_htrans_1_generate.tmp
    OLD_FILE_SORTED=${RACE}/dat/${JOBNAME}_htrans_1_generate.old.sort.tmp
    sort -o ${OLD_FILE_SORTED} ${OLD_FILE}
    NEW_FILE=${RACE}/dat/${JOBNAME}_htrans_1_generate.new.tmp
    NEW_FILE_SORTED=${RACE}/dat/${JOBNAME}_htrans_1_generate.new.sort.tmp
    sort -o ${NEW_FILE_SORTED} ${NEW_FILE}    
    #DIFF_FILE_HTRANS=${RACE}/dat/${JOBNAME}_htrans_1_generate.diff.tmp
    DIFF_FILE_HTRANS=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_htrans_1_generate_diff.dat(+1)" NEW 1)
    # Turn trap off since "diff" will return a 1 if files are different
    # The trap is turned back on after the "if"
    trap - err        
    diff -wb ${OLD_FILE_SORTED} ${NEW_FILE_SORTED} > ${DIFF_FILE_HTRANS}         
    if [ -s ${DIFF_FILE_HTRANS} ]
    then
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "mptz012 History Files Different\n"  > ${MAIL_TEXT}
      echo ${DIFF_FILE_HTRANS}                 >> ${MAIL_TEXT} 
      echo " "                                 >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: mptz012 History Files Different!" ${MAIL_TO} < ${MAIL_TEXT}
        trap 'oem_abndalrt.ksh $?' err
        exit 777
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: mptz012 History Files Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    else
      # Cleanup Files used to compare HTrans 
      rm -f ${NEW_FILE}
      rm -f ${OLD_FILE_SORTED}
      rm -f ${NEW_FILE_SORTED}
    fi
    trap 'oem_abndalrt.ksh $?' err
    ###################################################################################################################################
  fi  
#
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


#STEP Step050R
  export STEPNAME=Step050R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Sort RTRANS by old part number and new part number"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Sort RTRANS by old part number and new part number"
    #*********************************************************************************************
    #  Step050R - Sort RTRANS by old part number, new part number, reason
    #             and create backup files
    #*********************************************************************************************
    SORTIN_FILE=${RACE}/dat/${JOBNAME}_rtrans_1_generate.tmp
    SORTOUT_FILE=${RACE}/dat/${JOBNAME}_rtrans_1_generate_sort.tmp
    #   +----------|-----------|-----------|
    #   | OLD PART | NEW PART  | REASON    |
    #   +----------|-----------|-----------|
    sort -k1.7,1.31 -k1.32,1.56 -k1.67,1.91r -o ${SORTOUT_FILE} ${SORTIN_FILE}
    mv               ${RACE}/dat/${JOBNAME}_rtrans_1_generate_sort.tmp \
       $(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_1_generate_${JOBFILE_OEMCTRY}.dat(+1)" NEW 3)
    
  fi


#STEP Step060R
  export STEPNAME=Step060R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo " Skipping ${STEPNAME} Builds Combo File for loading Global Temp Table"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Builds Combo File for loading Global Temp Table"
    #*********************************************************************************************
    #  Step060R -                              Builds Combo File for loading Global Temp Table
    #             mpt_elim_dup_tran.awk keeps ONE transaction per old part number in the above order
    #*********************************************************************************************
    SORTIN_FILE="${RACE}/dat/${REFORMATJOB}_atrans.tmp \
                 ${RACE}/dat/${REFORMATJOB}_ctrans.tmp \
                 ${RACE}/dat/${REFORMATJOB}_ntrans.tmp \
                 ${RACE}/dat/${REFORMATJOB}_ptrans.tmp "
    SORTOUT_FILE=${RACE}/dat/${JOBNAME}_trans_comb.tmp
    #   +----------+               +------------------------------------------------------------+
    #   | OLD PART |               |Keep ONE Transaction per OLD Part                           |
    #   +----------+               +------------------------------------------------------------+
    sort -k1.7,1.31 ${SORTIN_FILE} | awk -f ${RACE}/bin/mpt_elim_dup_tran.awk > ${SORTOUT_FILE}
  fi


#STEP Step070R
  export STEPNAME=Step070R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Delete and define VSAM cluster - Parts List File"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Delete and define VSAM cluster - Parts List File"
    #*********************************************************************************************
    #  Step060R - Delete and define VSAM cluster - Parts List File
    #             Create it from price transactions (For compare against reverse supers)
    #*********************************************************************************************
    rm -f ${RACE}/dat/${JOBNAME}_partlist_ksds.tmp
    rm -f ${RACE}/dat/${JOBNAME}_partlist_ksds.tmp.idx
    rm -f ${RACE}/tmp/${JOBNAME}In
    cp ${RACE}/dat/${JOBNAME}_trans_comb.tmp ${RACE}/tmp/${JOBNAME}In
    rebuild ${RACE}/tmp/${JOBNAME}In, ${RACE}/tmp/${JOBNAME}Out -k:7+25 -o:lseq,ind -t:c-isam -r:F187
    # -k:7+25          # Define primary Key (Starting position + Length)
    # -o:leseq,ind     # (organization of input, indexed)
    # -t:c-isam        # Specifies index format of output file
    # -r:F187          # Specifies record type(F = Fixed, V = Variable) and record length
    mv ${RACE}/tmp/${JOBNAME}Out     ${RACE}/dat/${JOBNAME}_partlist_ksds.tmp
    mv ${RACE}/tmp/${JOBNAME}Out.idx ${RACE}/dat/${JOBNAME}_partlist_ksds.tmp.idx
  fi


#STEP Step080R
  export STEPNAME=Step080R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} Delete datasets"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} Delete datasets"
    rm -f ${RACE}/dat/${JOBNAME}_rtrans_2_adjust.tmp
  fi


#STEP Step085R - PL/SQL
  export STEPNAME=Step085R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} - pkg_oem_upd_rtrans_2_adjust"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} - pkg_oem_upd_rtrans_2_adjust"
    #*********************************************************************************************
    #  Step085R - Executes pkg_oem_upd_rtrans_2_adjust - Reverse Super Pre-Processor Program
    #*********************************************************************************************
    RTRANS_FILEPATH=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_1_generate_${JOBFILE_OEMCTRY}.dat(0)")    
    RTRANSIN=$( basename ${RTRANS_FILEPATH} )     
    NON_RTRANSIN=${JOBNAME}_trans_comb.tmp
    RTRANSOUT=${JOBNAME}_rtrans_2_adjust.new.tmp   
             REPORT_FILENAME=${JOBNAME}r_spre${REPORTSUFFIX}.new.pip
    printpipe -o ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.new
    printpipe -r ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.new rpt
#----------------------------------------------------------------------------------------
(sqlplus -s << % 2>&1)
${MPTUSERID}
SET ECHO ON;
SET FEEDBACK ON;
SET VERIFY ON;
SET LINESIZE 80;
SET SERVEROUTPUT ON;
whenever sqlerror exit sql.sqlcode
    exec pkg_oem_upd_rtrans_2_adjust.p_main_procedure(p_update_job              => '${JOBNAME}',          \
                                                      p_log_directory           => '${OBJ_LOGDIR}',       \
                                                      p_log_filename            => '${LOGFILE}',          \
                                                      p_rtrans_in_directory     => '${OBJ_DATDIR}',       \
                                                      p_rtrans_in_filename      => '${RTRANSIN}',         \
                                                      p_non_rtrans_in_directory => '${OBJ_DATDIR}',       \
                                                      p_non_rtrans_in_filename  => '${NON_RTRANSIN}',     \
                                                      p_rtrans_out_directory    => '${OBJ_DATDIR}',       \
                                                      p_rtrans_out_filename     => '${RTRANSOUT}',        \
                                                      p_report_directory        => '${OBJ_RPTDIR}',       \
                                                      p_report_filename         => '${REPORT_FILENAME}',  \
                                                      p_debug_level             => '9', \
                                                      p_dbms_profiler_flag      => '${RACE_DBMS_PROFILER_FLAG}');                            
QUIT;
%
#----------------------------------------------------------------------------------------
    printpipe -c ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.new
  fi


