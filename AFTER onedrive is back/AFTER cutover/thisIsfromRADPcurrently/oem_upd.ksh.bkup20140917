#STEP Step086 - COBOL RPTONLY HARDCODED
  export STEPNAME=Step086
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} mptz016r - RPTONLY Reverse Super Pre-Processor Program"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} mptz016r - RPTONLY Reverse Super Pre-Processor Program"
    #*********************************************************************************************
    #  Step086 - Executes mptz016r - RPTONLY Reverse Super Pre-Processor Program
    #*********************************************************************************************
    export DD_PARMIN=${RACE}/prm/${REVERSE_SUPER_JOBPARM}.prm
    export DD_TRANSIN=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_1_generate_${JOBFILE_OEMCTRY}.dat(0)")
    export DD_TRANSOUT=${RACE}/dat/${JOBNAME}_rtrans_2_adjust.old.tmp
    export DD_PARTFILE=${RACE}/dat/${JOBNAME}_partlist_ksds.tmp
    export DD_CNTLRPT=${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.old.pip
         printpipe -o ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.old
         printpipe -r ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.old rpt
         
    mptz016r 2>&1
    
         printpipe -c ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.old
  fi
 
  
#STEP Step087
  export STEPNAME=Step087
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "Skipping ${STEPNAME} Comparing Report Counters"
  else
    #--------------------------------------------------------------------
    COBOL_REPORT=`ls -r1 ${RACE}/rpt/${JOBNAME}r_spre*old*.rpt | head -1`
    PLSQL_REPORT=`ls -r1 ${RACE}/rpt/${JOBNAME}r_spre*new*.rpt | head -1`
    #--------------------------------------------------------------------
    # Old Part Only Priced
    COBOL_COUNT=$(grep 'OLD PART ONLY PRICED' ${COBOL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'Old Part Only Priced' ${PLSQL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK ** Total New Transactions Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Old Part Only Priced\n"  > ${MAIL_TEXT}
      echo " "                                        >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}             >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}             >> ${MAIL_TEXT}
      echo " "                                        >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Old Part Only Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Old Part Only Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'OLD PART SUPERSEDED' ${COBOL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'Old Part Superseded' ${PLSQL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Old Part Superseded Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Old Part Superseded\n"          > ${MAIL_TEXT}
      echo " "                             >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT}  >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT}  >> ${MAIL_TEXT}
      echo " "                             >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Old Part Superseded Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Old Part Superseded Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'NEW PART PRICED' ${COBOL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'New Part Priced' ${PLSQL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK New Part Priced Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "New Part Priced\n"             > ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT} >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT} >> ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** New Part Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** New Part Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'BOTH PARTS PRICED' ${COBOL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'Both Parts Priced' ${PLSQL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Both Parts Priced Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Both Parts Priced\n"           > ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT} >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT} >> ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Both Parts Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Both Parts Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'NEITHER PART IS PRICED' ${COBOL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'Neither Part is Priced' ${PLSQL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Neither Part is Priced Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Neither Part is Priced\n"      > ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT} >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT} >> ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Neither Part is Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Neither Part is Priced Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'OPPOSITE SUPERSESSIONS' ${COBOL_REPORT} | tr -d ',A-Za-z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'Opposite Supersessions' ${PLSQL_REPORT} | tr -d ',A-Za-z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Opposite Supersessions Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Opposite Supersessions\n"      > ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT} >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT} >> ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Opposite Supersessions Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Opposite Supersessions Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'DUPL REVERSE READ' ${COBOL_REPORT} | tr -d ',A-Za-z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'Dupl Reverse Read' ${PLSQL_REPORT} | tr -d ',A-Za-z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK Dupl Reverse Read Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "Dupl Reverse Read\n"           > ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT} >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT} >> ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** Dupl Reverse Read Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** Dupl Reverse Read Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #----------------------------------------------------------------------
    COBOL_COUNT=$(grep 'RTRANS WRITTEN' ${COBOL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    PLSQL_COUNT=$(grep 'RTrans Written' ${PLSQL_REPORT} | tr -d ',A-Z' | awk -F: '/:/ { print $2 }' )
    if [ "${COBOL_COUNT}" -eq "${PLSQL_COUNT}" ]
    then
      echo "OK RTrans Written Count: ${PLSQL_COUNT}"
    else
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "RTrans Written\n"              > ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      echo "COBOL_COUNT: " ${COBOL_COUNT} >> ${MAIL_TEXT} 
      echo "PLSQL_COUNT: " ${PLSQL_COUNT} >> ${MAIL_TEXT}
      echo " "                            >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: ** RTrans Written Count!" ${MAIL_TO} < ${MAIL_TEXT}
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: ** RTrans Written Count!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    fi
    #####################################################################################################################
    # COMPARE RTrans
    OLD_FILE=${RACE}/dat/${JOBNAME}_rtrans_2_adjust.old.tmp
    OLD_FILE_SORTED=${RACE}/dat/${JOBNAME}_rtrans.old.sort.tmp
    sort -o ${OLD_FILE_SORTED} ${OLD_FILE}
    NEW_FILE=${RACE}/dat/${JOBNAME}_rtrans_2_adjust.new.tmp
    NEW_FILE_SORTED=${RACE}/dat/${JOBNAME}_rtrans.new.sort.tmp
    sort -o ${NEW_FILE_SORTED} ${NEW_FILE}    
    #DIFF_FILE=${RACE}/dat/${JOBNAME}_rtrans.diff.tmp
    DIFF_FILE=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_diff.dat(+1)" NEW 1)
    # Turn trap off since "diff" will return a 1 if files are different
    # The trap is turned back on after the "if"
    trap - err
    diff -wb ${OLD_FILE_SORTED} ${NEW_FILE_SORTED} > ${DIFF_FILE}         
    if [ -s ${DIFF_FILE} ]
    then
      export MAIL_TEXT=${RACE}/tmp/${JOBNAME}_email_text.tmp
      echo "mptz016r Reverse Files Different\n"  > ${MAIL_TEXT}
      echo ${DIFF_FILE}                         >> ${MAIL_TEXT} 
      echo " "                                  >> ${MAIL_TEXT}
      if [ ${THISHOST} = ${TESTHOST} ]
      then
        MAIL_TO="Janet.Wilson@Mitchell.com"
        mailx -s "Test system warning! ${JOBNAME} ${STEPNAME}: mptz016r Reverse Files Different!" ${MAIL_TO} < ${MAIL_TEXT}
        trap 'oem_abndalrt.ksh $?' err
        exit 777        
      else
        MAIL_TO="rpt.oem.fixit@mitchell.com"
        mailx -s         "oem_upd.ksh  ${JOBNAME} ${STEPNAME}: mptz016r Reverse Files Different!" ${MAIL_TO} < ${MAIL_TEXT}
      fi 
    else 
      # Cleanup Files used to compare RTrans 
      rm -f ${OLD_FILE}
      rm -f ${OLD_FILE_SORTED}
      rm -f ${NEW_FILE}
      rm -f ${NEW_FILE_SORTED}
    fi
    trap 'oem_abndalrt.ksh $?' err
    #####################################################################################################################
  fi  
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
#%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


#STEP Step090R - COBOL
  export STEPNAME=Step090R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  if [ -z "${REVERSE_SUPER_JOBPARM}" ]
  then
    echo "                Skipping ${STEPNAME} mptz016 - Reverse Super Pre-Processor Program"
  else
    oem_job_status_update.ksh "R" "${STEPNAME} mptz016 - Reverse Super Pre-Processor Program"
    #*********************************************************************************************
    #  Step090R- Executes mptz016 - Reverse Super Pre-Processor Program
    #*********************************************************************************************
    export DD_PARMIN=${RACE}/prm/${REVERSE_SUPER_JOBPARM}.prm
    export DD_TRANSIN=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_1_generate_${JOBFILE_OEMCTRY}.dat(0)")
    export DD_TRANSOUT=${RACE}/dat/${JOBNAME}_rtrans_2_adjust.tmp
    export DD_PARTFILE=${RACE}/dat/${JOBNAME}_partlist_ksds.tmp
    export DD_CNTLRPT=${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}.pip
         printpipe -o ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}
         printpipe -r ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX} rpt

    mptz016 2>&1

         printpipe -c ${RACE}/rpt/${JOBNAME}r_spre${REPORTSUFFIX}
  fi
#
#  Steps 020 thru 090 are ONLY run for jobs 
#  which require "Reverse Analysis" processing
#
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


#STEP Step105R
  export STEPNAME=Step105R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  oem_job_status_update.ksh "R" "${STEPNAME} Check for rtrans file"
  #*********************************************************************************************
  #  Step105R - Check for rtrans file
  #             If not found, create it (there are some OEMs which do not send rtrans
  #             and do not run the Reverse Analysis steps which would created rtrans)
  #*********************************************************************************************
  REFORMAT_RTRANS_FILE=${RACE}/dat/${REFORMATJOB}_rtrans.tmp
  UPDATE_RTRANS_FILE=${RACE}/dat/${JOBNAME}_rtrans_2_adjust.tmp
  ##############################################################################################
  #
  #  Hey, something is wrong if an rtrans was created by
  #  BOTH the Reformat Program AND the Supersession Analysis progrm.
  ##############################################################################################
  if [ -e ${REFORMAT_RTRANS_FILE} ]
  then
    if [ -e ${UPDATE_RTRANS_FILE} ]
    then
      oem_abndalrt.ksh oem_upd_TWO_rtrans_files_found
    fi
  fi
  ##############################################################################################
  #
  #  Use the Reformat RTRANS if found -- copy it to the Update Job's JOBNAME
  #  Use the Update RTRANS if found, otherwise, create one.
  ###############################################################################################
  if [ -e ${REFORMAT_RTRANS_FILE} ]
  then
    echo "Using RTRANS created by Reformat Program(s): ${PACKAGE_NAME_1}  ${PACKAGE_NAME_2}"
    mv ${REFORMAT_RTRANS_FILE} ${UPDATE_RTRANS_FILE}
  else
    if [ -e ${UPDATE_RTRANS_FILE} ]
    then
      echo "Using RTRANS created by Supersession Analysis/Reverse Super Pre-Processor"
    else
      echo "Creating an empty RTRANS file"
      touch ${UPDATE_RTRANS_FILE}
    fi
  fi
  ##############################################################################################


#STEP Step110R
  export STEPNAME=Step110R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  oem_job_status_update.ksh "R" "${STEPNAME} Sorts R TRANS by: SUPR-EFF-DT Descend and OLD PART NUMBER Ascend"
  #*********************************************************************************************
  #                                          Sorts R TRANS by: SUPR-EFF-DT Descend and OLD PART NUMBER Ascend
  #   Save 3 generations reformat RTRANS
  #*********************************************************************************************
  SORT_FILEIN=${RACE}/dat/${JOBNAME}_rtrans_2_adjust.tmp
  SORT_FILEOUT=${RACE}/dat/${JOBNAME}_rtrans_2_adjust_sort.tmp
  #   +------------+------------+------------+----------+
  #   |            |    YYYY    |   MMDD     | OLD PART |
  #   +------------+------------+------------+----------+
  sort -k1.67,1.74r -k1.63,1.66r -k1.57,1.61r -k1.7,1.31 -o ${SORT_FILEOUT} ${SORT_FILEIN}
  mv               ${RACE}/dat/${JOBNAME}_rtrans_2_adjust_sort.tmp \
     $(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_2_adjust_${JOBFILE_OEMCTRY}.dat(+1)" NEW 3)


#STEP Step120R
  export STEPNAME=Step120R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  oem_job_status_update.ksh "R" "${STEPNAME} mptz013 - Reverse Supersession Update Program"
  #*********************************************************************************************
  #                                          mptz013 - Reverse Supersession Update Program
  #*********************************************************************************************
  export DD_PARMSIN=${RACE}/prm/${JOBPARM}.prm
  export DD_TRANSIN=$(setgdg.ksh "${RACE}/dat/${JOBNAME}_rtrans_2_adjust_${JOBFILE_OEMCTRY}.dat(0)")
  export DD_PARTSFL=${RACE}/tmp/${JOBNAME}_parts_file.tmp
  export DD_CNTLRPT=${RACE}/rpt/${JOBNAME}d_rupd${REPORTSUFFIX}.pip
       printpipe -o ${RACE}/rpt/${JOBNAME}d_rupd${REPORTSUFFIX}
       printpipe -r ${RACE}/rpt/${JOBNAME}d_rupd${REPORTSUFFIX} rpt

  mptz013 2>&1

       printpipe -c ${RACE}/rpt/${JOBNAME}d_rupd${REPORTSUFFIX}


#STEP Step125R
  export STEPNAME=Step125R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  oem_job_status_update.ksh "R" "${STEPNAME} Sorts N TRANS by: SUPR-EFF-DT (YYYY, MM/DD) Ascend"
  #*********************************************************************************************
  #                                          Sorts N TRANS by: SUPR-EFF-DT (YYYY, MM/DD) Ascend
  #*********************************************************************************************
  SORT_FILEIN=${RACE}/dat/${REFORMATJOB}_ntrans.tmp
  SORT_FILEOUT=${RACE}/dat/${JOBNAME}_ntrans_sort.tmp
  #   +-----------|-----------|
  #   |    YYYY   |   MMDD    |
  #   +-----------|-----------|
  sort -k1.63,1.66 -k1.57,1.61 -o ${SORT_FILEOUT} ${SORT_FILEIN}


#STEP Step130R
  export STEPNAME=Step130R
  echo "\n\nSTART ---> ${PROCNAME} ${STEPNAME}" $(date +'%m/%d/%y %H:%M:%S')  " <--- START\n\n"
  oem_job_status_update.ksh "R" "${STEPNAME} Executes mptz024 - Supersession Update Program"
  #*********************************************************************************************
  #                                          Executes mptz024 - Supersession Update Program
  #*********************************************************************************************
  export DD_PARMSIN=${RACE}/prm/${JOBPARM}.prm
  export DD_TRANSIN=${RACE}/dat/${JOBNAME}_ntrans_sort.tmp
  export DD_CNTLRPT=${RACE}/rpt/${JOBNAME}f_supd${REPORTSUFFIX}.pip
       printpipe -o ${RACE}/rpt/${JOBNAME}f_supd${REPORTSUFFIX}
       printpipe -r ${RACE}/rpt/${JOBNAME}f_supd${REPORTSUFFIX} rpt

  mptz024 2>&1

       printpipe -c ${RACE}/rpt/${JOBNAME}f_supd${REPORTSUFFIX}


#STEP Step140R
