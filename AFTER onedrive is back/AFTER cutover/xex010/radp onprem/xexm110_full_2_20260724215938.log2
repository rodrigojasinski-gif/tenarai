: xex017.ksh,v 1.5 2009/07/07 17:26:54 pg2697 Exp $
export PROCNAME=$(basename $0 .ksh_run)
+ basename /prod/race/ext/bin/xex017.ksh .ksh_run
+ export PROCNAME=xex017.ksh
trap 'abndalrt.ksh $?' err
+ trap abndalrt.ksh $? err
         
sqlplus <<% 
$EXTUSERID
SET ECHO ON;
SET FEEDBACK ON;
SET VERIFY ON;
SET LINESIZE 80;
SET SERVEROUTPUT ON; 
whenever sqlerror exit sql.sqlcode

BEGIN
 
PKG_ULTRAMATE_PARSE.ULTRAMATE_PARSE('$SQL_RUN_TYPE'
                                   ,'$OBJ_DATDIR_UMFULL'
                                   ,'$OBJ_DATDIR_UMMINI'
                                   ,'$SQL_FTP_MACHINE'
                                   ,'$SQL_FTP_DEST_PATH'
                                   ,'$SQL_FULL_PROC_NUM');
END;
/
QUIT;
%
+ sqlplus
+ 0<<
ext/f00tba11
SET ECHO ON;
SET FEEDBACK ON;
SET VERIFY ON;
SET LINESIZE 80;
SET SERVEROUTPUT ON; 
whenever sqlerror exit sql.sqlcode

BEGIN
 
PKG_ULTRAMATE_PARSE.ULTRAMATE_PARSE('FULL'
                                   ,'RACE_EXT_DAT_UMFULL_DIR'
                                   ,'RACE_EXT_DAT_UMMINI_DIR'
                                   ,'OPT006'
                                   ,'d:/Data/Txtfiles'
                                   ,'2');
END;
/
QUIT;

