# Copy the "ALL" report to the Network      
# rj132422 - prod3nt sunset: deliver report to Mitchell usrdat via scp; ascii mode -> convert LF to CRLF for Windows/Notepad consumers (was: fileput.exp ${NT_FILE} to ${NOVELL}usrdat ascii)
USRDAT_DIR=${FTP_MITCHELL_BUSINESS_PATH}/${ACT_LVL}/usrdat
SOURCE_FILE_CRLF=${RACE}/tmp/${NT_FILE}.crlf
sed 's/$/\r/' ${SOURCE_FILE} > ${SOURCE_FILE_CRLF}
scp ${SOURCE_FILE_CRLF} ${FTP_SFTP_USER}${FTP_SITE}:${USRDAT_DIR}/${NT_FILE} | tee ${FTP_LOGFILE}

# With ASCII transfer, you cannot compare unix byte count to FTPBYTECOUNT to determine successful transfer   
GOODBYTECOUNT="$(wc -c ${SOURCE_FILE_CRLF} | awk '{print $1}')"
FTPBYTECOUNT="$(ssh -nq ${FTP_SFTP_USER}${FTP_SITE} "wc -c < ${USRDAT_DIR}/${NT_FILE}")"  # rj132422 remote byte-count via ssh
if [ "${GOODBYTECOUNT}" -eq "${FTPBYTECOUNT}" ]
then
  echo "Successful transfer ${SOURCE_FILE} to ${USRDAT_DIR}/${NT_FILE}: count = ${GOODBYTECOUNT}"
else
  echo "transfer of ${SOURCE_FILE} to ${USRDAT_DIR} failed: remote ${FTPBYTECOUNT}, local ${GOODBYTECOUNT}"
  abndalrt.ksh ftp_put
fi
rm -f ${SOURCE_FILE_CRLF}

fi

