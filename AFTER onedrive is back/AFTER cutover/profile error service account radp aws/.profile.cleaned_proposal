#############################################################################################
# race_b1 .profile  (RADP AWS / RHEL)
# Based on the on-prem race_b1 baseline: all interactive/terminal settings are guarded by
# `if [ -t 0 ]` so ActiveBatch (non-terminal) skips them. Only batch-safe, required env
# runs unconditionally.
#############################################################################################

# Required by COS/Batch RACE suites
export ACT_LVL=prod
export act_lvl=prod

umask 002

# ---------------------------------------------------------------------------
# Oracle environment (RHEL / AWS)
# ---------------------------------------------------------------------------
export ORACLE_BASE=/u01/app/oracle
export ORACLE_HOME=/u01/app/oracle/product/19.3.0/client64
export ORA_INVENTORY=/u01/app/oraInventory
export TNS_ADMIN=$ORACLE_HOME/network/admin
export TWO_TASK=RADP.MITCHELL.COM
export ORACLE_SID=RADP.MITCHELL.COM
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:$LD_LIBRARY_PATH

# ---------------------------------------------------------------------------
# PATH  (no '.' and no /usr/local/bin/perl)
# ---------------------------------------------------------------------------
export PATH=$HOME/bin:$ORACLE_HOME/bin:/usr/lib/oracle/23/client64/bin:/opt/microfocus/cobol/bin:/usr/local/bin:/bin:/usr/bin:/sbin:/usr/sbin:/prod/util/share/bin

# ---------------------------------------------------------------------------
# RACE environment
# raceprofile.ksh sources raceftp.ksh -> sets RACE, FTP_SFTP_USER, FTP_SITE,
# FTP_MITCHELL_BUSINESS_PATH and adds the RACE bin directories to PATH.
# ---------------------------------------------------------------------------
. /$ACT_LVL/race/share/bin/raceprofile.ksh

# ---------------------------------------------------------------------------
# Interactive-only settings.
# ActiveBatch runs with no controlling terminal, so this whole block is skipped.
# ---------------------------------------------------------------------------
if [ -t 0 ]
then
   set -o emacs
   PS1=$(hostname -s)':$PWD> '
   alias lt='ls -lt'
   alias lh='ls -lt | head -30'
   alias dr='ls -l | grep drw'
   alias cls='clear'
   # arrow keys in emacs mode
   alias __A=`echo "\020"`   # up    = ^p
   alias __B=`echo "\016"`   # down  = ^n
   alias __C=`echo "\006"`   # right = ^f
   alias __D=`echo "\002"`   # left  = ^b
   alias __H=`echo "\001"`   # home  = ^a
   echo "You are logged in!"
fi

#############################################################################################
# Removed (batch-hostile / interactive that ran unconditionally in the previous version):
#   alias cp='cp -i'          # would prompt and hang batches
#   alias mv='mv -i'          # would prompt and hang batches
#   set -o noclobber          # would break `cmd > existing_file` in batches
#   alias exit='...logout...' # redefined exit
#   echo "You are logged in!" # moved inside the interactive block (was polluting batch stdout)
#   LIBPATH / /opt/freeware   # AIX-only, ignored on RHEL
#   '.' and /usr/local/bin/perl in PATH
#
# CONFIRM before deploy (kept out; add back only if a batch needs them):
#   ulimit -d 2000000         # data-segment cap; may starve large COBOL/Oracle jobs
#   /opt/ruby241 in PATH      # only if any batch uses ruby
#   HOSTNAME / SRVR / SERVER_NAME exports  # only if a script reads them (RACE uses `hostname -s`)
#############################################################################################
