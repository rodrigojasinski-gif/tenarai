+ 1> /prod/race/oem/tmp/mptr300_step290_not_actrans_tes_us.tmp
+ REFTRANS_ACTRANS=/prod/race/oem/tmp/mptr300_step290_ref_actrans_tes_us.tmp
+ awk '{ if (substr($0,1,1)=="A" || substr($0,1,1)=="C") print $0 }' /prod/race/oem/dat/mptr300_ref_tes_us.dat.g87
+ 1> /prod/race/oem/tmp/mptr300_step290_ref_actrans_tes_us.tmp
+ SORTIN_BOTH1='/prod/race/oem/tmp/mptr300_step290_ref_actrans_tes_us.tmp /prod/race/oem/tmp/mptr300_step280_actrans_tes_us.tmp'
+ ACTRANS_REDUCED=/prod/race/oem/tmp/mptr300_step290_actrans_reduced_tes_us.tmp
+ sort -T /prod/race/oem/tmp -u -k1.1,1.1 -k1.7,1.31 -k1.32,1.56 -o /prod/race/oem/tmp/mptr300_step290_actrans_reduced_tes_us.tmp /prod/race/oem/tmp/mptr300_step290_ref_actrans_tes_us.tmp /prod/race/oem/tmp/mptr300_step280_actrans_tes_us.tmp
+ SORTIN_BOTH2='/prod/race/oem/tmp/mptr300_step290_actrans_reduced_tes_us.tmp /prod/race/oem/tmp/mptr300_step290_not_actrans_tes_us.tmp'
+ REFORMAT_SORTOUT=/prod/race/oem/tmp/mptr300_step290_ref_tes_us_sorted.tmp
