${MPTUSERID}
SET VERIFY OFF
SET FEEDBACK OFF
SET TAB OFF
SET LINESIZE 100
SET PAGES 0
SET TRIMSPOOL ON
SET SERVEROUTPUT ON SIZE 1000000
whenever sqlerror exit sql.sqlcode
