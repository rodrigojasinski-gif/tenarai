           MOVE "R8300-DELETE-RESTART.    " TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH               TO WS-PARNAME
           MOVE "ACQ_BATCH_RESTART        " TO WS-TBLNAME.
           MOVE "DELETE    "                TO WS-FUNCTION.
                                                                        
           EXEC SQL EXECUTE
             BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_DEL_01
                              (:WS-PROGRAM-NAME,
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-CURRENT-EFFECTIVE-DATE,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
