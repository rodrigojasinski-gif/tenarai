      *     3. MOVE THIS INFORMATION TO HEADINGS                    *   
      *     4. CHECK IF RESTART RUN                                 *   
      ***************************************************************   
       A0000-PROCESS-PARMS.                                             
           MOVE "A0000-PROCESS-PARMS.     " TO WS-PARAGRAPH.       
                                                                        
           READ CONTROL-PARMS INTO WS-CNTL-PARM-REC                     
             AT END                                                     
                DISPLAY WS-ERR-MSG-CP1                                  
                MOVE V-MISSING-CNTL-PARM TO WS-ABEND-CODE               
                PERFORM Y2000-ABEND THRU Y2000-EXIT.                    
                                                                        
           IF CNTL-OEM-NUM NOT NUMERIC                                  
             DISPLAY WS-ERR-MSG-CP2                                     
             MOVE V-INVALID-CNTL-PARM TO WS-ABEND-CODE                  
             PERFORM Y2000-ABEND THRU Y2000-EXIT.                       
                                                                        
           MOVE CNTL-REGN-CD   TO WS-SEL-REGN-CD.
           MOVE CNTL-EFF-MONTH TO WS-TEMP-EFF-MONTH.                    
           MOVE CNTL-EFF-DAY   TO WS-TEMP-EFF-DAY.                        
           MOVE CNTL-EFF-YEAR  TO WS-TEMP-EFF-YEAR.                      

           IF WS-TEMP-EFF-DT NOT NUMERIC OR WS-TEMP-EFF-DT <= ZEROES    
             DISPLAY WS-ERR-MSG-CP3                                     
             MOVE V-INVALID-DATE TO WS-ABEND-CODE                       
             PERFORM Y2000-ABEND THRU Y2000-EXIT.                       
                                                                        
           MOVE CNTL-OEM-NUM   TO WS-SEL-OEM-NUM.                         
           MOVE WS-SEL-REGN-CD TO WS-REGN-LIT-NM.
           MOVE WS-REGN-LIT    TO WS-REGN-LIT-X.
                                                                        
           PERFORM R1000-READ-OEM THRU R1000-EXIT.                      
           IF NOT-VALID-OEM                                             
             DISPLAY WS-ERR-MSG-CP2                                     
             MOVE V-INVALID-CNTL-PARM TO WS-ABEND-CODE                  
             PERFORM Y2000-ABEND THRU Y2000-EXIT.                       

           ACCEPT WS-CURRENT-DT FROM DATE.                              
           MOVE WS-CD-MONTH  TO WS-FD-MONTH.                            
           MOVE WS-CD-DAY    TO WS-FD-DAY.                              
           MOVE WS-CD-YEAR   TO WS-FD-YEAR.                             
           MOVE WS-FORMAT-DT TO HDG-DT.                                 
                                                                        
           ACCEPT WS-CURRENT-TM FROM TIME.                              
           MOVE WS-CT-HOUR   TO WS-FT-HOUR.                             
           MOVE WS-CT-MINUTE TO WS-FT-MINUTE.                           
           MOVE WS-CT-SECOND TO WS-FT-SECOND.                           
           MOVE WS-FORMAT-TM TO HDG-TM.                                 
                                                                        
           MOVE WS-RPT-TITLE          TO HDG-TITLE.                    
           MOVE CNTL-EFF-DT           TO HDG-EFF-DT, WS-TEMP-DT.       
           MOVE CNTL-EFF-DT           TO WS-CURRENT-EFFECTIVE-DATE.
           MOVE CNTL-OEM-NUM          TO HDG-OEM-NUM.
           MOVE WS-PART-SUPPLIER-NAME-RGN TO HDG-OEM-NM.
           MOVE WS-PGMNAME            TO HDG-PGMNAME,EOR-PGMNAME.

           IF CNTL-NAGS-TYP = "N/A     "                                
             NEXT SENTENCE                                              
           ELSE                                                         
             MOVE CNTL-NAGS-TYP TO HDG-NAGS-TYP.                        
                                                                        
           PERFORM A1000-CHECK-RESTART THRU A1000-EXIT.                 
                                                                        
       A0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * A1000-CHECK-RESTART:                                        *   
      *     1. CHECK IF RESTART ROW FOUND, INDICATING RESTART RUN.  *   
      *     2. IF SO, VALIDATE AGAINST PARM EFFECTIVE DATE          *   
      *               READ TRANSACTION FILE TO RESTART POINT        *   
      ***************************************************************   
       A1000-CHECK-RESTART.                                
           MOVE "A1000-CHECK-RESTART.     " TO WS-PARAGRAPH.
                                                          
           PERFORM R8000-READ-RESTART THRU R8000-EXIT.

           IF RESTART-READ-WRITTEN              
             IF CNTL-EFF-DT NOT EQUAL RS-EFF-DT 
               DISPLAY WS-ERR-MSG-CP5           
               DISPLAY "CNTL-EFF-DT = " CNTL-EFF-DT
               DISPLAY "RS-EFF-DT   = " RS-EFF-DT
               MOVE V-PARM-DOESNT-MATCH-RESTART TO WS-ABEND-CODE
               PERFORM Y2000-ABEND THRU Y2000-EXIT
             ELSE                              
               PERFORM A2000-RESTART-TRANS THRU A2000-EXIT
                 UNTIL TRANS-EQUAL-RESTART OR END-OF-TRANSFILE
           ELSE                                             
             PERFORM E1000-INIT-RESTART-WSTG THRU E1000-EXIT.
                                                            
       A1000-EXIT. EXIT.                                   
                                                        
      ***************************************************************   
      * A2000-RESTART-TRANS:                                        *   
      *     1. READ TRANS FILE TO POINT OF RESTART FILE             *   
      ***************************************************************   
       A2000-RESTART-TRANS.                                             
           MOVE "A2000-RESTART-TRANS.     " TO WS-PARAGRAPH.       
                                                                        
           READ TRANS-FILE INTO WS-TRANS-REC                            
             AT END                                                     
               DISPLAY WS-ERR-MSG-TR5                                   
               MOVE V-EMPTY-INPUT-FILE TO WS-ABEND-CODE                 
               PERFORM Y2000-ABEND THRU Y2000-EXIT.                     
                                                                        
           IF TR-TRANS-CODE NOT EQUAL "A"                               
             DISPLAY WS-ERR-MSG-TR1                                     
             MOVE V-INVALID-INPUT-FILE TO WS-ABEND-CODE                 
             PERFORM Y2000-ABEND THRU Y2000-EXIT.                       
                                                                        
           IF TR-OLD-PART-NUM EQUAL RS-TR-OLD-PART-NUM AND              
              TR-NEW-PART-NUM EQUAL RS-TR-NEW-PART-NUM                  
             MOVE "R" TO WS-PROCESS-SW.                                 
                                                                        
       A2000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * B0000-READ-TRANS:                                           *   
      *     1. READ TRANSACTION FILE                                *   
      *     2. VERIFY CORRECT TRANSACTION FILE FOR THIS RUN.        *   
      *     3. FOR FIRST TRANSACTION REC ONLY, CHECK CONTROL EFF.   *   
      *        DATE AGAINST OEM TABLE                               *   
      *     4. LOAD TRANSACTIONS 'GROUP' TO PROCESSING TABLE.       *   
      *     5. ONCE ALL LOADED, PROCESS ASSEMBLY-TO-COMPONENT GROUP.*   
      *        NOTE - IF OLD PART WASN'T FOUND IN PART TABLE THEN   *   
      *               THERE WON'T BE ANY TRANS IN TABLE TO PROCESS  *   
      *               SO THE ROUTINE IS BYPASSED.                   *   
      ***************************************************************   
       B0000-READ-TRANS.                                                
           MOVE "B0000-READ-TRANS.        " TO WS-PARAGRAPH.       
                                                                        
           READ TRANS-FILE INTO WS-TRANS-REC                            
             AT END                                                     
                MOVE "T" TO WS-PROCESS-SW.                              
                                                                        
           IF END-OF-TRANSFILE                                          
             IF RS-TRANS-READ-CTR > 0                                   
               PERFORM D0000-ASSEMBLY-PROCESS THRU D0000-EXIT           
               GO TO B0000-EXIT                                         
             ELSE                                                       
               GO TO B0000-EXIT                                         
           ELSE                                                         
             ADD 1 TO RS-TRANS-READ-CTR.                                
                                                                        
           IF TR-TRANS-CODE NOT EQUAL "A"                               
             DISPLAY WS-ERR-MSG-TR1                                     
             MOVE V-INVALID-INPUT-FILE TO WS-ABEND-CODE                 
             PERFORM Y2000-ABEND THRU Y2000-EXIT.                       
                                                                        
           IF RS-TRANS-READ-CTR EQUAL 1                                 
             IF WS-LAST-ASSY-IND EQUAL ZEROES                         
               MOVE WS-LAST-ASSY-DATE TO WS-LST-UPD-DT                   
               MOVE WS-LST-UPD-MONTH  TO WS-TEMP-UPD-MONTH               
               MOVE WS-LST-UPD-DAY    TO WS-TEMP-UPD-DAY                 
               MOVE WS-LST-UPD-YEAR   TO WS-TEMP-UPD-YEAR                
               IF REPLACEMENT-RUN                                       
                 IF WS-TEMP-EFF-DT > WS-TEMP-UPD-DT                     
                   DISPLAY WS-ERR-MSG-CP10A                             
                   DISPLAY WS-ERR-MSG-CP10                              
                   DISPLAY "WS-TEMP-EFF-DT    " WS-TEMP-EFF-DT
                   DISPLAY "WS-TEMP-UPD-DT    " WS-TEMP-UPD-DT
                   MOVE V-INVALID-DATE TO WS-ABEND-CODE                 
                   PERFORM Y2000-ABEND THRU Y2000-EXIT                  
                 ELSE                                                   
                   CONTINUE                                             
               ELSE                                                     
      * REGULAR RUN                                                     
                 IF WS-TEMP-EFF-DT <= WS-TEMP-UPD-DT                    
                   DISPLAY WS-ERR-MSG-CP4A                              
                   DISPLAY WS-ERR-MSG-CP4                               
                   MOVE V-INVALID-DATE TO WS-ABEND-CODE                 
                   PERFORM Y2000-ABEND THRU Y2000-EXIT.                 
                                                                        
           IF FIRST-TIME                                                
             MOVE "N" TO WS-TRANS-SW                                    
             PERFORM E0000-INIT-TRANS-INDX     THRU E0000-EXIT              
             PERFORM C0000-MOVE-TRANS-TO-TABLE THRU C0000-EXIT          
             GO TO B0000-EXIT.                                          
                                                                        
           IF TR-OLD-PART-NUM NOT EQUAL WS-HOLD-PART-NUM                
             IF WS-TRANS-TOTAL > 0                                      
               MOVE WS-HOLD-PART-NUM TO WS-SEL-PART-NUM                 
               PERFORM D0000-ASSEMBLY-PROCESS THRU D0000-EXIT           
               PERFORM E0000-INIT-TRANS-INDX  THRU E0000-EXIT.           
                                                                        
           PERFORM C0000-MOVE-TRANS-TO-TABLE THRU C0000-EXIT.           
                                                                        
       B0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * C0000-MOVE-TRANS-TO-TABLE:                                  *   
      *     1. VERIFY OLD PART NUMBER IN PART'S TABLE               *   
      *        IF NOT, BYPASS STORING RECORD IN TABLE               *   
      *        IF SO, STORE PART INFO IN TABLE                      *   
      *     2. MOVE TRANSACTION RECORD INTO PROCESSING TABLE.       *   
      ***************************************************************   
       C0000-MOVE-TRANS-TO-TABLE.                                       
           MOVE "C0000-MOVE-TRANS-TO-TABLE" TO WS-PARAGRAPH.       
                                                                        
           MOVE TR-OLD-PART-NUM TO WS-HOLD-PART-NUM.                    
                                                                        
           ADD 1 TO WS-TRANS-INDEX, WS-TRANS-TOTAL.                     
           IF WS-TRANS-INDEX > WS-TRANS-INDEX-LIMIT                     
             DISPLAY WS-ERR-MSG-PG2                                     
             MOVE V-INTERNAL-TBL-LIMIT-EXCEEDED TO WS-ABEND-CODE        
             PERFORM Y2000-ABEND THRU Y2000-EXIT.                       
                                                                        
           MOVE TR-OLD-PART-NUM TO WS-SEL-PART-NUM.                     
           PERFORM R2000-READ-PART THRU R2000-EXIT.                     
           IF PART-NOT-FOUND                                            
             ADD 1 TO RS-NOT-PROC-CTR                                   
             ADD 1 TO RS-PART-NOT-DB-CTR                                
             SUBTRACT 1 FROM WS-TRANS-INDEX, WS-TRANS-TOTAL             
             GO TO C0000-EXIT.                                          
                                                                        
           MOVE TR-OLD-PART-NUM TO WS-TBL-OLD-PART-NUM(WS-TRANS-INDEX). 
           MOVE WS-PART-DESC    TO WS-TBL-OLD-PART-DESC(WS-TRANS-INDEX).   
                                                                        
           MOVE TR-NEW-PART-NUM TO WS-TBL-NEW-PART-NUM(WS-TRANS-INDEX). 
      * REMOVED NOTES (E.G. "(01)") CODED AT END OF NEW PART # FIELD    
      * SO THAT DESC. CAN BE SELECTED FROM PARTS TABLE.                 
           MOVE TR-NEW-PART-NUM TO WS-TEMP-PART-NUM.                    
           IF WS-TEMP-PART-16 EQUAL SPACES                              
             MOVE SPACES TO WS-TEMP-PART-17-20
             MOVE SPACES TO WS-TEMP-PART-21-25.

           MOVE WS-TEMP-PART-NUM TO WS-SEL-PART-NUM.                    
           PERFORM R2000-READ-PART THRU R2000-EXIT.                     
           IF PART-NOT-FOUND                                            
             MOVE SPACES       TO WS-TBL-NEW-PART-DESC(WS-TRANS-INDEX)
           ELSE                                                         
             MOVE WS-PART-DESC TO WS-TBL-NEW-PART-DESC(WS-TRANS-INDEX).
                                                                        
       C0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * D0000-ASSEMBLY-PROCESS:                                     *   
      *     1. FETCH AND STORE ALL LINES THAT ARE ASSOC. TO OLD PART*   
      *     2. IF NO ASSOC. LINES FOUND, BYPASS REPORTING TRANS'    *   
      *     3. DETERMINE IF TIME TO COMMIT AND IS SO, PERFORM RTN.  *   
      ***************************************************************   
       D0000-ASSEMBLY-PROCESS.                                          
           MOVE "D0000-ASSEMBLY-PROCESS.  " TO WS-PARAGRAPH.       
                                                                        
           ADD 1 TO RS-NEW-PRT-DB-CTR.                                  
                                                                        
           PERFORM R4000-READ-CEGLINE THRU R4000-EXIT.                  
    
           PERFORM R5000-READ-WIPLINE THRU R5000-EXIT.
             
            IF WS-CEGLN-TOTAL EQUAL ZERO AND WS-WIPLN-TOTAL EQUAL ZERO   
               ADD WS-TRANS-TOTAL TO RS-NOT-PROC-CTR                      
               GO TO D0000-EXIT.                                          

            ADD WS-TRANS-TOTAL TO RS-PROC-CTR. 
            
            IF WS-CEGLN-COUNT > ZERO                                     
               ADD WS-CEGLN-COUNT TO RS-NEW-CEG-LCTR                      
               ADD 1 TO RS-NEW-CEG-PCTR                                   
               PERFORM G0000-CEG-REPORT THRU G0000-EXIT. 
            
            IF WS-WIPLN-COUNT > ZERO                                     
               ADD WS-WIPLN-COUNT TO RS-NEW-WIP-LCTR                      
               ADD 1 TO RS-NEW-WIP-PCTR                                   
               PERFORM G1000-WIP-REPORT THRU G1000-EXIT. 

           IF WS-DB-ROW-CTR > COMMIT-LIMIT                              
             PERFORM F0000-COMMIT THRU F0000-EXIT.                      
                                                                        
       D0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * E0000-INIT-TRANS-INDX:                                      *   
      *     1. RESET INDEXES AND SWITCH.                            *   
      *     2. RESET LINE COUNTS TO ZERO.                           *   
      ***************************************************************   
       E0000-INIT-TRANS-INDX.                                           
           MOVE "E0000-INIT-TRANS-INDX.   " TO WS-PARAGRAPH.       
                                                                        
           MOVE 0 TO WS-TRANS-INDEX.                                    
           MOVE 0 TO WS-TRANS-TOTAL.                                    
           MOVE 0 TO WS-CEGLN-INDEX.                                    
           MOVE 0 TO WS-CEGLN-TOTAL. 
           MOVE 0 TO WS-CEGLN-COUNT.                    
           MOVE 0 TO WS-WIPLN-INDEX.                                    
           MOVE 0 TO WS-WIPLN-TOTAL.                                    
           MOVE 0 TO WS-WIPLN-COUNT.
           
           MOVE "N" TO WS-TRANS-ERR-SW.                                 
                                                                        
       E0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * E1000-INIT-RESTART-WSTG                                     *   
      *     1. INITIALIZE WORKING STORAGE RESTART AREAS             *   
      ***************************************************************   
       E1000-INIT-RESTART-WSTG.                                         
           MOVE "E1000-INIT-RESTART-WSTG. " TO WS-PARAGRAPH.       
                                                                        
           INITIALIZE RESTART-RECORD                                    
                      REPLACING ALPHANUMERIC DATA BY SPACES             
                                NUMERIC DATA BY ZEROES.                 
       E1000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * F0000-COMMIT:                                               *   
      *     1. "UPDATE" RESTART TABLE                               *   
      *        THE FIRST TIME THAT A COMMIT IS PERFORMED, THE       *   
      *        RESTART ROWS ARE INSERTED. SUBSEQUENT COMMITS INVOKE *   
      *        AN UPDATE TO THE RESTART TABLE. AT THE END OF THE    *   
      *        RUN, THE RESTART ROWS ARE DELETED.                   *   
      *     2. COMMIT ORACLE TABLE ACTIVITY                            *
      ***************************************************************   
       F0000-COMMIT.                                                    
           MOVE "F0000-COMMIT.            " TO WS-PARAGRAPH.       
                                                                        
           IF RESTART-READ-WRITTEN                                    
               PERFORM F1000-BUILD-RESTART-REC THRU F1000-EXIT          
               PERFORM R8200-UPDATE-RESTART    THRU R8200-EXIT             
           ELSE                                                       
               PERFORM F1000-BUILD-RESTART-REC THRU F1000-EXIT          
               PERFORM R8100-INSERT-RESTART    THRU R8100-EXIT.            
                                                                        
            EXEC SQL                                                     
             COMMIT                                                   
            END-EXEC.
                                                                        
           MOVE 0 TO WS-DB-ROW-CTR.                                     
                                                                        
       F0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * F1000-BUILD-RESTART-REC:                                    *   
      *     1. MOVE INFORMATION TO RESTART RECORD                   *   
      ***************************************************************   
       F1000-BUILD-RESTART-REC.                                         
           MOVE "F1000-BUILD-RESTART-REC. " TO WS-PARAGRAPH.       
                                                                        
           MOVE CNTL-EFF-DT      TO RS-EFF-DT.                      
           MOVE TR-OLD-PART-NUM  TO RS-TR-OLD-PART-NUM.
           MOVE TR-NEW-PART-NUM  TO RS-TR-NEW-PART-NUM.
           MOVE WS-SEL-PART-NUM  TO RS-DB-PART-NUM.
           MOVE RESTART-RECORD   TO WS-RESTART-DATA.
       F1000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * G0000-CEG-REPORT:                                           *   
      *     THIS ROUTINE PERFORMS THE REPORT LINE BUILD FOR CEG DATA*   
      *     1. WRITE TRANS INFO. TO RPT TBL                         *   
      *     2. IF THERE ARE MORE LINES THAN TRANSACTIONS WITHIN THE *   
      *        TABLES, WRITE THE REMAINING LINES TO THE REPORT TABLE*   
      ***************************************************************   
       G0000-CEG-REPORT.                                                
           MOVE "G0000-CEG-REPORT.        " TO WS-PARAGRAPH.       
                                                                        
           PERFORM G0100-CEG-TRANS-INFO THRU G0100-EXIT                 
             VARYING WS-TRANS-INDEX FROM 1 BY 1                         
             UNTIL WS-TRANS-INDEX > WS-TRANS-TOTAL.                     
                                                                        
      * NOTE - WS-TRANS-INDEX WILL BE 1 GREATER THAN WS-TRANS-TOTAL AT  
      *        THIS POINT (WHICH IS WHY IT IS USED TO BEGIN WRITING THE 
      *        REMAINING LINES).                                        
                                                                        
           IF WS-CEGLN-TOTAL > WS-TRANS-TOTAL                           
             PERFORM G0200-CEG-LINE-INFO THRU G0200-EXIT                
               VARYING WS-CEGLN-INDEX FROM WS-TRANS-INDEX BY 1          
               UNTIL WS-CEGLN-INDEX > WS-CEGLN-TOTAL.                   
                                                                        
       G0000-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * G0100-CEG-TRANS-INFO:                                       *   
      *     THIS ROUTINE BUILDS THE CEG MULTIPLE SUPERSESSION RPT   *   
      *     W/I THE ORACLE REPORT TABLE.                            *
      *     NOTE - THE CEG REPORT IS DRIVEN BY TRANS (PART INFO.)   *   
      *     1. MOVE CONTROL INFORMATION TO ORACLE REPORT TABLE COL'S*
      *     2. INITIALIZE AND MOVE TRANS INFORMATION TO SORT        *   
      *        CRITERIA FIELDS.                                     *   
      *     3. INITIALIZE AND MOVE TRANS INFORMATION TO REPORT      *   
      *        AREA FIELDS.                                         *   
      *     4. PERFORM ROUTINE TO MOVE LINE INFORMATION TO REPORT   *   
      *        AREA FIELDS.                                         *   
      *        NOTE - IF THERE ARE LESS (OR NO) LINES THAN TRANS    *   
      *        INFO, THE LINE INFO WILL BE SPACES IN REPORT TABLE.  *   
      ***************************************************************   
       G0100-CEG-TRANS-INFO.                                            
           MOVE "G0100-CEG-TRANS-INFO.    " TO WS-PARAGRAPH.       
                                                                        
           MOVE "MPTZ007-02" TO REPORT-NUMBER.
           MOVE SPACES       TO REPORT-SORT-CRITERIA.
           MOVE "A"          TO SRT2-SUPE-IND.
           MOVE "CEG "       TO SRT2-LN-OF-BUS.
           MOVE SPACES       TO SRT2-GRP-NUM.
           MOVE WS-TBL-OLD-PART-NUM(WS-TRANS-INDEX) TO SRT2-PART-NUM-1.
           MOVE WS-TBL-NEW-PART-NUM(WS-TRANS-INDEX) TO SRT2-PART-NUM-2.
                                                                        
           MOVE SPACES TO DETAIL-02.                           
           MOVE "A"                     TO RPT02-SUPE-IND.
           MOVE WS-TBL-OLD-PART-NUM(WS-TRANS-INDEX)          
                                        TO RPT02-OLD-PART-NUM.
           MOVE WS-TBL-NEW-PART-NUM(WS-TRANS-INDEX)              
                                        TO RPT02-NEW-PART-NUM.
           MOVE WS-TBL-OLD-PART-DESC(1) TO RPT02-OLD-PART-DESC.
           MOVE WS-TBL-NEW-PART-DESC(WS-TRANS-INDEX)              
                                        TO RPT02-NEW-PART-DESC.
           IF WS-CEGLN-TOTAL < WS-TRANS-INDEX                           
             MOVE WS-CEGLN-TOTAL   TO SRT2-LINE-INDEXA                  
             MOVE SPACES           TO RPT02-LINE-INFO                   
             MOVE DETAIL-02        TO REPORT-DATA
             PERFORM R9100-INSERT-REPORT THRU R9100-EXIT
             ADD 1 TO RS-TRN-RPT-INSRT-CTR             
           ELSE                                       
             MOVE WS-TRANS-INDEX   TO WS-CEGLN-INDEX   
             PERFORM G0200-CEG-LINE-INFO THRU G0200-EXIT.
                                                                        
       G0100-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * G0200-CEG-LINE-INFO:                                        *   
      *     1. MOVE CEG LINE INFO TO ORACLE REPORT TABLE            *
      *     2. PERFORM ORACLE INSERT ROUTINE                        *
      ***************************************************************   
       G0200-CEG-LINE-INFO.                                             
           MOVE "G0200-CEG-LINE-INFO.     " TO WS-PARAGRAPH.       
                                                                        
           MOVE WS-CEGLN-INDEX                    TO SRT2-LINE-INDEXA.
           MOVE SPACES                            TO RPT02-LINE-INFO.
           MOVE WS-TBL-CEGLN-INFO(WS-CEGLN-INDEX) TO RPT02-LINE-INFO.
           MOVE DETAIL-02                         TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.
           ADD 1 TO RS-TRN-RPT-INSRT-CTR.
                                        
       G0200-EXIT. EXIT.               

       G1000-WIP-REPORT.
           MOVE "G1000-WIP-REPORT" TO WS-PARAGRAPH.

           PERFORM G1100-WIP-TRANS-INFO THRU G1100-EXIT
             VARYING WS-TRANS-INDEX FROM 1 BY 1       
             UNTIL WS-TRANS-INDEX > WS-TRANS-TOTAL.  
                                                    
      * NOTE - WS-TRANS-INDEX WILL BE 1 GREATER THAN WS-TRANS-TOTAL AT
      *        THIS POINT (WHICH IS WHY IT IS USED TO BEGIN WRITING THE
      *        REMAINING LINES).
                                                                        
           IF WS-WIPLN-TOTAL > WS-TRANS-TOTAL
             PERFORM G1200-WIP-LINE-INFO THRU G1200-EXIT
               VARYING WS-WIPLN-INDEX FROM WS-TRANS-INDEX BY 1
               UNTIL WS-WIPLN-INDEX > WS-WIPLN-TOTAL.        
                                                            
       G1000-EXIT. EXIT.                                   

       G1100-WIP-TRANS-INFO.                             
           MOVE "G1100-WIP-TRANS-INFO." TO WS-PARAGRAPH.
                                                       
           MOVE "MPTZ007-02" TO REPORT-NUMBER.        
           MOVE SPACES       TO REPORT-SORT-CRITERIA.
           MOVE "A"          TO SRT2-SUPE-IND.      
           MOVE "WIP "       TO SRT2-LN-OF-BUS.    
           MOVE SPACES       TO SRT2-GRP-NUM.     
           MOVE WS-TBL-OLD-PART-NUM(WS-TRANS-INDEX) TO SRT2-PART-NUM-1.
           MOVE WS-TBL-NEW-PART-NUM(WS-TRANS-INDEX) TO SRT2-PART-NUM-2.
                                                                      
           MOVE SPACES TO DETAIL-02.
           MOVE "A"          TO RPT02-SUPE-IND. 
           MOVE WS-TBL-OLD-PART-NUM(WS-TRANS-INDEX)
                             TO RPT02-OLD-PART-NUM.
           MOVE WS-TBL-NEW-PART-NUM(WS-TRANS-INDEX)
                             TO RPT02-NEW-PART-NUM.
           MOVE WS-TBL-OLD-PART-DESC(1)    
                             TO RPT02-OLD-PART-DESC.
           MOVE WS-TBL-NEW-PART-DESC(WS-TRANS-INDEX)
                             TO RPT02-NEW-PART-DESC.
                                                    
           IF WS-WIPLN-TOTAL < WS-TRANS-INDEX      
             MOVE WS-WIPLN-TOTAL TO SRT2-LINE-INDEXA
             MOVE SPACES         TO RPT02-LINE-INFO 
             MOVE DETAIL-02      TO REPORT-DATA     
             PERFORM R9100-INSERT-REPORT THRU R9100-EXIT 
             ADD 1 TO RS-TRN-RPT-INSRT-CTR              
           ELSE                                         
             MOVE WS-TRANS-INDEX TO WS-WIPLN-INDEX     
             PERFORM G1200-WIP-LINE-INFO THRU G1200-EXIT.
                                                     
       G1100-EXIT. EXIT.                            
                                                   

       G1200-WIP-LINE-INFO.
           MOVE "G1200-WIP-LINE-INFO.     " TO WS-PARAGRAPH.

           MOVE WS-WIPLN-INDEX                    TO SRT2-LINE-INDEXA.
           MOVE SPACES                            TO RPT02-LINE-INFO.
           MOVE WS-TBL-WIPLN-INFO(WS-WIPLN-INDEX) TO RPT02-LINE-INFO.
           MOVE DETAIL-02                         TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.
           ADD 1 TO RS-TRN-RPT-INSRT-CTR.
                                                       
       G1200-EXIT. EXIT.                              
                                                     
      ***************************************************************
      * G2000-CONTROL-REPORT:                                       *
      *     1. WRITE CONTROL REPORT.                                *
      *     2. BUILD AND INSERT CONTROL REPORT ROWS W/I ORACLE TABLE.*
      *************************************************************** 
       G2000-CONTROL-REPORT.
           MOVE "G2000-CONTROL-REPORT.    " TO WS-PARAGRAPH.
                                                          
      * BUILD AND WRITE SUPERSESSION CONTROL REPORT HEADINGS AND
      * TRANS ACTIVITY TOTAL LINE                              
