             DISPLAY "OEM        : ", WS-SEL-OEM-NUM
             DISPLAY "REGN       : ", WS-SEL-REGN-CD
             DISPLAY "PART NUMBER: ", WS-PART-NUMBER
             PERFORM Y1000-SQL-ERROR THRU Y1000-EXIT.

           MOVE "FETCH  " TO WS-FUNCTION.

           EXEC SQL
