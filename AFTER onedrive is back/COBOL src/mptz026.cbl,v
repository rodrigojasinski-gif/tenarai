               INTO  :WS-OLD-PART-NUM,
                     :WS-SUPERSEDING-PART-NUMBER,
                     :WS-SUPER-EFF-DATE
           END-EXEC.

           IF SQLCODE EQUAL SUCCESSFUL
               ADD 1 TO RS-SUPER-READ-CTR
               MOVE WS-SUPER-EFF-DATE TO WS-LST-UPD-DT
               MOVE WS-LST-UPD-MONTH  TO WS-OLDPART-SUPR-MONTH
               MOVE WS-LST-UPD-DAY    TO WS-OLDPART-SUPR-DAY
               MOVE WS-LST-UPD-YEAR   TO WS-OLDPART-SUPR-YEAR
           ELSE
