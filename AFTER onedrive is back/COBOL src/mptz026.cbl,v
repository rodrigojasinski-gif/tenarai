      ***************************************************************
      * R2000-READ-PART:                                            *
      *     1. PREPARE TO READ PART TABLE                           *
      ***************************************************************
       R2000-READ-PART.
           MOVE "R2000-READ-PART       " TO WS-PARAGRAPH.
           MOVE "PART                  " TO WS-TBLNAME.
           MOVE "DECLARE   "             TO WS-FUNCTION.
           EXEC SQL
            DECLARE PARTCURS CURSOR FOR
            SELECT /*+ INDEX (PART PART_UK) */
            PART_SKEY,
            PART_SUPPLIER_COUNTRY_ABBR,
            PART_NUMBER,
            DECODE(LAST_PRICE_DATE,NULL,' ',
                   TO_CHAR(LAST_PRICE_DATE,'MM/DD/YYYY')),
            DECODE(CURRENT_EFFECTIVE_DATE,NULL,' ',
                   TO_CHAR(CURRENT_EFFECTIVE_DATE,'MM/DD/YYYY')),
            CURRENT_PRICE,
            DECODE(PREVIOUS_EFFECTIVE_DATE,NULL,' ',
                   TO_CHAR(PREVIOUS_EFFECTIVE_DATE,'MM/DD/YYYY')),
            PREVIOUS_PRICE,
            SPECIAL_PRICE_FLAG,
            DECODE(DISCONTINUED_DATE,NULL,' ',
                   TO_CHAR(DISCONTINUED_DATE,'MM/DD/YYYY')),
            PART_DESCRIPTION,
            CORE_CHARGE_AMOUNT,
            NEW_OR_REMAN_FLAG,
            ZERO_PRICE_RESEARCH_FLAG
            FROM PART
            WHERE PART_SUPPLIER_NUMBER =
                   RTRIM(:WS-SEL-OEM-NUM)
             AND PART_SUPPLIER_COUNTRY_ABBR =
                   RTRIM(:WS-SEL-REGN-CD)
             AND PART_NUMBER > NVL(RTRIM(:WS-PART-NUMBER),' ')
            ORDER BY PART_NUMBER
           END-EXEC.

           MOVE "OPEN" TO WS-FUNCTION.

           EXEC SQL
               OPEN PARTCURS
           END-EXEC.

           IF SQLCODE NOT EQUAL SUCCESSFUL
             DISPLAY WS-DB-ERR-MSG
             DISPLAY WS-FUNCTION
             DISPLAY "BAD OPEN PARTCURS"
             DISPLAY "OEM        : ", WS-SEL-OEM-NUM
             DISPLAY "REGN       : ", WS-SEL-REGN-CD
             DISPLAY "PART NUMBER: ", WS-PART-NUMBER
             PERFORM Y1000-SQL-ERROR THRU Y1000-EXIT.

           PERFORM R2010-FETCH-PART-ROW THRU R2010-EXIT.

           IF PART-FOUND
             GO TO R2000-EXIT
           ELSE
             PERFORM R2005-CLOSE-PART-CURSOR THRU R2005-EXIT.

       R2000-EXIT. EXIT.

