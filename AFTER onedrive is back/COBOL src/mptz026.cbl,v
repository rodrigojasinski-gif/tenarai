      *     2. IF ROW FOUND,  HOLD ONTO SUPERSESSION EFFECTIVE DATE *
      *        ELSE, SET IT TO ZERO                                 *
      ***************************************************************
       R3010-READ-SUPER-BY-PART.
           MOVE "R3010-READ-SUPER-BY-PART." TO WS-PARAGRAPH.
           MOVE "SUPERSESSION             " TO WS-TBLNAME.
           MOVE "DECLARE   "                TO WS-FUNCTION.

            EXEC SQL
             DECLARE SUPCURS2 CURSOR FOR
              SELECT
               PART_NUMBER,
               SUPERSEDING_PART_NUMBER,
               TO_CHAR(SUPERSESSION_EFFECTIVE_DATE,'MM/DD/YYYY')
              FROM  SUPERSESSION
              WHERE PART_SUPPLIER_NUMBER = RTRIM(:WS-SEL-OEM-NUM)
              AND PART_SUPPLIER_COUNTRY_ABBR = RTRIM(:WS-SEL-REGN-CD)
              AND PART_NUMBER = RTRIM(:TR-OLD-PART-NUM)
              AND SUPERSESSION_EFFECTIVE_DATE =
               (SELECT  MAX(SUPERSESSION_EFFECTIVE_DATE)
                FROM SUPERSESSION
                WHERE PART_SUPPLIER_NUMBER = RTRIM(:WS-SEL-OEM-NUM)
                 AND PART_SUPPLIER_COUNTRY_ABBR = RTRIM(:WS-SEL-REGN-CD)
                 AND PART_NUMBER  = RTRIM(:TR-OLD-PART-NUM))
           END-EXEC.


           MOVE "OPEN   " TO WS-FUNCTION.
           EXEC SQL
               OPEN SUPCURS2
           END-EXEC.

           IF SQLCODE NOT EQUAL SUCCESSFUL
