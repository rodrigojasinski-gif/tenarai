      ***************************************************************
      * C2400-ADDTO-PRUPSAM-CTRS:                                   *
      *     1. ADD TO THE VARIOUS PRICE-UPDT-SAME LINE AND PART     *
      *        COUNTERS (FOR CONTROL REPORTING)                     *
      ***************************************************************
       C2400-ADDTO-PRUPSAM-CTRS.
           MOVE "C2400-ADDTO-PRUPSAM-CTRS." TO WS-PARAGRAPH.

           ADD 1 TO RS-PRUPSAM-PRT-DB-CTR.

           IF WS-CEGLN-COUNT > 0
             ADD WS-CEGLN-COUNT TO RS-PRUPSAM-CEG-LCTR
             ADD 1 TO RS-PRUPSAM-CEG-PCTR.

           IF WS-WIPLN-COUNT > 0
             ADD WS-WIPLN-COUNT TO RS-PRUPSAM-WIP-LCTR
             ADD 1 TO RS-PRUPSAM-WIP-PCTR.
       C2400-EXIT. EXIT.

      ***************************************************************
      * C2500-ADDTO-REPL-PRUPSAM-CTRS:                              *
      *     1. ADD TO THE VARIOUS REPL-PRICE-UPDT-SAME LINE AND     *
      *        PART COUNTERS (FOR CONTROL REPORTING)                *
      ***************************************************************
       C2500-ADDTO-REPL-PRUPSAM-CTRS.
           MOVE "C2500-ADDTO-REPL-PRUPSAM-" TO WS-PARAGRAPH.

           ADD 1 TO RS-RPRUPSAM-PRT-DB-CTR.

           IF WS-CEGLN-COUNT > 0
             ADD WS-CEGLN-COUNT TO RS-RPRUPSAM-CEG-LCTR
             ADD 1 TO RS-RPRUPSAM-CEG-PCTR.

           IF WS-WIPLN-COUNT > 0
             ADD WS-WIPLN-COUNT TO RS-RPRUPSAM-WIP-LCTR
             ADD 1 TO RS-RPRUPSAM-WIP-PCTR.
       C2500-EXIT. EXIT.

      ***************************************************************
      * C2600-ADDTO-PRUPVAR-CTRS:                                   *
      *     1. ADD TO THE VARIOUS PRICE-UPDT-VARIANCE LINE AND PART *
      *        COUNTERS (FOR CONTROL REPORTING)                     *
      ***************************************************************
       C2600-ADDTO-PRUPVAR-CTRS.
           MOVE "C2600-ADDTO-PRUPVAR-CTRS." TO WS-PARAGRAPH.

         IF WS-TR-PRICE < WS-PREV-PRICE-AMT
                 GO TO C2600-CONT.

      *  ADD TO INCREASE VARIANCE COUNTERS

           ADD 1 TO RS-PRUPVAI-PRT-DB-CTR.

           IF WS-CEGLN-COUNT > 0
             ADD WS-CEGLN-COUNT TO RS-PRUPVAI-CEG-LCTR
             ADD 1 TO RS-PRUPVAI-CEG-PCTR.

           IF WS-WIPLN-COUNT > 0
             ADD WS-WIPLN-COUNT TO RS-PRUPVAI-WIP-LCTR
             ADD 1 TO RS-PRUPVAI-WIP-PCTR.
           GO TO C2600-EXIT.

      *  ADD TO DECREASE COUNTERS

       C2600-CONT.
           MOVE "C2600-CONT.              " TO WS-PARAGRAPH.

           ADD 1 TO RS-PRUPVAD-PRT-DB-CTR.

           IF WS-CEGLN-COUNT > 0
             ADD WS-CEGLN-COUNT TO RS-PRUPVAD-CEG-LCTR
             ADD 1 TO RS-PRUPVAD-CEG-PCTR.

           IF WS-WIPLN-COUNT > 0
             ADD WS-WIPLN-COUNT TO RS-PRUPVAD-WIP-LCTR
             ADD 1 TO RS-PRUPVAD-WIP-PCTR.
       C2600-EXIT. EXIT.

      ***************************************************************
      * C2700-ADDTO-ZPNEW-CTRS:                                     *
      *     1. ADD TO THE VARIOUS ZERO-PRICED-NEWLY LINE AND PART   *
      *        COUNTERS (FOR CONTROL REPORTING)                     *
      ***************************************************************
       C2700-ADDTO-ZPNEW-CTRS.
           MOVE "C2700-ADDTO-ZPNEW-CTRS.  " TO WS-PARAGRAPH.

           ADD 1 TO RS-ZPNEW-PRT-DB-CTR.

           IF WS-CEGLN-COUNT > 0
             ADD WS-CEGLN-COUNT TO RS-ZPNEW-CEG-LCTR
             ADD 1 TO RS-ZPNEW-CEG-PCTR.

           IF WS-WIPLN-COUNT > 0
             ADD WS-WIPLN-COUNT TO RS-ZPNEW-WIP-LCTR
             ADD 1 TO RS-ZPNEW-WIP-PCTR.
       C2700-EXIT. EXIT.

      ***************************************************************
      * C3000-DB-GT-TRANS:                                          *
      *     *** TRANSACTION WITH NO MATCHING DATABASE ROW           *
      *     *** INSERT NEW PART                                     *
      *     1. CHECK VALID PART NUMBER ON TRANS RECORD              *
      *     2. CHECK IF THIS IS A PRICE UPDATE FOR A PART WHICH WAS *
      *        SUPERSEDED                                           *
      *     3. IF NOT, INSERT PART AND PRICE ROW FOR NEW PART #     *
      *     4. GET NEXT TRANS RECORD                                *
      ***************************************************************
       C3000-DB-GT-TRANS.
           MOVE "C3000-DB-GT-TRANS" TO WS-PARAGRAPH.

           IF TR-OLD-PART-NUM EQUAL SPACES
             MOVE WS-ERR-MSG-TR6 TO WS-ERR-MSG
             ADD 1 TO RS-NOT-PROC-CTR
             PERFORM G4000-ERROR-REPORT THRU G4000-EXIT
             GO TO C3000-CONTINUE.

      ***************************************************************
      *   ALWAYS CHECK THE LATEST SUPERSESSION WHERE THE PART IS THE
      *   'OLD' PART.
      *   CHECK IF THIS PART IS THE END OF A SUPERSESSION CHAIN (BY
      *   DATE). IF IT IS NOT, ADD THE PART BACK TO THE PARTS
      *   TABLE.
      *   IN THE CASE OF A LOOPING SUPERSESSION, WE WILL ONLY
      *   ADD/PRICE THE LATER DATED PART (WHETHER OEM FOLLOWS DATE OR
      *   NOT)
      ***************************************************************

           IF NOT-END-OF-DATABASE
              PERFORM D6000-HOLD-EXISTING-DB-PART THRU D6000-EXIT.

           IF COUNTRY-EXCEPTION1
              NEXT SENTENCE
           ELSE
               PERFORM R3010-READ-SUPER-BY-PART THRU R3010-EXIT
               IF WS-OLDPART-SUPR-DATE IS EQUAL TO ZEROES
                  NEXT SENTENCE
               ELSE
                  ADD 1 TO RS-PRIOR-SUPE-CTR
                  ADD 1 TO RS-NOT-PROC-CTR
                  GO TO C3000-CONTINUE.

      ***************************************************************
      * ADD PART BACK TO THE PARTS TABLE.
      ***************************************************************
           ADD 1 TO RS-PROC-CTR.

           PERFORM D5000-SETUP-NEW-PART-ROW THRU D5000-EXIT.

           PERFORM R2100-INSERT-PART THRU R2100-EXIT.

           IF PART-ALREADY-EXISTS
      * Since the insert uses TR-OLD-PART-NUM, the current part number
      * is saved and moved back after the update
             MOVE WS-PART-NUMBER   TO WS-HOLD-PART-NUM
             MOVE TR-OLD-PART-NUM  TO WS-PART-NUMBER
             PERFORM R2200-UPDATE-PART  THRU R2200-EXIT
             MOVE WS-HOLD-PART-NUM TO WS-PART-NUMBER
             ADD 1 TO RS-PART-UPDT-BOTH-CTR.

      * When processing Puerto Rico part inserts, get part counts
      * in the part supplier's 'US' services for the transaction part
      * to be inserted. Save the current DB part number and restore
      * after processing the insert.
           IF COUNTRY-EXCEPTION1
             MOVE WS-PART-NUMBER   TO WS-HOLD-PART-NUM
             MOVE TR-OLD-PART-NUM  TO WS-PART-NUMBER
             PERFORM D1000-GET-COUNTS THRU D1000-EXIT
             MOVE WS-HOLD-PART-NUM TO WS-PART-NUMBER.

       C3000-CONTINUE.
           MOVE "C3000-CONTINUE." TO WS-PARAGRAPH.

******* Note: Error msg is generated in Oracle 8i when try
*******      to open cursor without 1st closing the cursor.
*******      ANSI Standard: Do Not Fetch Across Commits

           PERFORM F0000-COMMIT-CHECK THRU F0000-EXIT.

           IF COMMIT-PERFORMED
              MOVE "N" TO WS-COMMIT-SW
              IF NOT-END-OF-DATABASE
                 PERFORM R2005-CLOSE-PART-CURSOR THRU
                         R2005-EXIT
                 MOVE TR-OLD-PART-NUM TO WS-PART-NUMBER
                 PERFORM R2000-READ-PART THRU R2000-EXIT
*gnw***          display "c3000 cmt cls/opn/fetch part csr"
              END-IF
           ELSE
              IF NOT-END-OF-DATABASE
                  PERFORM D7000-MOVE-HELD-DBPART-BACK THRU D7000-EXIT.

           PERFORM R10000-READ-TRANS  THRU R10000-EXIT.

       C3000-EXIT. EXIT.

      ***************************************************************
      * D1000-BUILD-DATES-CD: USED FOR UPDATE OF EXISTING PART ROW  *
      *     1. MOVE CONTROL DATE TO LAST UPDATE DATE                *
      ***************************************************************
       D1000-GET-COUNTS.
           MOVE "D1000-GET-COUNTS.    " TO WS-PARAGRAPH.

           MOVE WS-PROD-VER-TYPE TO WS-VERSION-TYPE.
           PERFORM R4005-COUNT-ACTIV-CEGLINE THRU R4005-EXIT.

           MOVE WS-WIP-VER-TYPE  TO WS-VERSION-TYPE.
           PERFORM R4005-COUNT-ACTIV-CEGLINE THRU R4005-EXIT.

       D1000-EXIT. EXIT.

      ***************************************************************
      * D2000-BUILD-DATES-CD: USED FOR UPDATE OF EXISTING PART ROW  *
      *     1. MOVE CONTROL DATE TO LAST UPDATE DATE                *
      *     2. NULL OUT DISC DATE                                   *
      *     3. VALUE STATUS CODE. (IF IT WAS "D", IT WILL EITHER BE *
      *          BLANKED OUT OR REPLACED WITH THE TARGET MARKET IND)*
      *     4. VALUE PART DESC - ONLY IF TRANS DESC IS VALUED.      *
      *                          IF IT'S NOT VALUED, LEAVE DB INTACT*
      ***************************************************************
       D2000-BUILD-DATES-CD.
           MOVE "D2000-BUILD-DATES-CD.    " TO WS-PARAGRAPH.

           MOVE CNTL-EFF-DT         TO WS-LST-PRICE-DT.
           MOVE ZERO                TO WS-NULLIND-PDT
           MOVE -1                  TO WS-NULLIND-DDT.
           MOVE TR-SPECIAL-PRICE-CD TO WS-STAT-CD.
           MOVE TR-REMFR-IND        TO WS-REMFR-FL.
           MOVE WS-TR-CORE-CHARGE   TO WS-CORE-CHG-AMT.
           IF TR-PART-DESC NOT EQUAL SPACES
             MOVE TR-PART-DESC TO WS-PART-DESC.

       D2000-EXIT. EXIT.

      ***************************************************************
      * D3000-MOVE-CURR-PREV:                                       *
      *     USED FOR UPDATE OF EXISTING PART ROW                    *
      *     1. MOVE CURRENT PART INFO TO PREV PART INFO             *
      *        (PRICE-AMT AND EFFECTIVE DATE)                       *
      ***************************************************************
       D3000-MOVE-CURR-PREV.
           MOVE "D3000-MOVE-CURR-PREV.    " TO WS-PARAGRAPH.

           MOVE WS-CURR-PRICE-AMT  TO WS-PREV-PRICE-AMT.
           MOVE WS-CURR-EFF-DT     TO WS-PREV-EFF-DT.
           MOVE ZERO               TO WS-NULLIND-PEDT.

       D3000-EXIT. EXIT.

      ***************************************************************
      * D4000-BUILD-CURR-PRICE:                                     *
      *     USED FOR UPDATE OF EXISTING PART ROW                    *
      *     1. MOVE TRANSACTION INFORMATION TO CURRENT WSTG AREA    *
      *        (PRICE-AMT AND EFFECTIVE DATE)                       *
      ***************************************************************
       D4000-BUILD-CURR-PRICE.
           MOVE "D4000-BUILD-CURR-PRICE.  " TO WS-PARAGRAPH.

           MOVE WS-TR-PRICE    TO WS-CURR-PRICE-AMT.
           MOVE CNTL-EFF-DT    TO WS-CURR-EFF-DT.
           MOVE ZERO           TO WS-NULLIND-CEDT.
           MOVE TR-REMFR-IND   TO WS-REMFR-FL.
           MOVE "N"            TO WS-ZERO-PRICE-RSRCH-FL.

       D4000-EXIT. EXIT.

      ***************************************************************
      * D5000-SETUP-NEW-PART-ROW:                                   *
      *     USED FOR INSERT OF NEW PART ROW                         *
      *     1. MOVE CONTROL DATE TO LAST UPDATE & CURR PRICE DATES  *
      *     2. MOVE TRANS PRICE AND STAT CODE INTO COLUMNS          *
      *     3. BLANK/NULL OUT PREVIOUS PRICE INFO                   *
      *     4. NULL OUT DISC DATES                                  *
      ***************************************************************
       D5000-SETUP-NEW-PART-ROW.
           MOVE "D5000-SETUP-NEW-PART-ROW." TO WS-PARAGRAPH.

           MOVE CNTL-REGN-CD        TO WS-SEL-REGN-CD.
           MOVE CNTL-EFF-DT         TO WS-LAST-PRICE-DATE.
           MOVE ZERO                TO WS-NULLIND-PRT-PDT.
           MOVE CNTL-EFF-DT         TO WS-CURRENT-EFFECTIVE-DATE.
           MOVE ZERO                TO WS-NULLIND-PRT-CEDT.
           MOVE WS-TR-PRICE         TO WS-CURRENT-PRICE.
           MOVE -1                  TO WS-NULLIND-PRT-PEDT.
           MOVE ZEROES              TO WS-PREVIOUS-PRICE.
           MOVE TR-SPECIAL-PRICE-CD TO WS-SPECIAL-PRICE-FLAG.
           MOVE -1                  TO WS-NULLIND-PRT-DDT.
           MOVE TR-PART-DESC        TO WS-PART-DESCRIPTION.
           MOVE WS-TR-CORE-CHARGE   TO WS-CORE-CHARGE-AMOUNT.
           MOVE TR-REMFR-IND        TO WS-NEW-OR-REMAN-FLAG.
           MOVE "N"                 TO WS-ZERO-PRICE-RESEARCH-FLAG.
           MOVE "Y"                 TO WS-NLS-FLAG.

       D5000-EXIT. EXIT.

      ***************************************************************
      * D6000-HOLD-EXISTING-DB-PART:                                *
      *     USED TO SET ASIDE DB PART THAT WAS READ IN, WHILE A NEW *
      *     PART ROW IS INSERTED.                                   *
      ***************************************************************
       D6000-HOLD-EXISTING-DB-PART.
           MOVE "D6000-HOLD-EXISTING-DB-PA" TO WS-PARAGRAPH.

             INITIALIZE SAVED-PART-INFO
                 REPLACING ALPHANUMERIC DATA BY SPACES
                           NUMERIC DATA BY ZEROES.

             MOVE WS-PART-NUMBER             TO SAV-PART-NUM.
             MOVE WS-SEL-REGN-CD             TO SAV-REGN-CD.
             MOVE WS-LAST-PRICE-DATE         TO SAV-LST-PRICE-DT.
             MOVE WS-NULLIND-PRT-PDT         TO SAV-NULLIND-PRT-PDT.
             MOVE WS-CURRENT-EFFECTIVE-DATE  TO SAV-CURR-EFF-DT.
             MOVE WS-NULLIND-PRT-CEDT        TO SAV-NULLIND-PRT-CEDT.
             MOVE WS-CURRENT-PRICE           TO SAV-CURR-PRICE-AMT.
             MOVE WS-NULLIND-PRT-PEDT        TO SAV-NULLIND-PRT-PEDT.
             MOVE WS-PREVIOUS-PRICE          TO SAV-PREV-PRICE-AMT.
             MOVE WS-SPECIAL-PRICE-FLAG      TO SAV-STAT-CD.
             MOVE WS-NULLIND-PRT-DDT         TO SAV-NULLIND-PRT-DDT.
             MOVE WS-PART-DESCRIPTION        TO SAV-PART-DESC.
             MOVE WS-CORE-CHARGE-AMOUNT      TO SAV-CORE-CHG-AMT.
             MOVE WS-NEW-OR-REMAN-FLAG       TO SAV-REMFR-FL.
             MOVE WS-ZERO-PRICE-RESEARCH-FLAG TO
                                             SAV-ZERO-PRICE-RSRCH-FL.
       D6000-EXIT. EXIT.

      ***************************************************************
      * D7000-MOVE-HELD-DBPART-BACK:                                *
      *     MOVES SAVED DB PART INFO BACK TO WS-NULLIND FIELDS AND  *
      *     PART PART ROW AREA.                                     *
      ***************************************************************
       D7000-MOVE-HELD-DBPART-BACK.
           MOVE "D7000-MOVE-HELD-DBPART-BACK" TO WS-PARAGRAPH.

             MOVE SAV-PART-NUM           TO WS-PART-NUMBER.
             MOVE SAV-REGN-CD            TO WS-SEL-REGN-CD.
             MOVE SAV-LST-PRICE-DT       TO WS-LAST-PRICE-DATE.
             MOVE SAV-NULLIND-PRT-PDT    TO WS-NULLIND-PRT-PDT.
             MOVE SAV-CURR-EFF-DT        TO WS-CURRENT-EFFECTIVE-DATE.
             MOVE SAV-NULLIND-PRT-CEDT   TO WS-NULLIND-PRT-CEDT.
             MOVE SAV-CURR-PRICE-AMT     TO WS-CURRENT-PRICE.
             MOVE SAV-NULLIND-PRT-PEDT   TO WS-NULLIND-PRT-PEDT.
             MOVE SAV-PREV-PRICE-AMT     TO WS-PREVIOUS-PRICE.
             MOVE SAV-STAT-CD            TO WS-SPECIAL-PRICE-FLAG.
             MOVE SAV-NULLIND-PRT-DDT    TO WS-NULLIND-PRT-DDT.
             MOVE SAV-PART-DESC          TO WS-PART-DESCRIPTION.
             MOVE SAV-CORE-CHG-AMT       TO WS-CORE-CHARGE-AMOUNT.
             MOVE SAV-REMFR-FL           TO WS-NEW-OR-REMAN-FLAG.
             MOVE SAV-ZERO-PRICE-RSRCH-FL TO
                                         WS-ZERO-PRICE-RESEARCH-FLAG.
       D7000-EXIT. EXIT.

      ***************************************************************
      * E1000-INITIALIZE-RESTART-WSTG:                              *
      *     1. INITIALIZE WORKING STORAGE RESTART AREAS             *
      ***************************************************************
       E1000-INITIALIZE-RESTART-WSTG.
           MOVE "E1000-INITIALIZE-RESTART-" TO WS-PARAGRAPH.

           INITIALIZE RESTART-RECORD
                      REPLACING ALPHANUMERIC DATA BY SPACES
                                NUMERIC DATA BY ZEROES.
       E1000-EXIT. EXIT.

      ***************************************************************
      * F0000-COMMIT-CHECK:                                         *
      *     1. CHECK IF NEED TO COMMIT                              *
      ***************************************************************
       F0000-COMMIT-CHECK.
           MOVE "F0000-COMMIT-CHECK.      " TO WS-PARAGRAPH.

           IF WS-DB-ROW-CTR > COMMIT-LIMIT
               PERFORM F1000-COMMIT THRU F1000-EXIT.

       F0000-EXIT. EXIT.

      ***************************************************************
      * F1000-COMMIT:                                               *
      *     1. UPDATE RESTART TABLE                                 *
      *        THE FIRST TIME THAT A COMMIT IS PERFORMED, THE       *
      *        RESTART ROWS ARE INSERTED. SUBSEQUENT COMMITS INVOKE *
      *        UPDATES TO THE RESTART TABLE. AT THE END OF THE RUN, *
      *        ALL RESTART ROWS ARE DELETED.                        *
      *     2. COMMIT ORACLE TABLE ACTIVITY                         *
      ***************************************************************
       F1000-COMMIT.
           MOVE "F1000-COMMIT.            " TO WS-PARAGRAPH.

           PERFORM F2000-BUILD-RESTART-REC THRU F2000-EXIT.
           IF RESTART-READ-WRITTEN
              PERFORM R8200-UPDATE-RESTART THRU R8200-EXIT
           ELSE
              PERFORM R8100-INSERT-RESTART THRU R8100-EXIT.

           EXEC SQL
             COMMIT
           END-EXEC.

           MOVE "Y"  TO WS-COMMIT-SW.

           MOVE ZERO TO WS-DB-ROW-CTR.

       F1000-EXIT. EXIT.

      ***************************************************************
      * F2000-BUILD-RESTART-REC:                                    *
      *     1. MOVE INFORMATION TO RESTART WORKING STORAGE RECORD 1 *
      ***************************************************************
       F2000-BUILD-RESTART-REC.
           MOVE "F2000-BUILD-RESTART-REC. " TO WS-PARAGRAPH.

           MOVE CNTL-EFF-DT      TO RS-EFF-DT.
           MOVE TR-OLD-PART-NUM  TO RS-TR-OLD-PART-NUM.
           MOVE WS-TR-PRICE-XX   TO RS-TR-PRICE.
           MOVE WS-PART-NUM      TO RS-DB-PART-NUM.

       F2000-EXIT. EXIT.

      ***************************************************************
      * G1000-PRICE-VAR-REPORT:                                     *
      *     THIS ROUTINE BUILDS THE PARTS VARIANCE REPORT ROW       *
      *     WITHIN THE ORACLE REPORT TABLE.                         *
      *     1. MOVE CONTROL INFORMATION TO ORACLE REPORT TBL COLUMNS*
      *     2. INITIALIZE AND MOVE ORACLE & TRANS INFO TO REPORT    *
      *        AREA FIELDS.                                         *
      *     3. INITIALIZE AND MOVE TRANS INFORMATION TO SORT        *
      *        CRITERIA FIELDS. THIS IS PERFORMED ONE-TO-MANY TIMES *
      *        BASED ON WHETHER THE PART IS ASSOCIATED TO CEG LINES.*
      ***************************************************************
       G1000-PRICE-VAR-REPORT.
           MOVE "G1000-PRICE-VAR-REPORT.  " TO WS-PARAGRAPH.

           MOVE "MPTZ007-03"    TO REPORT-NUMBER.
           MOVE SPACES          TO SORT-CRITERIA-03.
           MOVE SPACES          TO DETAIL-03.
           MOVE TR-OLD-PART-NUM TO SRT3-PART-NUM,
                                   RPT03-OLD-PART-NUM.
           IF WS-PART-DESC EQUAL SPACES
             MOVE TR-PART-DESC  TO RPT03-OLD-PART-DESC
           ELSE
             MOVE WS-PART-DESC  TO RPT03-OLD-PART-DESC.

      * PG - changed sort criteria to include calc-var-amt and
      *      price (per mtg with Vicki Gurner).
           MOVE WS-TR-PRICE     TO RPT03-CURR-PRICE-AMT,
                                   SRT3-CURR-PRICE-AMT.
           MOVE WS-PREV-PRICE-AMT TO RPT03-PREV-PRICE-AMT.
           MOVE WS-CALC-VAR-AMT   TO RPT03-PRICE-VAR-AMT,
                                     SRT3-PRICE-VAR-AMT.
           MOVE WS-CALC-VAR-PCT   TO RPT03-PRICE-VAR-PCT.

           IF WS-CEGLN-COUNT > ZERO
              MOVE SPACES TO WS-CEGLN-SW
              PERFORM R4050-OPEN-CEGLN         THRU R4050-EXIT
              PERFORM G1100-PRICE-VAR-CEGLN    THRU G1100-EXIT
                   UNTIL END-OF-CEGLN-ROWS
              PERFORM R4070-CLOSE-CURSOR-CEGLN THRU R4070-EXIT.

           IF WS-WIPLN-COUNT > ZERO
              MOVE SPACES TO WS-WIPLN-SW
              PERFORM R5050-OPEN-WIPLN         THRU R5050-EXIT
              PERFORM G1150-PRICE-VAR-WIPLN    THRU G1150-EXIT
                   UNTIL END-OF-WIPLN-ROWS
              PERFORM R5070-CLOSE-CURSOR-WIPLN THRU R5070-EXIT.
       G1000-EXIT. EXIT.

      ***************************************************************
      * G1100-PRICE-VAR-CEGLN:                                      *
      *     1. FETCH THE NEXT CEGLN ROW                             *
      *     2. IF SERVICE IS NOT THE SAME AS THE LAST LINE READ,    *
      *        A. MOVE CEGLN INFORMATION TO REPORT AREA             *
      *        B. GET THE MODEL NAME ASSOC. WITH CEG LINE SERVICE   *
      *     3. IF SERVICE NUMBER IS THE SAME AS THE LAST LINE READ, *
      *        THE SERVICE/MODEL INFO IS ALREADY VALUED FROM        *
      *        PREVIOUS READ.                                       *
      *     4. INSERT PRICE VARIANCE REPORT ROW                     *
      ***************************************************************
       G1100-PRICE-VAR-CEGLN.
           MOVE "G1100-PRICE-VAR-CEGLN.   " TO WS-PARAGRAPH.

           PERFORM R4060-FETCH-CEGLN THRU R4060-EXIT.
           IF END-OF-CEGLN-ROWS
             GO TO G1100-EXIT.

           MOVE WS-SCD-ACCESS-CO TO SRT3-LN-SEQ-NUM,
                                    RPT03-LN-SEQ-NUM.

           MOVE SPACES TO RPT03-WIP-FLG.

           IF WS-SCD-SERVICE-NUMBER NOT EQUAL RPT03-SRVC-NUM
             MOVE WS-SCD-MFR-NUMBER     TO WS-MFR-NUMBER
             MOVE WS-PROD-VER-TYPE      TO WS-VERSION-TYPE
             MOVE WS-SCD-SERVICE-NUMBER TO SRT3-SRVC-NUM
                                           RPT03-SRVC-NUM
                                           WS-SERVICE
             PERFORM R11000-READ-SVC-COUNTRY THRU R11000-EXIT
             IF CEGSRVC-FOUND
                MOVE WS-MODEL-NAME TO SRT3-MODEL-NM,
                                      RPT03-MODEL-NM
                MOVE WS-YEAR-RANGE TO SRT3-YR-RNGE-TXT,
                                      RPT03-YR-RNGE-TXT
             ELSE
                MOVE "MODEL NOT FOUND IN SVC COUNTRY"
                                   TO SRT3-MODEL-NM,
                                      RPT03-MODEL-NM.

           MOVE DETAIL-03 TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.
           ADD 1 TO RS-TRN-RPT-INSRT-CTR.

       G1100-EXIT. EXIT.


      ***************************************************************
      * G1150-PRICE-VAR-WIPLN:                                      *
      *     1. FETCH THE NEXT WIPLN ROW                             *
      *     2. IF SERVICE IS NOT THE SAME AS THE LAST LINE READ,    *
      *        A. MOVE WIPLN INFORMATION TO REPORT AREA             *
      *        B. GET THE MODEL NAME ASSOC. WITH CEG LINE SERVICE   *
      *     3. IF SERVICE NUMBER IS THE SAME AS THE LAST LINE READ, *
      *        THE SERVICE/MODEL INFO IS ALREADY VALUED FROM        *
      *        PREVIOUS READ.                                       *
      *     4. INSERT PRICE VARIANCE REPORT ROW                     *
      ***************************************************************
       G1150-PRICE-VAR-WIPLN.
           MOVE "G1150-PRICE-VAR-WIPLN.   " TO WS-PARAGRAPH.

           PERFORM R5060-FETCH-WIPLN THRU R5060-EXIT.
           IF END-OF-WIPLN-ROWS
              GO TO G1150-EXIT.

           MOVE WS-SCD-ACCESS-CO TO SRT3-LN-SEQ-NUM,
                                    RPT03-LN-SEQ-NUM.

           MOVE "W" TO RPT03-WIP-FLG.

           IF WS-SCD-SERVICE-NUMBER NOT EQUAL RPT03-SRVC-NUM
             MOVE WS-SCD-MFR-NUMBER     TO WS-MFR-NUMBER
             MOVE WS-WIP-VER-TYPE       TO WS-VERSION-TYPE
             MOVE WS-SCD-SERVICE-NUMBER TO SRT3-SRVC-NUM
                                             RPT03-SRVC-NUM
                                             WS-SERVICE
             PERFORM R11000-READ-SVC-COUNTRY THRU R11000-EXIT
             IF WIPSRVC-FOUND
                MOVE WS-MODEL-NAME TO SRT3-MODEL-NM,
                                      RPT03-MODEL-NM
                MOVE WS-YEAR-RANGE TO SRT3-YR-RNGE-TXT,
                                      RPT03-YR-RNGE-TXT
              ELSE
                MOVE "MODEL NOT FOUND IN SVC COUNTRY"
