      *  GET THE NUMBER OF INSTANCES THAT THE PART SUPPLIER PART    * 
      *  NUMBER IS IN THE PART/ALTERNATE PARTS CROSS REFERENCE TABLE*  
      ***************************************************************   
       R7500-ALTPART-IMPACT-COUNT.                                            
           MOVE "R7500-ALTPART-IMPACT-COUNT" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH       TO WS-PARNAME.       
           MOVE "PART-ALTPART-XREF" TO WS-TBLNAME.
           MOVE "SELECT "           TO WS-FUNCTION.   
           
           EXEC SQL EXECUTE                                             
            BEGIN                                                     
            PKG_ALTERNATE_PARTS.P_PART_ALTPART_XREF_SEL_01
                                      (:WS-SEL-OEM-NUM, 
                                       :WS-SEL-REGN-CD,
                                       :TR-NEW-PART-NUM,
                                       :WS-ROW-READ-COUNT,
                                       :WS-ERROR-TEXT,
                                       :WS-SQLCODE);
            END;                                                      
           END-EXEC.
           MOVE WS-SQLCODE TO SQLCODE.

           IF SQLCODE EQUAL SUCCESSFUL                                  
              ADD WS-ROW-READ-COUNT   TO RS-ALTPART-UPDT-CTR,
                                         RS-ALTPART-READ-CTR,
                                         WS-DB-ROW-CTR
           ELSE
              IF SQLCODE EQUAL NOT-FOUND
                 NEXT SENTENCE                         
              ELSE                                                         
                 DISPLAY WS-DB-ERR-MSG                                    
                 DISPLAY "BAD SELECT ALTPART OLD PART NUMBER: ", 
                                           WS-CURRENT-PART
                 PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R7500-EXIT.   EXIT.

      ***************************************************************   
      * R8000-READ-RESTART:                                         *   
      * 1. READ ACQ-BATCH-RESTART Oracle RESTART ROWS               *
      *     (REC TYPE A AND C)  RETURN RESTART DATA.                *
      ***************************************************************   
       R8000-READ-RESTART.                                              
           MOVE "R8000-READ-RESTART" TO WS-PARAGRAPH. 
           MOVE  WS-PARAGRAPH        TO WS-PARNAME.                  
           MOVE "ACQ-BATCH-RESTART"  TO WS-TBLNAME.
           MOVE "SELECT "            TO WS-FUNCTION.
     **    The initialization of returned table columns is required.
      *     INITIALIZE WS-RESTART-DATA.
           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_SEL_01
                              (:WS-PROGRAM-NAME,   
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-CNTL-EFF-DT,
                               :WS-RESTART-DATA,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
           END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL
             MOVE "Y" TO WS-RESTART-SW 
             MOVE WS-RESTART-DATA TO RESTART-RECORD
           ELSE
            IF SQLCODE EQUAL NOT-FOUND
              MOVE "N" TO WS-RESTART-SW 
              GO TO R8000-EXIT
            ELSE 
              DISPLAY WS-DB-ERR-MSG 
              DISPLAY "BAD SELECT OF RESTART DATA ACQ_BATCH_RESTART"
              DISPLAY "PROGRAM NAME: ",
                       WS-PROGRAM-NAME 
              PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.
                                                                          
       R8000-EXIT. EXIT.                                                

      ***************************************************************   
      * R8100-INSERT-RESTART:                                       *   
      *1. INSERT ACQ-BATCH-RESTART Oracle RESTART ROWS (TYPE A AND C)*
      ***************************************************************   
       R8100-INSERT-RESTART.                                            
           MOVE "R8100-INSERT-RESTART" TO WS-PARAGRAPH. 
           MOVE  WS-PARAGRAPH          TO WS-PARNAME.                
           MOVE "ACQ_BATCH_RESTART "   TO WS-TBLNAME.
           MOVE "INSERT " TO WS-FUNCTION.                               

           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_INS_01
                              (:WS-PROGRAM-NAME,   
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-RESTART-DATA,
                               :WS-CNTL-EFF-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
           END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL                                  
             MOVE "Y" TO WS-RESTART-SW                                  
           ELSE                                                         
             DISPLAY WS-DB-ERR-MSG 
             DISPLAY "BAD INSERT RESTART DATA TO ACQ-BATCH-RESTART"
             DISPLAY "PROGRAM NAME: ", 
                     WS-PROGRAM-NAME 
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.
                                                                        
       R8100-EXIT. EXIT.                                                

      ***************************************************************   
      * R8200-UPDATE-RESTART:                                       *   
      *     1. UPDATE ACQ-BATCH-RESTART Oracle RESTART ROWS         *
      ***************************************************************   
       R8200-UPDATE-RESTART.                                            
           MOVE "R8200-UPDATE-RESTART" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH          TO WS-PARNAME.                 
           MOVE "ACQ_BATCH_RESTART "   TO WS-TBLNAME.
           MOVE "UPDATE "  TO WS-FUNCTION.                              

           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_UPD_01
                              (:WS-PROGRAM-NAME,   
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-RESTART-DATA,
                               :WS-CNTL-EFF-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE NOT EQUAL SUCCESSFUL                              
             DISPLAY WS-DB-ERR-MSG 
             DISPLAY "BAD UPDATE OF ACQ_BATCH_RESTART RESTART DATA"
             DISPLAY "PROGRAM NAME: ", 
                     WS-PROGRAM-NAME 
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.
                                                                        
       R8200-EXIT. EXIT.                                                
                                                                        
      ***************************************************************   
      * R8300-DELETE-RESTART:                                       *   
      *     1. DELETE ACQ-BATCH-RESTART DB RESTART ROWS             *    
      ***************************************************************   
       R8300-DELETE-RESTART.                                            
           MOVE "R8300-DELETE-RESTART" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH          TO WS-PARNAME.                
           MOVE "ACQ_BATCH_RESTART "   TO WS-TBLNAME.
           MOVE "DELETE " TO WS-FUNCTION.                               

           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_DEL_01
                              (:WS-PROGRAM-NAME,   
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-CNTL-EFF-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL                                  
             MOVE "N" TO WS-RESTART-SW                                  
           ELSE                                                         
             IF SQLCODE EQUAL NOT-FOUND                                 
               GO TO R8300-EXIT                                         
             ELSE                                                       
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "BAD DELETE OF ACQ_BATCH_RESTART RESTART ROW" 
               DISPLAY "PROGRAM NAME: ", 
                     WS-PROGRAM-NAME 
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.
                                                                        
       R8300-EXIT. EXIT.                                                

      ***************************************************************   
      * R9100-INSERT-REPORT:                                        *   
      *     1. INSERT ACQ_BATCH_REPORT Oracle REPORT ROW            *
      ***************************************************************   
       R9100-INSERT-REPORT.                                             
           MOVE "R9100-INSERT-REPORT" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH         TO WS-PARNAME.                  
           MOVE "ACQ_BATCH_REPORTS"   TO WS-TBLNAME.
           MOVE "INSERT " TO WS-FUNCTION.                               
           MOVE REPORT-SORT-CRITERIA TO WS-SORT-DATA.                      
           MOVE REPORT-DATA          TO WS-REPORT-DATA.                      

           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_REPORTS_INS_01
                              (:REPORT-NUMBER,   
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-SORT-DATA,
                               :WS-REPORT-DATA,
                               :WS-CNTL-EFF-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL
             ADD 1 TO WS-DB-ROW-CTR
           ELSE  
             DISPLAY WS-DB-ERR-MSG
             DISPLAY "BAD INSERT ACQ_BATCH_REPORTS"
             DISPLAY "REPORT NUMBER: ", REPORT-NUMBER
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R9100-EXIT. EXIT.
       
      ***************************************************************
      * Y1500-SQL-PROCEDURE-ERROR                                   *
      *   1. PREPARE TO ABORT PROGRAM DUE TO SQL ERROR              *
      *   2. ROLLBACK ANY ORACLE UPDATES SINCE LAST COMMIT PERFORMD *
      ***************************************************************  
       Y1500-SQL-PROCEDURE-ERROR. 
                                                                        
           IF SQLCODE < 0                                               
               COMPUTE WS-ABEND-CODE = SQLCODE * -1                     
           ELSE                                                         
               MOVE SQLCODE TO WS-ABEND-CODE.                           
   
           DISPLAY "SQLCODE " WS-ABEND-CODE.
           DISPLAY "        " WS-ERROR-TEXT.                 
                                                                        
           EXEC SQL                                                     
               ROLLBACK                                                 
           END-EXEC.                                                    
                                                                        
           PERFORM Y2000-ABEND THRU Y2000-EXIT.                         
                                                                        
       Y1500-EXIT. EXIT.                                                

      ***************************************************************   
      * Y2000-ABEND:                                                *   
      *     1. CALL ABEND PROGRAM.                                  *   
      ***************************************************************   
       Y2000-ABEND.                                                     
                                                                        
           CALL "cobabend" USING PGMNAME, END-WORKING, WS-ABEND-AREA.
                                                                        
       Y2000-EXIT. EXIT.                                                

      ***************************************************************   
      * Z1000-CLOSE-FILES.                                          *   
      *     1. CLOSE ALL FILES.                                     *   
      ***************************************************************   
       Z1000-CLOSE-FILES.                                               
           MOVE "Z1000-CLOSE-FILES" TO WS-PARAGRAPH.                    
                                                                        
           CLOSE  CONTROL-PARMS                                         
                  TRANS-FILE                                            
                  CONTROL-REPORT
                  PARTS-FILE.                                       
                                                                        
       Z1000-EXIT. EXIT.
