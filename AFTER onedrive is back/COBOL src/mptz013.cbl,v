      ***************************************************************   
      * R4200-UPDATE-DX-SKEY:                                       * 
      *     RACE II - NEW ROUTINE                                   *
      *     REPLACES ROUTINES TO UPDATE CEGLINES                    *          
      *     UPDATES DETAIL-PART-XREF TABLE                          *   
      *     1. IF ANY ROWS WITH OLD PART SKEY ARE FOUND AND THE     *
      *        SUPERSESSION-MOD-FLAG = "Y":                         *
      *        UPDATE DETAIL-PART-XREF.PART_SKEY WITH THE SUPERSEDING* 
      *        PART SKEY AND SETS THE SUPERSESSION_MOD _FLAG TO 'N' *   
      *        ADD # OF LINES UPDATED (FOUND IN ROW-COUNT) TO UPDATE*
      *        COUNTERS. ADD REVERSED PARTS READ TO READ/LINE COUNTS*
      *     2. IF NONE FOUND, JUST CONTINUE                         *   
      *     3. PROCESS FOR VERSION TYPE "PR" OR "WP"                *
      *     4. PROCESS FOR PART SUPPLIER COUNTRY                    *
      *     5. INCREMENT COUNTERS FOR ASSCOIATED VERSION TYPE       *
      * NOTE: DO NOT REVERSE THOSE PARTS LINES THAT HAVE NOT BEEN   *
      *       IMPACTED BY A BATCH SUPERSESSON UPDATE.               *
      *                                                             *
      *      RACE II -THIS ROUTINE REPLACES R4000-COUNT-CEGLN       *
      *                                     R4200-UPDATE-CEGLINE-US *
      *                                     R4200-UPDATE-CEGLINE-CAN*
      *                                     R5000-COUNT-WIPLN       *
      *                                     R5200-UPDATE-WIPLINE-CAN*
      *                                     R5200-UPDATE-WIPLINE-US *
      ***************************************************************   
       R4200-UPDATE-DX-SKEY.                                         
           MOVE "R4200-UPDATE-DX-SKEY" TO WS-PARAGRAPH. 
           MOVE  WS-PARAGRAPH      TO WS-PARNAME.             
           MOVE "DETAIL-PART-XREF" TO WS-TBLNAME.
           MOVE "UPDATE "          TO WS-FUNCTION.   
           MOVE TR-NEW-PART-NUM    TO WS-CURRENT-PART.
           MOVE TR-OLD-PART-NUM    TO WS-SUPERSEDING-PART. 
      
           EXEC SQL EXECUTE                                             
           BEGIN                                                     
           PKG_SERVICE.P_DETAIL_PART_XREF_UPD_04
                                      (:WS-VERSION-TYPE,
                                       :WS-SEL-OEM-NUM, 
                                       :WS-SEL-REGN-CD,
                                       :WS-CURRENT-PART,
                                       :WS-SUPERSEDING-PART,
                                       :WS-ROW-COUNT,
                                       :WS-ERROR-TEXT,
                                       :WS-SQLCODE);
           END;                                                      
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.

           IF SQLCODE EQUAL SUCCESSFUL
              ADD WS-ROW-COUNT TO WS-DB-ROW-CTR 
              IF WS-VERSION-TYPE = "PR"
                ADD WS-ROW-COUNT  TO RS-CEGLN-UPDT-CTR
              END-IF
              IF WS-VERSION-TYPE = "WP"
                 ADD WS-ROW-COUNT  TO RS-WIPLN-UPDT-CTR
              END-IF
           ELSE 
              IF SQLCODE EQUAL NOT-FOUND
                 CONTINUE
              ELSE
                 DISPLAY WS-DB-ERR-MSG 
                 DISPLAY "BAD UPDATE DETAIL-PART-XREF PART-SKEY"
                 DISPLAY "OLD PART NUMBER: ", TR-OLD-PART-NUM
                 DISPLAY "NEW PART NUMBER: ",TR-NEW-PART-NUM 
                 DISPLAY "VERSION: ", WS-VERSION-TYPE                  
                 PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.
             
      ** THE FOLLOWING REPLACES R4000-COUNT-CEGLN AND R5000-COUNT-WIPLN
           IF SQLCODE EQUAL SUCCESSFUL AND 
              WS-ROW-COUNT > 0
              IF WS-VERSION-TYPE = "PR"
                 ADD WS-ROW-COUNT TO RS-NEW-CEG-LCTR,
                                      RS-CEGLN-READ-CTR
                 ADD 1 TO RS-NEW-CEG-PCTR
              ELSE
              IF WS-VERSION-TYPE = "WP"
                 ADD WS-ROW-COUNT TO RS-NEW-WIP-LCTR,
                                     RS-WIPLN-READ-CTR
                 ADD 1 TO RS-NEW-WIP-PCTR.
              
       R4200-EXIT. EXIT.                                                

