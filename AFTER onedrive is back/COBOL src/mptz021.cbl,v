      *     3. FOR SUPERSESSIONS (ALL TYPES), CHECK PART #'S        *
      *     4. CHECK TRANSACTION TYPE AND PERFORM ASSOC. SPLIT RTN  *
      ***************************************************************
       B0000-READ-TRANS.

           MOVE "B0000-READ-TRANS" TO WS-PARAGRAPH.

           READ TRANS-FILE INTO WS-TRANS-REC
             AT END
                MOVE "E" TO WS-PROCESS-SW.

           IF END-OF-TRANSFILE
             IF WS-TRANS-READ-CTR EQUAL 0
               DISPLAY WS-ERR-MSG-TR2
               MOVE V-EMPTY-INPUT-FILE TO WS-ABEND-CODE
               PERFORM Y2000-ABEND THRU Y2000-EXIT
             ELSE
               MOVE SPACES TO TR-TRANS-CODE
               MOVE SPACES TO TR-SUPR-EFF-DT
               MOVE HIGH-VALUES TO TR-OLD-PART-NUM
           ELSE
             ADD 1 TO WS-TRANS-READ-CTR
             IF TR-TRANS-CODE EQUAL "A"
               ADD 1 TO WS-A-READ-CTR
             ELSE
               IF TR-TRANS-CODE EQUAL "C"
                 ADD 1 TO WS-C-READ-CTR
               ELSE
                 IF TR-TRANS-CODE EQUAL "N"
                   ADD 1 TO WS-N-READ-CTR
                 ELSE
                   IF TR-TRANS-CODE EQUAL "D"
                     ADD 1 TO WS-D-READ-CTR
                   ELSE
                     IF TR-TRANS-CODE EQUAL "P"
                       ADD 1 TO WS-P-READ-CTR
                     ELSE
                       ADD 1 TO WS-INVAL-READ-CTR
                       MOVE WS-ERR-MSG-TR1 TO WS-ERR-RPT-MSG
                       PERFORM W1000-TRANS-ERROR THRU W1000-EXIT
                       GO TO B0000-EXIT.

           IF NOT-END-OF-TRANSFILE
             PERFORM I0000-VALIDATE-PARTS THRU I0000-EXIT
             IF ERROR-FOUND
               MOVE SPACES TO WS-ERROR-SW
               PERFORM W1000-TRANS-ERROR THRU W1000-EXIT
               GO TO B0000-EXIT.

           IF TR-TRANS-CODE EQUAL "N"
             PERFORM C0000-SUPERSESSION-REC THRU C0000-EXIT
             GO TO B0000-EXIT.

           IF TRANS-FILE-WRK-STG
             IF SAV-OLD-PART-NUM EQUAL WS-A-PART-NUM
               MOVE "A" TO SAV-TRANS-CODE
               PERFORM H1000-WRITE-A-REC THRU H1000-EXIT
             ELSE
               PERFORM H4000-WRITE-N-REC THRU H4000-EXIT.

           IF END-OF-TRANSFILE
             GO TO B0000-EXIT.

           MOVE "N" TO WS-TRANS-SW.

           IF TR-TRANS-CODE EQUAL "A"
             MOVE WS-TRANS-REC TO SAV-TRANS-REC
             PERFORM H1000-WRITE-A-REC THRU H1000-EXIT
           ELSE
             IF TR-TRANS-CODE EQUAL "C"
               PERFORM H2000-WRITE-C-REC THRU H2000-EXIT
           ELSE
             IF TR-TRANS-CODE EQUAL "D"
               PERFORM H3000-WRITE-D-REC THRU H3000-EXIT
           ELSE
