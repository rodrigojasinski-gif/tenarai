           ELSE
             IF SAV-OLD-PART-NUM EQUAL WS-A-PART-NUM
               MOVE "A" TO SAV-TRANS-CODE
               PERFORM H1000-WRITE-A-REC THRU H1000-EXIT
             ELSE
               PERFORM H4000-WRITE-N-REC THRU H4000-EXIT.

           MOVE WS-TRANS-REC TO SAV-TRANS-REC.
           MOVE "Y" TO WS-TRANS-SW.

       C0000-EXIT. EXIT.

      ***************************************************************
      * D0000-PRICE-REC:                                            *
      *     1. ADD 1 TO READ COUNTER                                *
      *     2. CHECK IF DUPLICATE PRICE REC (SAME PART NUMBER)      *
      *        IF SO, REPORT AS ERROR                               *
      *        IF NOT, WRITE AS VALID P TRANSACTION                 *
      *     3. CHECK IF 20 PART NUMBERS HAVE ALREADY BEEN VERIFIED  *
      *     4. VERIFY VARIANCE BETWEEN NEW VERSUS DATABASE PRICE    *
      *     5. PERFORM WRITE ROUTINE                                *
      ***************************************************************
       D0000-PRICE-REC.

           MOVE "D0000-PRICE-REC" TO WS-PARAGRAPH.

           IF TR-OLD-PART-NUM EQUAL WS-P-PART-NUM
             MOVE WS-ERR-MSG-TR13 TO WS-ERR-RPT-MSG
             PERFORM W1000-TRANS-ERROR THRU W1000-EXIT
             GO TO D0000-EXIT.

           PERFORM H5000-WRITE-P-REC THRU H5000-EXIT.
           MOVE TR-OLD-PART-NUM TO WS-P-PART-NUM.

           IF WS-PARTS-READ-CTR EQUAL TWENTY
             GO TO D0000-EXIT.

           PERFORM R2000-READ-PART THRU R2000-EXIT.
           IF NOT-PRICED-PART
             GO TO D0000-EXIT.

           MOVE TR-PRICE-XX       TO WS-PRICE-XX.
           SUBTRACT WS-TEMP-PRICE-AMT FROM WS-PRICE
                    GIVING WS-CALC-VAR-AMT.
             COMPUTE WS-CALC-VAR-PCT ROUNDED =
                     (WS-CALC-VAR-AMT / WS-TEMP-PRICE-AMT) * 100.

           IF (WS-CALC-VAR-PCT > PLUS-NINETY-PCT) OR
              (WS-CALC-VAR-PCT < MINUS-NINETY-PCT)
             ADD 1 TO WS-VARIANCE-CTR.

       D0000-EXIT. EXIT.

      ***************************************************************
      * H1000-WRITE-A-REC:                                          *
      *     1. WRITE SAV-TRANS-REC TO ASSEMBLY TRANS FILE           *
      *     2. ADD 1 TO WRITE COUNTER                               *
      *     3. STORE PART-NUM THAT WAS WRITTEN                      *
      ***************************************************************
       H1000-WRITE-A-REC.

           MOVE "H1000-WRITE-A-REC" TO WS-PARAGRAPH.

           MOVE SAV-TRANS-REC TO A-TRANS-REC.
           WRITE A-TRANS-REC.
           ADD 1 TO WS-A-WRITTEN-CTR.
           MOVE SAV-OLD-PART-NUM TO WS-A-PART-NUM.

       H1000-EXIT. EXIT.

      ***************************************************************
      * H2000-WRITE-C-REC:                                          *
      *     1. WRITE TRANS-REC TO COMPONENT TRANS FILE              *
      *     2. ADD 1 TO WRITE COUNTER                               *
      ***************************************************************
       H2000-WRITE-C-REC.

           MOVE "H2000-WRITE-C-REC" TO WS-PARAGRAPH.

           MOVE WS-TRANS-REC TO C-TRANS-REC.
           WRITE C-TRANS-REC.
           ADD 1 TO WS-C-WRITTEN-CTR.

       H2000-EXIT. EXIT.

      ***************************************************************
      * H3000-WRITE-D-REC:                                          *
      *     1. WRITE TRANS-REC TO DISCONTINUE TRANS FILE            *
      *     2. ADD 1 TO WRITE COUNTER                               *
      ***************************************************************
       H3000-WRITE-D-REC.

           MOVE "H3000-WRITE-D-REC" TO WS-PARAGRAPH.

           MOVE WS-TRANS-REC TO D-TRANS-REC.
           WRITE D-TRANS-REC.
           ADD 1 TO WS-D-WRITTEN-CTR.

       H3000-EXIT. EXIT.

      ***************************************************************
      * H4000-WRITE-N-REC:                                          *
      *     1. WRITE SAV-TRANS-REC TO SUPERSESSION TRANS FILE       *
      *     2. ADD 1 TO WRITE COUNTER                               *
      ***************************************************************
       H4000-WRITE-N-REC.

           MOVE "H4000-WRITE-N-REC" TO WS-PARAGRAPH.

           MOVE SAV-TRANS-REC TO N-TRANS-REC.
           WRITE N-TRANS-REC.
           ADD 1 TO WS-N-WRITTEN-CTR.

       H4000-EXIT. EXIT.

      ***************************************************************
      * H5000-WRITE-P-REC:                                          *
      *     1. WRITE TRANS-REC TO PRICE TRANS FILE                  *
      *     2. ADD 1 TO WRITE COUNTER                               *
      ***************************************************************
       H5000-WRITE-P-REC.

           MOVE "H5000-WRITE-P-REC" TO WS-PARAGRAPH.

           MOVE WS-TRANS-REC TO P-TRANS-REC.
           WRITE P-TRANS-REC.
           ADD 1 TO WS-P-WRITTEN-CTR.

       H5000-EXIT. EXIT.

      ***************************************************************
      * I0000-VALIDATE-PARTS.                                       *
      *     1. CHECK OLD AND NEW PART NUMBERS                       *
      ***************************************************************
       I0000-VALIDATE-PARTS.

           MOVE "I0000-VALIDATE-PARTS" TO WS-PARAGRAPH.

           IF TR-OLD-PART-NUM EQUAL ZEROES OR SPACES
             MOVE WS-ERR-MSG-TR6 TO WS-ERR-RPT-MSG
             MOVE "Y" TO WS-ERROR-SW
             GO TO I0000-EXIT.

           MOVE TR-OLD-PART-NUM TO WORK-PART-NUM.
           PERFORM I0100-CHECK-ZERO-OR-ALPHA THRU I0100-EXIT.
           IF ERROR-FOUND
             MOVE WS-ERR-MSG-TR6 TO WS-ERR-RPT-MSG
             GO TO I0000-EXIT.

           IF TR-TRANS-CODE EQUAL "D" OR "P"
             GO TO I0000-EXIT.

           IF TR-NEW-PART-NUM EQUAL ZEROES OR SPACES
             MOVE WS-ERR-MSG-TR7 TO WS-ERR-RPT-MSG
             MOVE "Y" TO WS-ERROR-SW
             GO TO I0000-EXIT.

           IF TR-NEW-PART-NUM EQUAL DISCON
             MOVE WS-ERR-MSG-TR7 TO WS-ERR-RPT-MSG
             MOVE "Y" TO WS-ERROR-SW
             GO TO I0000-EXIT.

           MOVE TR-NEW-PART-NUM TO WORK-PART-NUM.
           PERFORM I0100-CHECK-ZERO-OR-ALPHA THRU I0100-EXIT.
           IF ERROR-FOUND
             MOVE WS-ERR-MSG-TR7 TO WS-ERR-RPT-MSG
             GO TO I0000-EXIT.

           IF TR-NEW-PART-NUM EQUAL TR-OLD-PART-NUM
             MOVE WS-ERR-MSG-TR8 TO WS-ERR-RPT-MSG
             MOVE "Y" TO WS-ERROR-SW
             GO TO I0000-EXIT.

       I0000-EXIT. EXIT.

      ***************************************************************
      * I0100-CHECK-ZERO-OR-ALPHA.                                  *
      *     CHECK FOR PART NUMBER "0" AND ALPHANUMERIC PART         *
      *     (PRICING UPDATE PROGRAM ABENDS DURING PART RECORD       *
      *      INSERT IF PART NUMBER CONTAINS NO VALID ALPHANUMERIC   *
      *      CHARACTERS - ATTEMPTS TO INSERT NULL INTO              *
      *      COMPRESSED-PART-NUMBER FIELD.)                         *
      ***************************************************************
       I0100-CHECK-ZERO-OR-ALPHA.

           MOVE "I0100-CHECK-ZERO-OR-ALPHA" TO WS-PARAGRAPH.

           EXEC SQL EXECUTE
             BEGIN
               SP_COMP_PART(:WORK-PART-NUM,:COMP-PART-NUM);
             END;
           END-EXEC.

           IF COMP-PART-NUM EQUAL SPACES OR
              COMP-PART-NUM = "0"
             MOVE "Y" TO WS-ERROR-SW.

       I0100-EXIT. EXIT.

      ***************************************************************
      * R1000-READ-OEM:                                             *
      *     1. READ PART_SUPPLIER_COUNTRY TABLE                     *
      ***************************************************************
       R1000-READ-OEM.

           MOVE "R1000-READ-OEM"        TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH           TO WS-PARNAME.
           MOVE "PART_SUPPLIER_COUNTRY" TO WS-TBLNAME.
           MOVE "SELECT    "            TO WS-FUNCTION.

           MOVE WS-SEL-OEM-NUM-CNTL TO WS-PART-SUPPLIER-NUMBER.
           MOVE WS-SEL-REGN-CD      TO WS-PART-SUPPLIER-COUNTRY-ABBR.

           EXEC SQL EXECUTE
             BEGIN
              PKG_SUPPLIER.P_PART_SUPLRCNTRY_SUPLR_SEL_01
                              (:WS-PART-SUPPLIER-NUMBER,
                               :WS-REGN-LIT-X,
                               :WS-PART-SUPPLIER-COUNTRY-ABBR,
                               :WS-PART-SUPPLIER-NUMBER-OUT,
                               :WS-PART-SUPPLIER-NAME-RGN,
                               :WS-PART-SUPPLIER-NAME,
                               :WS-LAST-ASSY-DATE,
                               :WS-LAST-ASSY-IND,
                               :WS-LAST-COMPONENT-DATE,
                               :WS-LAST-COMPONENT-IND,
                               :WS-LAST-SUPERSESSION-DATE,
                               :WS-LAST-SUPER-IND,
                               :WS-LAST-DISCONTINUED-DATE,
                               :WS-LAST-DISC-IND,
                               :WS-LAST-PRICE-DATE,
                               :WS-LAST-PRICE-IND,
                               :WS-DISCONTINUED-TRAN-FLAG,
                               :WS-DISCONTINUED-MONTHLY-COUNT,
                               :WS-PART-COUNT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.

           IF SQLCODE EQUAL SUCCESSFUL
             MOVE "Y" TO WS-OEM-SW
      * Holding fields for pkg_supplier.p_part_suplrcntry_suplr_sel_01 values
      * Used in Electronic Balancing Logic.
             MOVE WS-LAST-PRICE-DATE TO WS-LAST-PRICE-DATE-HOLD
             MOVE WS-LAST-PRICE-IND  TO WS-LAST-PRICE-IND-HOLD
           ELSE
            IF SQLCODE EQUAL NOT-FOUND
              MOVE "N" TO WS-OEM-SW
            ELSE
              DISPLAY WS-DB-ERR-MSG
              PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R1000-EXIT. EXIT.

      ***************************************************************
      * R2000-READ-PART:                                            *
      *     1. READ PART PART ROW FOR PRICE                         *
      ***************************************************************
       R2000-READ-PART.

           MOVE "R2000-READ-PART" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH     TO WS-PARNAME.
           MOVE "PART           " TO WS-TBLNAME.
           MOVE "SELECT    "      TO WS-FUNCTION.

           MOVE WS-SEL-OEM-NUM-CNTL TO WS-PART-SUPPLIER-NUMBER.
           MOVE WS-SEL-REGN-CD      TO WS-PART-SUPPLIER-COUNTRY-ABBR.
           MOVE TR-OLD-PART-NUM     TO WS-PART-NUMBER.

           EXEC SQL EXECUTE
            BEGIN
            PKG_PART.P_PART_SEL_01
                              (:WS-PART-SUPPLIER-NUMBER,
                               :WS-PART-SUPPLIER-COUNTRY-ABBR,
                               :WS-PART-NUMBER,
                               :WS-PART-NUMBER-OUT,
                               :WS-LAST-PRICE-DATE,
                               :WS-LAST-PRICE-IND,
                               :WS-CURRENT-PRICE,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.
           MOVE WS-SQLCODE TO SQLCODE.

           IF SQLCODE EQUAL NOT-FOUND
               MOVE "N" TO WS-PRICE-SW
               GO TO R2000-EXIT.

           IF SQLCODE NOT EQUAL SUCCESSFUL
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "PART NUMBER: " WS-PART-NUMBER
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

           IF WS-CURRENT-PRICE NOT EQUAL ZEROES
               MOVE WS-CURRENT-PRICE TO WS-TEMP-PRICE-AMT
               MOVE "Y" TO WS-PRICE-SW
               ADD 1    TO WS-PARTS-READ-CTR
               GO TO R2000-EXIT
           ELSE
               MOVE "N" TO WS-PRICE-SW.

       R2000-EXIT. EXIT.

       R3000-READ-MEDIA-HEADER-TBL.
      ****************************************************************
      * R3000-READ-MEDIA-HEADER-TBL:                                 *
      *     1.  READ MEDIA-HEADER RECORD AND COMPARE THE EFFECTIVE DT*
      ****************************************************************
           MOVE "R3000-READ-MEDIA-HEADER-TBL" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH                 TO WS-PARNAME.
           MOVE "ACQ_MEDIA_HEADER           " TO WS-TBLNAME.
           MOVE "READ      "                  TO WS-FUNCTION.

           EXEC SQL EXECUTE
             BEGIN
              PKG_APPLICATION.P_ACQ_MEDIA_HEADER_SEL_01
                              (:WS-PART-SUPPLIER-NUMBER,
