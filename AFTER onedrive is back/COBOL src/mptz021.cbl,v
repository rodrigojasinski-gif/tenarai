                 DISPLAY "PART-SUPPLIER-NUMBER : "
                    WS-PART-SUPPLIER-NUMBER
                 DISPLAY "PART-SUPPLIER-COUNTRY: "
                    WS-PART-SUPPLIER-COUNTRY-ABBR
                 DISPLAY "EFFECTIVE-DATE  : " WS-CURRENT-EFFECTIVE-DATE
                 DISPLAY "REPLACEMENT IND : " WS-REPLACEMENT-FLAG
                 PERFORM Y2000-ABEND THRU Y2000-EXIT
              ELSE
                 DISPLAY WS-DB-ERR-MSG
                 DISPLAY "PART-SUPPLIER-NUMBER : "
                    WS-PART-SUPPLIER-NUMBER
                 DISPLAY "PART-SUPPLIER-COUNTRY: "
                    WS-PART-SUPPLIER-COUNTRY-ABBR
                 DISPLAY "EFFECTIVE-DATE  : " WS-CURRENT-EFFECTIVE-DATE
                 DISPLAY "REPLACEMENT IND : " WS-REPLACEMENT-FLAG
                 PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R3000-EXIT.  EXIT.

      ****************************************************************
      * R9000-READ-REPORT:                                           *
      *     1. READ ACQ_BATCH_REPORTS Oracle REPORT ROW (TO SEE IF   *
      *        IT EXISTS FROM PREV RUN, IN THE EVENT THIS IS A RERUN)*
      ****************************************************************
       R9000-READ-REPORT.
           MOVE "R9000-READ-REPORT" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH       TO WS-PARNAME.
           MOVE "ACQ_BATCH_REPORTS" TO WS-TBLNAME.
           MOVE "SELECT    "        TO WS-FUNCTION.

           MOVE REPORT-NUMBER       TO WS-REPORT-NUMBER.
           MOVE WS-SEL-OEM-NUM-CNTL TO WS-PART-SUPPLIER-NUMBER.
           MOVE WS-SEL-REGN-CD      TO WS-PART-SUPPLIER-COUNTRY-ABBR.

           EXEC SQL EXECUTE
             BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_REPORTS_SEL_01
                              (:WS-REPORT-NUMBER,
                               :WS-PART-SUPPLIER-NUMBER,
                               :WS-PART-SUPPLIER-COUNTRY-ABBR,
                               :WS-CURRENT-EFFECTIVE-DATE,
                               :WS-REPORT-DATA,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.

           IF SQLCODE EQUAL SUCCESSFUL
             MOVE "Y" TO WS-REPORT-SW
           ELSE
             IF SQLCODE EQUAL NOT-FOUND
               MOVE "N" TO WS-REPORT-SW
             ELSE
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "PART-SUPPLIER-NUMBER : " WS-PART-SUPPLIER-NUMBER
               DISPLAY "PART-SUPPLIER-COUNTRY: "
                     WS-PART-SUPPLIER-COUNTRY-ABBR
               DISPLAY "EFFECTIVE-DATE  : " WS-CURRENT-EFFECTIVE-DATE
               DISPLAY "RPT NUM: " WS-REPORT-NUMBER
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R9000-EXIT. EXIT.

      ***************************************************************
      * R9100-INSERT-REPORT:                                        *
      *     1. INSERT ACQ_BATCH_REPORTS Oracle REPORT ROW           *
      ***************************************************************
       R9100-INSERT-REPORT.

           MOVE "R9100-INSERT-REPORT" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH         TO WS-PARNAME.
           MOVE "ACQ_BATCH_REPORTS"   TO WS-TBLNAME.
           MOVE "INSERT    "          TO WS-FUNCTION.

           MOVE REPORT-NUMBER       TO WS-REPORT-NUMBER.
           MOVE WS-SEL-OEM-NUM-CNTL TO WS-PART-SUPPLIER-NUMBER.
           MOVE WS-SEL-REGN-CD      TO WS-PART-SUPPLIER-COUNTRY-ABBR.
           MOVE SORT-DATA           TO WS-SORT-DATA.
           MOVE REPORT-DATA         TO WS-REPORT-DATA.

           EXEC SQL EXECUTE
             BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_REPORTS_INS_01
                              (:WS-REPORT-NUMBER,
