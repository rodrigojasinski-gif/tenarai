           ELSE
             DISPLAY WS-DB-ERR-MSG
             DISPLAY "PART-SUPPLIER-NUMBER : " WS-PART-SUPPLIER-NUMBER
             DISPLAY "PART-SUPPLIER-COUNTRY: "
                   WS-PART-SUPPLIER-COUNTRY-ABBR
             DISPLAY "EFFECTIVE-DATE  : " WS-CURRENT-EFFECTIVE-DATE
             DISPLAY "RPT NUM: " WS-REPORT-NUMBER
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R9100-EXIT. EXIT.

      ***************************************************************
      * R9200-UPDATE-REPORT:                                        *
      *     1. UPDATE ACQ_BATCH_REPORTS Oracle REPORT ROW           *
      ***************************************************************
       R9200-UPDATE-REPORT.

           MOVE "R9200-UPDATE-REPORT" TO WS-PARAGRAPH.
           MOVE  WS-PARAGRAPH         TO WS-PARNAME.
           MOVE "ACQ_BATCH_REPORTS"   TO WS-TBLNAME.
           MOVE "UPDATE    "          TO WS-FUNCTION.

           MOVE REPORT-NUMBER       TO WS-REPORT-NUMBER.
           MOVE WS-SEL-OEM-NUM-CNTL TO WS-PART-SUPPLIER-NUMBER.
           MOVE WS-SEL-REGN-CD      TO WS-PART-SUPPLIER-COUNTRY-ABBR.
           MOVE REPORT-DATA         TO WS-REPORT-DATA.
           MOVE SORT-DATA           TO WS-SORT-DATA.

           EXEC SQL EXECUTE
             BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_REPORTS_UPD_01
                              (:WS-REPORT-NUMBER,
                               :WS-PART-SUPPLIER-NUMBER,
                               :WS-PART-SUPPLIER-COUNTRY-ABBR,
                               :WS-SORT-DATA,
                               :WS-REPORT-DATA,
                               :WS-CURRENT-EFFECTIVE-DATE,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.

           IF SQLCODE EQUAL SUCCESSFUL
             GO TO R9200-EXIT
           ELSE
             DISPLAY WS-DB-ERR-MSG
             DISPLAY "PART-SUPPLIER-NUMBER : " WS-PART-SUPPLIER-NUMBER
             DISPLAY "PART-SUPPLIER-COUNTRY: "
                   WS-PART-SUPPLIER-COUNTRY-ABBR
             DISPLAY "EFFECTIVE-DATE  : " WS-CURRENT-EFFECTIVE-DATE
             DISPLAY "RPT NUM: " WS-REPORT-NUMBER
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R9200-EXIT. EXIT.

      ***************************************************************
      * W1000-TRANS-ERROR:                                          *
      *     1. WRITE TRANSACTION RECORD TO ERROR REPORT.            *
      *     2. ADD 1 TO ERROR COUNTER.                              *
      ***************************************************************
       W1000-TRANS-ERROR.

           MOVE "W1000-TRANS-ERROR" TO WS-PARAGRAPH.

           IF WS-LINE-CTR > 55 OR WS-LINE-CTR = +0
             ADD  1 TO WS-PAGE-CTR
             MOVE WS-PAGE-CTR TO HDG-PAGE
             MOVE 1 TO HDG-RPTNUM, EOR-RPTNUM
             WRITE REPORT-LINE FROM HEADING1 AFTER PAGE
             MOVE ERROR-HEADING TO HDG-TITLE
             WRITE REPORT-LINE FROM HEADING2 AFTER 1 LINE
             WRITE REPORT-LINE FROM HEADING3 AFTER 2 LINE
             WRITE REPORT-LINE FROM WS-ERR-SUBHEAD1 AFTER 2 LINES
             WRITE REPORT-LINE FROM WS-ERR-SUBHEAD2 AFTER 1 LINE
             MOVE 7 TO WS-LINE-CTR.

           MOVE WS-TRANS-READ-CTR TO WS-ERR-REC-NUM.
           MOVE WS-TRANS-REC      TO WS-ERR-TRANS-REC.
           WRITE REPORT-LINE FROM WS-ERR-DETAIL AFTER 1 LINE.
           ADD 1 TO WS-LINE-CTR.

           ADD 1 TO WS-INVAL-WRITTEN-CTR.

       W1000-EXIT. EXIT.

      ***************************************************************
      * W2000-CONTROL-REPORT:                                       *
      *     1. DETERMINE IF ERROR REPORT WAS WRITTEN.               *
      *     2. IF SO, PRODUCE END-OF-REPORT PAGE FOR THAT REPORT.   *
      *     3. WRITE CONTROL REPORT.                                *
      *     4. PRODUCE END-OF-REPORT PAGE FOR CONTROL REPORT.       *
      *     5. WRITE CONTROL-TOTAL ROW TO Oracle REPORT TABLE (FOR  *
      *        USE IN BALANCING DURING THE UPDATE PROGRAMS).        *
      ***************************************************************
       W2000-CONTROL-REPORT.

           MOVE "W2000-CONTROL-REPORT" TO WS-PARAGRAPH.

           IF WS-PAGE-CTR NOT EQUAL 0
             ADD 1 TO WS-PAGE-CTR
             MOVE WS-PAGE-CTR TO HDG-PAGE
             WRITE REPORT-LINE FROM HEADING1 AFTER PAGE
             MOVE ERROR-HEADING TO HDG-TITLE
             WRITE REPORT-LINE FROM HEADING2 AFTER 1 LINE
             WRITE REPORT-LINE FROM HEADING3 AFTER 2 LINE
             WRITE REPORT-LINE FROM EOR-NOTE AFTER 15 LINES.

           MOVE 1 TO HDG-PAGE.
           MOVE 2 TO HDG-RPTNUM, EOR-RPTNUM.
           WRITE REPORT-LINE FROM HEADING1 AFTER PAGE.
           MOVE CONTROL-HEADING TO HDG-TITLE.
           WRITE REPORT-LINE FROM HEADING2 AFTER 1 LINE.
           WRITE REPORT-LINE FROM HEADING3 AFTER 2 LINE.
           WRITE REPORT-LINE FROM WS-RPT-SUBHEAD1 AFTER 2 LINES.
           WRITE REPORT-LINE FROM WS-RPT-SUBHEAD2 AFTER 1 LINE.

           MOVE DETAIL-A TO WS-RPT-TRANS-DESC.
           MOVE WS-A-READ-CTR    TO WS-RPT-READ-AMT.
           MOVE WS-A-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           MOVE DETAIL-C TO WS-RPT-TRANS-DESC.
           MOVE WS-C-READ-CTR    TO WS-RPT-READ-AMT.
           MOVE WS-C-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           MOVE DETAIL-N         TO WS-RPT-TRANS-DESC.
           MOVE WS-N-READ-CTR    TO WS-RPT-READ-AMT.
           MOVE WS-N-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           MOVE DETAIL-D TO WS-RPT-TRANS-DESC.
           MOVE WS-D-READ-CTR    TO WS-RPT-READ-AMT.
           MOVE WS-D-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           MOVE DETAIL-P TO WS-RPT-TRANS-DESC.
           MOVE WS-P-READ-CTR    TO WS-RPT-READ-AMT.
           MOVE WS-P-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           MOVE DETAIL-I TO WS-RPT-TRANS-DESC.
           MOVE WS-INVAL-READ-CTR    TO WS-RPT-READ-AMT.
           MOVE WS-INVAL-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           WRITE REPORT-LINE FROM WS-RPT-SUBHEAD2 AFTER 1 LINE.

           ADD WS-A-WRITTEN-CTR, WS-C-WRITTEN-CTR,
               WS-N-WRITTEN-CTR, WS-D-WRITTEN-CTR,
               WS-P-WRITTEN-CTR, WS-INVAL-WRITTEN-CTR
               GIVING WS-TRANS-WRITTEN-CTR.

           MOVE DETAIL-T TO WS-RPT-TRANS-DESC.
           MOVE WS-TRANS-READ-CTR TO WS-RPT-READ-AMT.
           MOVE WS-TRANS-WRITTEN-CTR TO WS-RPT-WRITE-AMT.
           WRITE REPORT-LINE FROM WS-RPT-DETAIL AFTER 1 LINE.

           MOVE WS-PARTS-READ-CTR TO WS-RPT-PRICE-RECS.
           WRITE REPORT-LINE FROM WS-RPT-NOTE1 AFTER 5 LINES.
           MOVE WS-VARIANCE-CTR TO WS-RPT-VARIANCE-CTR.
           WRITE REPORT-LINE FROM WS-RPT-NOTE2 AFTER 1 LINE.

           MOVE 2 TO HDG-PAGE.
           WRITE REPORT-LINE FROM HEADING1 AFTER PAGE.
           MOVE CONTROL-HEADING TO HDG-TITLE.
           WRITE REPORT-LINE FROM HEADING2 AFTER 1 LINE.
           WRITE REPORT-LINE FROM HEADING3 AFTER 2 LINE.
