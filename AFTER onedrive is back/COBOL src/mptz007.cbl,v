           IF SRT4-TRANS-TYPE = "D"
             IF SRT4-REC-TYPE-CTR = 1
               MOVE DISC-ACTVY-1 TO RPT04-UPDT-ACTVY
             ELSE
               IF SRT4-REC-TYPE-CTR = 2
                 MOVE DISC-ACTVY-2 TO RPT04-UPDT-ACTVY
               ELSE
