           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "ACQ_BATCH_REPORTS" TO WS-TBLNAME.
           MOVE "INSERT " TO WS-FUNCTION.
           MOVE REPORT-SORT-CRITERIA TO SORT-DATA.
           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_REPORTS_INS_01
                              (:REPORT-NUMBER,
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :SORT-DATA,
                               :REPORT-DATA,
                               :WS-TEMP-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL
             ADD WS-ROW-COUNT TO WS-DB-ROW-CTR
           ELSE
             DISPLAY WS-DB-ERR-MSG
             DISPLAY "BAD INSERT ACQ_BATCH_REPORTS"
             DISPLAY "REPORT NUMBER: ", REPORT-NUMBER
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R9100-EXIT. EXIT.

      ***************************************************************
      * Y1000-SQL-ERROR:                                            *
      *     1. PREPARE TO ABORT PROGRAM DUE TO SQL ERROR            *
      *     2. ROLLBACK ANY Oracle UPDATES SINCE LAST COMMIT PERFORMED *
      ***************************************************************
       Y1000-SQL-ERROR.

           IF SQLCODE < 0
               COMPUTE WS-ABEND-CODE = SQLCODE * -1
           ELSE
               MOVE SQLCODE TO WS-ABEND-CODE.

           CALL "dberrmsg" USING SQLCA ERROR-MESSAGE ERROR-LENGTH.
           IF RETURN-CODE = 0
               DISPLAY ERROR-TEXT (1)
               DISPLAY ERROR-TEXT (2)
               DISPLAY ERROR-TEXT (3)
               DISPLAY ERROR-TEXT (4)
               DISPLAY ERROR-TEXT (5)
               DISPLAY ERROR-TEXT (6)
               DISPLAY ERROR-TEXT (7)
               DISPLAY ERROR-TEXT (8)
           ELSE
               DISPLAY "ERROR OCCURRED DURING MESSAGE RTN"
               DISPLAY "RETURN CODE = " SQLCODE.

           EXEC SQL
               ROLLBACK
           END-EXEC.

           PERFORM Y2000-ABEND THRU Y2000-EXIT.

       Y1000-EXIT. EXIT.
      ***************************************************************
      * Y1500-SQL-PROCEDURE-ERROR                                   *
      *   1. PREPARE TO ABORT PROGRAM DUE TO SQL ERROR              *
      *   2. ROLLBACK ANY ORACLE UPDATES SINCE LAST COMMIT PERFORMD *
      ***************************************************************
       Y1500-SQL-PROCEDURE-ERROR.

           IF SQLCODE < 0
               COMPUTE WS-ABEND-CODE = SQLCODE * -1
           ELSE
               MOVE SQLCODE TO WS-ABEND-CODE.

           DISPLAY "SQLCODE " WS-ABEND-CODE.
           DISPLAY "        " WS-ERROR-TEXT.
           MOVE WS-PARAGRAPH TO WS-PARNAME.

           PERFORM Y2000-ABEND THRU Y2000-EXIT.

       Y1500-EXIT. EXIT.



      ***************************************************************
      * Y2000-ABEND:                                                *
      *     1. CALL ABEND PROGRAM.                                  *
      ***************************************************************
       Y2000-ABEND.

           CALL "cobabend" USING PGMNAME, END-WORKING, WS-ABEND-AREA.

       Y2000-EXIT. EXIT.

      ***************************************************************
      * Z1000-CLOSE-FILES.                                          *
      *     1. CLOSE ALL FILES.                                     *
      ***************************************************************
       Z1000-CLOSE-FILES.
           MOVE "Z1000-CLOSE-FILES" TO WS-PARAGRAPH.

           CLOSE  CONTROL-PARMS
                  TRANS-FILE
                  CONTROL-REPORT.

       Z1000-EXIT. EXIT.

      ***************************************************************
      * Z2000-BALANCE:                                              *
      *     1. CHECK INPUT EQUALS OUTPUT                            *
      ***************************************************************
       Z2000-BALANCE.
           MOVE "Z2000-BALANCE" TO WS-PARAGRAPH.

           PERFORM R9000-READ-REPORT THRU R9000-EXIT.
           MOVE WS-REPORT-DATA TO BALANCE-INFO-00.

           IF RS-TRANS-READ-CTR NOT EQUAL RPT00-TRANS-N-CTR
             IF RS-TRANS-READ-CTR EQUAL ZERO
               DISPLAY WS-ERR-MSG-TR2
               MOVE V-EMPTY-INPUT-FILE TO WS-ABEND-CODE
               PERFORM Y2000-ABEND THRU Y2000-EXIT
             ELSE
               DISPLAY WS-ERR-MSG-TR4
               DISPLAY "RS-TRANS-READ-CTR = " RS-TRANS-READ-CTR
               DISPLAY "RPT00-TRANS-N-CTR = " RPT00-TRANS-N-CTR
               MOVE V-OUT-OF-BALANCE-AT-EOP TO WS-ABEND-CODE
               PERFORM Y2000-ABEND THRU Y2000-EXIT
           ELSE
             IF RS-TRANS-READ-CTR > 0
               PERFORM R1200-UPDATE-OEM THRU R1200-EXIT.

       Z2000-EXIT. EXIT.
