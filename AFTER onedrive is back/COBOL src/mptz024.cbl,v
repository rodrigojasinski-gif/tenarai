             ELSE
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "BAD SELECT SUPER EFF DATE"
               DISPLAY "OLD PART NUMBER: ", TR-OLD-PART-NUM
               DISPLAY "NEW PART NUMBER: ", TR-NEW-PART-NUM
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R3000-EXIT. EXIT.

      ***************************************************************
      * R3010-READ-SUPER-BY-OLD:                                    *
      *     1. READ SUPERSESSION ROW BY TRANS OLD PART TO DETERMINE *
      *        IF TRANS OLD PART HAS PRIOR SUPERSEDED TO ANYTHING.  *
      ***************************************************************
       R3010-READ-SUPER-BY-OLD.
           MOVE "R3010-READ-SUPER-BY-OLD" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "SUPERSESSION" TO WS-TBLNAME.
           MOVE "SELECT " TO WS-FUNCTION.

           EXEC SQL EXECUTE
           BEGIN
            PKG_SUPERSESSION.P_SUPERSESSION_SEL_02
                (:WS-SEL-OEM-NUM,
                 :WS-SEL-REGN-CD,
                 :TR-OLD-PART-NUM,
                 :WS-PART-NUMBER-OUT,
                 :WS-SUPERSEDING-PART-NUMBER-OUT,
                 :WS-SUPER-EFFECTIVE-DATE-OUT,
                 :WS-ROW-COUNT,
                 :WS-ERROR-TEXT,
                 :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL
             MOVE "Y" TO WS-SUPER-SW
             ADD 1 TO RS-SUPER-READ-CTR
           ELSE
             IF SQLCODE EQUAL NOT-FOUND
               MOVE "N" TO WS-SUPER-SW
             ELSE
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "BAD SELECT: OLD PART, NEW PART, SUPER EFF DATE"
               DISPLAY "OLD PART NUMBER: ", TR-OLD-PART-NUM
               DISPLAY "NEW PART NUMBER: ",
                        WS-SUPERSEDING-PART-NUMBER-OUT
               DISPLAY "SUPER EFFECTIVE DATE: ",
                        WS-SUPER-EFFECTIVE-DATE-OUT
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R3010-EXIT. EXIT.

      ***************************************************************
      * R3025-FOLLOW-SUPCHAIN-NO-DT:                                *
      *     1. ROUTINE TO FIND THE PART AT THE END OF A SUPERSESSION*
      *        CHAIN.                                               *
      ***************************************************************
       R3025-FOLLOW-SUPCHAIN-NO-DT.
           MOVE "R3025-FOLLOW-SUPCHAIN-NO-DT" TO WS-PARAGRAPH.
           MOVE "SUPERSESSION" TO WS-TBLNAME.

           MOVE ZEROES TO WS-SUPER-LOOP-CTR.
           MOVE ZEROES TO SQLCODE.

           PERFORM R3026-FETCH-SUPER-NO-DT THRU R3026-EXIT
              UNTIL SUPER-LOOP-DETECTED OR END-OF-SUPER-CHAIN.

       R3025-EXIT. EXIT.

      ***************************************************************
      * R3026-FETCH-SUPER-NO-DT:                                    *
      *     1. LOOP: FETCH SUPERSESSION ROWS BY PART # (WS-SEL-NUM  *
      *        IS VALUED IN CALLING RTN)                            *
      *     2. IF ROW FOUND, USE SUPERSEDING PART NUMBER & EFFECTIVE*
      *           DATE FOR NEXT FETCH WHERE PART NUMBER =           *
      *           SUPERSEDING PART NUMBER & IS MAX EFFECTIVE DATE   *
      ***************************************************************
       R3026-FETCH-SUPER-NO-DT.
           MOVE "R3026-FETCH-SUPER-NO-DT" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "SUPERSESSION" TO WS-TBLNAME.
           MOVE "OPEN CSR" TO WS-FUNCTION.

           EXEC SQL EXECUTE
            BEGIN
            PKG_SUPERSESSION.P_SUPERSESSION_CSR_02
                (:SUPERCSR02,
                 :WS-SEL-OEM-NUM,
                 :WS-SEL-REGN-CD,
                 :WS-SEL-PART-NUM,
                 :WS-ROW-COUNT,
                 :WS-ERROR-TEXT,
                 :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
            IF SQLCODE NOT EQUAL SUCCESSFUL
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "BAD OPEN SUPERCSR02"
               DISPLAY "TR PART NUM: ", TR-OLD-PART-NUM
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

           MOVE "FETCH  " TO WS-FUNCTION.
           EXEC SQL
               FETCH :SUPERCSR02
                INTO :SUPERSESSION.PART-NUMBER,
                     :SUPERSESSION.SUPERSEDING-PART-NUMBER,
                     :SUPERSESSION.SUPERSESSION-EFFECTIVE-DATE
           END-EXEC.

           IF SQLCODE EQUAL SUCCESSFUL
              ADD 1 TO RS-SUPER-READ-CTR
              ADD SQLERRD(3) TO WS-SUPER-FETCH-ROW-COUNT
           ELSE
             IF SQLCODE EQUAL NOT-FOUND
                MOVE "Y" TO WS-SUPER-SW
                 GO TO R3026-CLOSE
             ELSE
                DISPLAY WS-DB-ERR-MSG
                DISPLAY "BAD FETCH SUPERCSR02"
                DISPLAY "TR PART NUM: ", TR-OLD-PART-NUM
                DISPLAY "PART NUMBER: ", WS-SEL-PART-NUM
                PERFORM Y1000-SQL-ERROR THRU Y1000-EXIT.

      * CHECK IF YOU HAVE A LOOP
      * (E.G. A -> B -> A -> B -> A....)
      *            ]----] POINT OF CHECK
            IF PART-NUMBER OF SUPERSESSION EQUAL WS-PREV-SUPR-PART-NUM
               AND
               SUPERSEDING-PART-NUMBER OF SUPERSESSION EQUAL
                WS-PREV-PART-NUM
               MOVE "Y" TO WS-SUPER-SW
               GO TO R3026-CLOSE.

      * CHECK FOR LOOP WHERE LOOP DIDN'T BEGIN W/ FIRST SUPER SELECTED
      * (E.G. A -> B -> C -> B -> C -> B....)
      *                                 ]-----] POINT OF CHECK
            ADD 1 TO WS-SUPER-LOOP-CTR.
            IF WS-SUPER-LOOP-CTR > WS-SUPER-LOOP-LIMIT
               MOVE "Y" TO WS-SUPER-SW
               GO TO R3026-CLOSE.

      * PREPARE FOR FETCH OF NEXT SUPERSESSION CHAIN
            MOVE SUPERSEDING-PART-NUMBER OF SUPERSESSION
                 TO WS-SEL-PART-NUM.
            MOVE SUPERSESSION-EFFECTIVE-DATE OF SUPERSESSION
                 TO WS-SEL-SUPR-EFF-DT.

       R3026-CLOSE.

           MOVE "R3026-CLOSE.             " TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "CLOSE CSR" TO WS-FUNCTION.

           EXEC SQL EXECUTE
             BEGIN
             PKG_SUPERSESSION.P_SUPERSESSION_CLO_02
                              (:SUPERCSR02,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
            END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
          IF SQLCODE NOT EQUAL SUCCESSFUL
              DISPLAY WS-DB-ERR-MSG
              DISPLAY "BAD CLOSE SUPERCSR02"
              DISPLAY "TR PART NUM: ", TR-OLD-PART-NUM
              DISPLAY "PART NUMBER: ", WS-SEL-PART-NUM
              PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R3026-EXIT. EXIT.

      ***************************************************************
      * R3030-READ-SUPER-BY-SUPR-OLD:                               *
      *     1. FETCH SUPERSESSION ROWS THAT HAVE SUPERSEDING PART # *
      *        THAT MATCHES TRANS OLD PART NUMBER                   *
      *        (I.E. TRANS WOULD BE CONTINUING EXISTING SUPER(S).)  *
      ***************************************************************
       R3030-READ-SUPER-BY-SUPR-OLD.
           MOVE "R3030-READ-SUPER-BY-SUPR-OLD" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "SUPERSESSION" TO WS-TBLNAME.
           MOVE "SUPERCSR01"        TO WS-FUNCTION.

           EXEC SQL EXECUTE
           BEGIN
           PKG_SUPERSESSION.P_SUPERSESSION_CSR_01
                (:SUPERCSR01,
                 :WS-SEL-OEM-NUM,
                 :WS-SEL-REGN-CD,
                 :TR-OLD-PART-NUM,
                 :WS-ROW-COUNT,
                 :WS-ERROR-TEXT,
                 :WS-SQLCODE);
            END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE NOT EQUAL SUCCESSFUL
             DISPLAY  WS-DB-ERR-MSG
             DISPLAY "BAD OPEN SUPERCSR01. TR PART NUM: ",
                      TR-OLD-PART-NUM
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

           MOVE "FETCH  " TO WS-FUNCTION.

           EXEC SQL
               FETCH :SUPERCSR01
               INTO  :SUPERSESSION.SUPERSESSION-EFFECTIVE-DATE
           END-EXEC.

           IF SQLCODE EQUAL SUCCESSFUL
              MOVE "Y" TO WS-SUPER-SW
              ADD 1 TO RS-SUPER-READ-CTR
           ELSE
             IF SQLCODE EQUAL NOT-FOUND
                MOVE "N" TO WS-SUPER-SW
             ELSE
                DISPLAY WS-DB-ERR-MSG
                DISPLAY "BAD FETCH. TR PART NUM: ", TR-OLD-PART-NUM
                PERFORM Y1000-SQL-ERROR THRU Y1000-EXIT.

           MOVE "CLOSE CSR" TO WS-FUNCTION.
            EXEC SQL EXECUTE
             BEGIN
             PKG_SUPERSESSION.P_SUPERSESSION_CLO_01
