           MOVE "R8200-UPDATE-RESTART" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "ACQ_BATCH_RESTART "  TO WS-TBLNAME.
           MOVE "UPDATE "  TO WS-FUNCTION.
           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_UPD_01
                              (:WS-PROGRAM-NAME,
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-RESTART-DATA,
                               :WS-TEMP-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE NOT EQUAL SUCCESSFUL
             DISPLAY WS-DB-ERR-MSG
             DISPLAY "BAD UPDATE OF ACQ_BATCH_RESTART RESTART DATA"
             DISPLAY "PROGRAM NAME: ",
                     WS-PROGRAM-NAME
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R8200-EXIT. EXIT.

      ***************************************************************
      * R8300-DELETE-RESTART:                                       *
      *     1. DELETE ACQ_BATCH_RESTART Oracle RESTART ROWS         *
      ***************************************************************
       R8300-DELETE-RESTART.
           MOVE "R8300-DELETE-RESTART" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "ACQ_BATCH_RESTART " TO WS-TBLNAME.
           MOVE "DELETE " TO WS-FUNCTION.
           MOVE "MPTZ024" TO PROGRAM-NAME OF ACQ-BATCH-RESTART.

           EXEC SQL EXECUTE
           BEGIN
              PKG_APPLICATION.P_ACQ_BATCH_RESTART_DEL_01
                              (:WS-PROGRAM-NAME,
                               :WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-TEMP-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
             END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL
             MOVE "N" TO WS-RESTART-SW
           ELSE
             IF SQLCODE EQUAL NOT-FOUND
               GO TO R8300-EXIT
             ELSE
               DISPLAY WS-DB-ERR-MSG
               DISPLAY "BAD DELETE OF ACQ_BATCH_RESTART RESTART ROW"
               DISPLAY "PROGRAM NAME: ",
                     WS-PROGRAM-NAME
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R8300-EXIT. EXIT.

      ***************************************************************
      * R9000-READ-REPORT:                                          *
      *     1. READ ACQ_BATCH_REPORTS Oracle REPORT ROW             *
      ***************************************************************
