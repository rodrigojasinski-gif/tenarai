a868 1
              MOVE WS-TEMP-DT TO WS-PREV-SUPR-EFF-DT,
d871 1
a871 1
              MOVE TR-SUPR-EFF-DT TO WS-PREV-SUPR-EFF-DT,
d886 1
a886 1
                                      WS-SUPERSEDING-PART-NUMBER,
d1200 1
a1200 1
      *     "ALREADY SUPE" ERROR WILL ALSO, WRITE TO THE Oracle     *
a1201 5
      *     1. "PRIOR SUPE" IS COUNTED AT THE TRANS LEVEL AND THE   *   
      *        EDITORIAL LEVEL (I.E. IMPACT TO EDITORIAL PART/LINE) *   
      *     2. "ALREADY SUPE" IS COUNTED AT THE TRANS LEVEL, THE    *   
      *        EDITORIAL LEVEL -AND- THE TRANSACTION IS WRIITEN TO  *   
      *        THE Oracle REPORT TABLE FOR ERROR REPORTING.         *
a1205 34
           ADD 1 TO RS-NOT-PROC-CTR.                                    
                                                                        
           IF WS-ERR-MSG EQUAL WS-ERR-MSG-TR9                           
              GO TO G3000-ERROR-PRIOR-SUPE.                              
                                                                        
           IF WS-ERR-MSG EQUAL WS-ERR-MSG-TR11                          
              GO TO G3000-ERROR-ALREADY-SUPE.                            
                                                                        
       G3000-ERROR-PRIOR-SUPE.                                          
           MOVE "G3000-ERROR-PRIOR-SUPE.  " TO WS-PARAGRAPH.       
           ADD 1 TO RS-PRIOR-SUPE-CTR.                                  
           ADD 1 TO RS-PRI-PRT-DB-CTR.
                                             
           MOVE TR-NEW-PART-NUM TO WS-SEL-PART-NUM.                     
           MOVE WS-PROD-VER-TYPE TO WS-VERSION-TYPE.
           MOVE -1 TO WS-DELETE-FLAG-DATE-IND.
           PERFORM R4000-COUNT-CEGLN THRU R4000-EXIT.                   
           IF WS-CEGLN-COUNT > 0                                        
              ADD WS-CEGLN-COUNT TO RS-PRI-CEG-LCTR                      
              ADD 1 TO RS-PRI-CEG-PCTR.

           MOVE WS-WIP-VER-TYPE TO WS-VERSION-TYPE.
           MOVE -1 TO WS-DELETE-FLAG-DATE-IND.
           PERFORM R4000-COUNT-CEGLN THRU R4000-EXIT.                   
           IF WS-WIPLN-COUNT > 0                                        
              ADD WS-WIPLN-COUNT TO RS-PRI-WIP-LCTR                      
              ADD 1 TO RS-PRI-WIP-PCTR. 
               
           GO TO G3000-EXIT.                                            
                                                                        
       G3000-ERROR-ALREADY-SUPE.                                        
           MOVE "G3000-ERROR-ALREADY-SUPE." TO WS-PARAGRAPH.       
           ADD 1 TO RS-ALREADY-SUPE-CTR.                                
           ADD 1 TO RS-ALR-PRT-DB-CTR.                                  
a1222 1
       G3000-PRINT.                                                     
