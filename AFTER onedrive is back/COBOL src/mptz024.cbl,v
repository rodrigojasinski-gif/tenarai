       R1000-EXIT. EXIT.

      ***************************************************************
      * R1200-UPDATE-OEM:                                           *
      *     1. UPDATE PART-SUPPLIER-COUNTRY PART SUPPLIER ROW -     *
      *         LAST SUPERSESSION DATE                              *
      *        (BUT ONLY IF THERE WERE TRANSACTIONS)                *
      ***************************************************************
       R1200-UPDATE-OEM.
           MOVE "R1200-UPDATE-OEM" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "PART_SUPPLIER_COUNTRY" TO WS-TBLNAME.
           MOVE "UPDATE " TO WS-FUNCTION.

           EXEC SQL EXECUTE
           BEGIN
              PKG_SUPPLIER.P_PART_SUPPLIER_COUNTRY_UPD_01
                              (:WS-SEL-OEM-NUM,
                               :WS-SEL-REGN-CD,
                               :WS-TEMP-DT,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
