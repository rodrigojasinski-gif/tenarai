               DISPLAY "OLD PART NUM: ", TR-OLD-PART-NUM
               DISPLAY "NEW PART NUM: ", WS-SUPERSEDING-PART-NUMBER
               PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R2400-EXIT. EXIT.

      ***************************************************************
      * R3000-READ-SUPER-OLD-NEW:                                   *
      *     1. READ SUPERSESSION ROW BY TRANS OLD AND NEW PART      *
      *        NUMBERS - TO DETERMINE IF TRANS IS EXACT PRIOR       *
      *        SUPERSESSION: "PRIOR SUPE"                           *
      ***************************************************************
       R3000-READ-SUPER-OLD-NEW.
           MOVE "R3000-READ-SUPER-OLD-NEW" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "SUPERSESSION" TO WS-TBLNAME.
           MOVE "SELECT " TO WS-FUNCTION.

           EXEC SQL EXECUTE
           BEGIN
            PKG_SUPERSESSION.P_SUPERSESSION_SEL_07
                (:WS-SEL-OEM-NUM,
                 :WS-SEL-REGN-CD,
                 :TR-OLD-PART-NUM,
                 :TR-NEW-PART-NUM,
                 :WS-OUT-SUPER-EFFECTIVE-DATE,
                 :WS-ROW-COUNT,
                 :WS-ERROR-TEXT,
                 :WS-SQLCODE);
             END;
           END-EXEC.

