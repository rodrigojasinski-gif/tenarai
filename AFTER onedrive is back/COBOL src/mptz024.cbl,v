                               :WS-REPORT-DATA,
                               :WS-ROW-COUNT,
                               :WS-ERROR-TEXT,
                               :WS-SQLCODE);
           END;
           END-EXEC.

           MOVE WS-SQLCODE TO SQLCODE.
           IF SQLCODE EQUAL SUCCESSFUL
             CONTINUE
           ELSE
             DISPLAY WS-DB-ERR-MSG
             DISPLAY "BAD SELECT ACQ_BATCH_REPORTS REPORT-DATA"
             DISPLAY "REPORT NUMBER: " BALANCE-CNT-ROW
             PERFORM Y1500-SQL-PROCEDURE-ERROR THRU Y1500-EXIT.

       R9000-EXIT. EXIT.

      ***************************************************************
      * R9100-INSERT-REPORT:                                        *
      *     1. INSERT ACQ_BATCH_REPORTS  Oracle REPORT ROW          *
      ***************************************************************
