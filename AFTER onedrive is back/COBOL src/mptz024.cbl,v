                DISPLAY WS-ERR-MSG-CP1
                MOVE V-MISSING-CNTL-PARM TO WS-ABEND-CODE
                PERFORM Y2000-ABEND THRU Y2000-EXIT.

           IF CNTL-OEM-NUM NOT NUMERIC
             DISPLAY WS-ERR-MSG-CP2
             MOVE V-INVALID-CNTL-PARM TO WS-ABEND-CODE
             PERFORM Y2000-ABEND THRU Y2000-EXIT.

           MOVE CNTL-OEM-NUM TO WS-SEL-OEM-NUM.
           MOVE CNTL-REGN-CD TO WS-REGION,
                                  WS-SEL-REGN-CD.
           PERFORM R1000-READ-OEM THRU R1000-EXIT.
           IF NOT-VALID-OEM
             DISPLAY WS-ERR-MSG-CP2
             DISPLAY WS-SEL-OEM-NUM, " ",
                     WS-SEL-REGN-CD
             MOVE V-INVALID-CNTL-PARM TO WS-ABEND-CODE
             PERFORM Y2000-ABEND THRU Y2000-EXIT.

           MOVE WS-SEL-OEM-NUM            TO HDG-OEM-NUM.
           MOVE WS-PART-SUPPLIER-NAME-RGN TO HDG-OEM-NM.
           MOVE WS-PGMNAME                TO HDG-PGMNAME,
                                             EOR-PGMNAME.

           MOVE CNTL-EFF-MONTH   TO WS-TEMP-EFF-MONTH.
           MOVE CNTL-EFF-DAY     TO WS-TEMP-EFF-DAY.
           MOVE CNTL-EFF-YEAR    TO WS-TEMP-EFF-YEAR.

           IF WS-TEMP-EFF-DT NOT NUMERIC OR WS-TEMP-EFF-DT <= ZEROES
             DISPLAY WS-ERR-MSG-CP3
             MOVE V-INVALID-DATE TO WS-ABEND-CODE
             PERFORM Y2000-ABEND THRU Y2000-EXIT.

           ACCEPT WS-CURRENT-DT FROM DATE.
           MOVE WS-CD-MONTH  TO WS-FD-MONTH.
           MOVE WS-CD-DAY    TO WS-FD-DAY.
           MOVE WS-CD-YEAR   TO WS-FD-YEAR.
           MOVE WS-FORMAT-DT TO HDG-DT.

           ACCEPT WS-CURRENT-TM FROM TIME.
           MOVE WS-CT-HOUR   TO WS-FT-HOUR.
           MOVE WS-CT-MINUTE TO WS-FT-MINUTE.
           MOVE WS-CT-SECOND TO WS-FT-SECOND.
           MOVE WS-FORMAT-TM TO HDG-TM.

           IF OEM-TAPE-RUN
             MOVE WS-RPT-TITLE   TO HDG-TITLE
           ELSE
             MOVE WS-RPT-TITLE-S TO HDG-TITLE.

           MOVE CNTL-EFF-DT      TO HDG-EFF-DT,
                                    WS-TEMP-DT.

           IF CNTL-NAGS-TYP = "N/A     "
             NEXT SENTENCE
           ELSE
             MOVE CNTL-NAGS-TYP TO HDG-NAGS-TYP.

           PERFORM A1000-CHECK-RESTART THRU A1000-EXIT.

       A0000-EXIT. EXIT.

      ***************************************************************
      * A1000-CHECK-RESTART:                                        *
      *     1. CHECK IF RESTART ROWS FOUND INDICATING RESTART RUN.  *
      *     2. IF SO, VALIDATE AGAINST PARM EFFECTIVE DATE          *
      ***************************************************************
       A1000-CHECK-RESTART.
           PERFORM R8000-READ-RESTART THRU R8000-EXIT.
           MOVE "A1000-CHECK-RESTART" TO WS-PARAGRAPH.
           IF RESTART-READ-WRITTEN
             IF CNTL-EFF-DT NOT EQUAL RS-EFF-DT
               DISPLAY WS-ERR-MSG-CP5
               MOVE V-PARM-DOESNT-MATCH-RESTART TO WS-ABEND-CODE
               DISPLAY "CNTL-EFF-DT = " CNTL-EFF-DT
               DISPLAY "RS-EFF-DT   = " RS-EFF-DT
               PERFORM Y2000-ABEND THRU Y2000-EXIT
             ELSE
               PERFORM A2000-RESTART-TRANS THRU A2000-EXIT
                 UNTIL TRANS-EQUAL-RESTART OR END-OF-TRANSFILE
           ELSE
               PERFORM E1000-INIT-RESTART-WSTG THRU E1000-EXIT.

       A1000-EXIT. EXIT.

      ***************************************************************
      * A2000-RESTART-TRANS:                                        *
      *     1. READ TRANS FILE TO POINT OF RESTART FILE             *
      ***************************************************************
       A2000-RESTART-TRANS.
            MOVE "A2000-RESTART-TRANS" TO WS-PARAGRAPH.

           READ TRANS-FILE INTO WS-TRANS-REC
             AT END
               DISPLAY WS-ERR-MSG-TR5
               MOVE V-EMPTY-INPUT-FILE TO WS-ABEND-CODE
               PERFORM Y2000-ABEND THRU Y2000-EXIT.

           IF TR-TRANS-CODE NOT EQUAL "N"
             DISPLAY WS-ERR-MSG-TR1
             MOVE V-INVALID-INPUT-FILE TO WS-ABEND-CODE
             PERFORM Y2000-ABEND THRU Y2000-EXIT.

           IF TR-OLD-PART-NUM EQUAL RS-TR-OLD-PART-NUM AND
              TR-NEW-PART-NUM EQUAL RS-TR-NEW-PART-NUM
             MOVE "R" TO WS-PROCESS-SW.

       A2000-EXIT. EXIT.

      ***************************************************************
      * B0000-READ-TRANS:                                           *
      *     1. READ TRANSACTION FILE                                *
      *     2. IF TRANS FILE EMPTY OR MISSING, PREPARE FOR ABEND.   *
      *     3. VERIFY CORRECT TRANSACTION FILE FOR THIS RUN.        *
      *     4. PROCESS SUPERSESSION TRANSACTION                     *
      ***************************************************************
       B0000-READ-TRANS.
           MOVE "B0000-READ-TRANS" TO WS-PARAGRAPH.

           READ TRANS-FILE INTO WS-TRANS-REC
             AT END
                MOVE "T" TO WS-PROCESS-SW.

           IF END-OF-TRANSFILE
               GO TO B0000-EXIT
           ELSE
               ADD 1 TO RS-TRANS-READ-CTR.

           IF TR-TRANS-CODE NOT EQUAL "N"
             DISPLAY WS-ERR-MSG-TR1
             MOVE V-INVALID-INPUT-FILE TO WS-ABEND-CODE
             PERFORM Y2000-ABEND THRU Y2000-EXIT.

           IF RS-TRANS-READ-CTR EQUAL 1
             IF WS-LAST-SUPER-IND EQUAL ZEROES
               MOVE WS-LAST-SUPERSESSION-DATE TO WS-LST-UPD-DT
               MOVE WS-LST-UPD-MONTH TO WS-TEMP-UPD-MONTH
               MOVE WS-LST-UPD-DAY   TO WS-TEMP-UPD-DAY
               MOVE WS-LST-UPD-YEAR  TO WS-TEMP-UPD-YEAR
               IF REPLACEMENT-RUN
                 IF WS-TEMP-EFF-DT > WS-TEMP-UPD-DT
                   DISPLAY WS-ERR-MSG-CP10N
                   DISPLAY WS-ERR-MSG-CP10
                   DISPLAY "WS-TEMP-EFF-DT = " WS-TEMP-EFF-DT
                   DISPLAY "WS-TEMP-UPD-DT = " WS-TEMP-UPD-DT
                   MOVE V-INVALID-DATE TO WS-ABEND-CODE
                   PERFORM Y2000-ABEND THRU Y2000-EXIT
                 ELSE
                   CONTINUE
               ELSE
      * REGULAR RUN
                 IF WS-TEMP-EFF-DT <= WS-TEMP-UPD-DT
                   DISPLAY WS-ERR-MSG-CP4N
                   DISPLAY WS-ERR-MSG-CP4
                   DISPLAY "WS-TEMP-EFF-DT    " WS-TEMP-EFF-DT
                   DISPLAY "WS-TEMP-UPD-DT    " WS-TEMP-UPD-DT
                   MOVE V-INVALID-DATE TO WS-ABEND-CODE
                   PERFORM Y2000-ABEND THRU Y2000-EXIT.

      * MAIN SUPERSESSION PROCESSING LOOP
           PERFORM C0000-SUPERSESSION-PROCESS THRU C0000-EXIT.

       B0000-EXIT. EXIT.

      ***************************************************************
      * C0000-SUPERSESSION-PROCESS:                                 *
      *     1. COMPARE SUPER TRANS TO EXISTING SUPERSESSION HISTORY *
      *     2. IF INVALID, WRITE TRANS INFO TO Oracle REPORT TABLE  *
      *     3. INSERT THE SUPERSESSION REC TO DATABASE              *
      *     4. CHECK IF PART ON DATABASE                            *
      *     5. PROCESS THE TRANSACTION.                             *
      *     6. POST ASSOCIATED LINE COUNTS (FOR REPORTING)          *
      *     7. DETERMINE IF TIME TO COMMIT AND IS SO, PERFORM RTN.  *
      ***************************************************************
       C0000-SUPERSESSION-PROCESS.
            MOVE "C0000-SUPERSESSION-PROCESS" TO WS-PARAGRAPH.

      * CHECK IF OLD PART SUPERSEDES TO ANY PART
      * E.G.  TRANS: A -> B      DB: A -> D        (ALREADY SUPE)
      * E.G.  TRANS: A -> B      DB: A -> B        (PRIOR SUPE)
           MOVE SPACES TO WS-ERR-MSG.
           PERFORM R3010-READ-SUPER-BY-OLD THRU R3010-EXIT.

           IF SUPER-FOUND
      * CHECK IF "ALREADY SYPERSEDED" TO A DIFFERENT PART (ERROR)
             IF TR-NEW-PART-NUM NOT EQUAL WS-SUPERSEDING-PART-NUMBER-OUT
               MOVE "Y" TO WS-TRANS-ERR-SW
               MOVE WS-ERR-MSG-TR11 TO WS-ERR-MSG
               ADD 1 TO RS-NOT-PROC-CTR
               ADD 1 TO RS-ALREADY-SUPE-CTR
               ADD 1 TO RS-ALR-PRT-DB-CTR
               PERFORM G3000-ERROR-ROUTINE THRU G3000-EXIT
               MOVE SPACES TO WS-TRANS-ERR-SW
               GO TO C0000-COMMIT-CHECK
             ELSE
      * "PRIOR SUPERSESSION" SKIP THE INSERT TO THE SUPERSESSION TABLE
      * BUT CONTINUE PROCESSING IT, JUST IN CASE THE SUPER NEEDS TO BE
      * "PUSHED" FORWARD. I.E. WE'RE REPROCESSING A HISTORICAL SUPER.
               MOVE WS-ERR-MSG-TR9 TO WS-ERR-MSG
               ADD 1 TO RS-PRIOR-SUPE-CTR
           ELSE
      * THIS IS A NEW SUPERSESSION SO POST SUPERSESSION TO DATABASE.
             PERFORM R3100-INSERT-SUPER THRU R3100-EXIT.

      * CHECK IF OLD PART ON DATABASE
           MOVE TR-OLD-PART-NUM TO WS-PART-NUMBER-IN.
           MOVE SPACE TO WS-PART-SW.
           PERFORM R2000-READ-PART THRU R2000-EXIT
           IF NOT-VALID-PART
              IF WS-ERR-MSG EQUAL WS-ERR-MSG-TR9
                ADD 1 TO RS-NOT-PROC-CTR
                GO TO C0000-COMMIT-CHECK
              ELSE
                MOVE WS-ERR-MSG-TR10 TO WS-ERR-MSG
                ADD 1 TO RS-PROC-CTR
                ADD 1 TO RS-PART-NOT-DB-CTR
                GO TO C0000-COMMIT-CHECK
           ELSE
              ADD 1 TO RS-PART-READ-CTR.

      * IF OLD PART ON DATABASE, PROCESS SUPERSESSION
           MOVE ZEROES TO WS-CEGLN-COUNT,
                          WS-WIPLN-COUNT.

           PERFORM C2000-UPDATE THRU C2000-EXIT.

           ADD 1 TO RS-PROC-CTR.
           IF WS-ERR-MSG EQUAL WS-ERR-MSG-TR9
             ADD 1 TO RS-PRI-PRT-DB-CTR
           ELSE
             ADD 1 TO RS-NEW-PRT-DB-CTR.

           IF WS-CEGLN-COUNT > 0
             IF WS-ERR-MSG EQUAL WS-ERR-MSG-TR9
               ADD WS-CEGLN-COUNT TO RS-PRI-CEG-LCTR
               ADD 1              TO RS-PRI-CEG-PCTR
             ELSE
               ADD WS-CEGLN-COUNT TO RS-NEW-CEG-LCTR
               ADD 1              TO RS-NEW-CEG-PCTR.

           IF WS-WIPLN-COUNT > 0
             IF WS-ERR-MSG EQUAL WS-ERR-MSG-TR9
               ADD WS-WIPLN-COUNT TO RS-PRI-WIP-LCTR
               ADD 1              TO RS-PRI-WIP-PCTR
             ELSE
               ADD WS-WIPLN-COUNT TO RS-NEW-WIP-LCTR
               ADD 1              TO RS-NEW-WIP-PCTR.


        C0000-COMMIT-CHECK.
           MOVE "C0000-COMMIT-CHECK.      " TO WS-PARAGRAPH.

           IF WS-DB-ROW-CTR > COMMIT-LIMIT
               PERFORM F0000-COMMIT THRU F0000-EXIT.

       C0000-EXIT. EXIT.


      ***************************************************************
      * C2000-UPDATE:                                               *
      *     1. CHECK IF "NEW" PART HAS SUPERSEDED TO ANYTHING ELSE  *
      *        (EFFECTIVE TODAY OR IN THE FUTURE).                  *
      *     2. IF NEW PART SUPERSEDES TO PART THAT'S ALREADY IN THE *
      *        LINE, BYPASS REMAINING PROCESSING.                   *
      *     3. INSERT NEW PART ROW (BLANK, ZERO, NULL PRICE INFO)   *
      *     4. IF NEW PART ROW ALREADY EXISTS, UPDATE IT, (IF       *
      *        NECESSARY) WITH REGION.                              *
      *     5. CHECK REGION PROCESSING VERSUS REGION IN OLD PART ROW*
      *        IF US RUN:                                           *
      *          A) UPDATE ANY ASSOC. CEG OR WIP LINE ROW(S)        *
      *        IF CAN RUN:                                          *
      *          A) UPDATE ANY ASSOC. CEG LINE ROW(S)               *
      *     6. INSERT ALTPART ROW(S) (USING OLD ALT PART ROW        *
      *        INFO). IF NEW ALTPART ROW ALREADY EXISTS,            *
      *        CONTINUE ON                                          *
      *     7. DELETE OLD ALTPART ROW(S) IF ANY EXIST               *
      *     8. DELETE OLD PART ROW AND ALL ASSOC. TABLE ROWS        *
      ***************************************************************
       C2000-UPDATE.
           MOVE "C2000-UPDATE" TO WS-PARAGRAPH.

      * -------------------------------------------------------------
      * CHECK IF SUPERSEDED PART HAS SUPERSEDED TO ANYTHING ELSE
      * (TODAY OR IN THE FUTURE).
      * E.G. DB:     A -> B 12/03/93
      *      TRANS:  Z -> A 11/21/93
      * -------------------------------------------------------------
      * SUPERSESSION INFO THAT YOU'RE MOVING TO PREV IS SUPERSESSION YOU
      * JUST INSERTED (IE. TRANSACTION INFO.)
      * -------------------------------------------------------------

           MOVE SPACES                   TO WS-SUPER-SW.

           MOVE TR-OLD-PART-NUM  TO WS-PREV-PART-NUM.
           MOVE TR-NEW-PART-NUM  TO WS-PREV-SUPR-PART-NUM,
                                    WS-SEL-PART-NUM.
           IF TR-SUPR-EFF-DT EQUAL SPACES
              MOVE WS-TEMP-DT TO WS-PREV-SUPR-EFF-DT
                                 WS-SEL-SUPR-EFF-DT
           ELSE
              MOVE TR-SUPR-EFF-DT TO WS-PREV-SUPR-EFF-DT
                                     WS-SEL-SUPR-EFF-DT.
      *-----------------------------------------------------------------
      * IN RACE II CONVERSION IF NO ROWS ARE FETCHED, THE RESULTING VALUES
      * OF THE BIND VARIABLES (SELECTED INTO) ARE INDETERMINATE AND CAN
      * NOT BE READ.  DETERMINE IF ANY ROWS WERE FETCHED.
      * IF NO ROWS FETCHED, SUPERSEDING PART IS TR-NEW-PART-NUM
      *--------------------------------------------------------------------
           MOVE ZERO TO WS-SUPER-FETCH-ROW-COUNT.

           PERFORM R3025-FOLLOW-SUPCHAIN-NO-DT THRU R3025-EXIT.

      ***  PROCESS THE END OF THE SUPERSESSION CHAIN SEARCH
           IF WS-SUPER-FETCH-ROW-COUNT = ZERO
              MOVE TR-NEW-PART-NUM TO WS-PART-NUMBER-IN,
                                      WS-SUPERSEDING-PART-NUMBER
           ELSE
               MOVE SUPERSEDING-PART-NUMBER OF SUPERSESSION TO
                 WS-PART-NUMBER-IN,
                 WS-SUPERSEDING-PART-NUMBER.

      * -------------------------------------------------------------
      * IF END-OF-SUPERSESSION CHAIN EQUALS OLD PART, BYPASS UPDATE
      * E.G. DB:     A -> B 12/03/93
      *              B -> Z 12/03/93
      *      TRANS:  Z -> A 11/21/93
      * NOTE: THE END-OF-SUPERSESSION CHAIN IS THE NEW SUPERSEDING PART
      *       THE PART SUPPLIER DOES NOT ALWAYS SEND THE END OF THE
      *       CHAIN
      *  E.G.        A -> B  12/03/97
      *              B -> C  10/12/98
      *              C -> D  01/15/99
      *              A -> C CURRENT SUPERSESSION TRANSACTION
      * -------------------------------------------------------------

           IF WS-SUPER-FETCH-ROW-COUNT > 0
              IF SUPERSEDING-PART-NUMBER OF SUPERSESSION
                 EQUAL TR-OLD-PART-NUM
                 GO TO C2000-EXIT.
      *----------------------------------------------------------------------
      * RACE II SUPERSESSION UPDATE LOGIC
      * DETERMINE IF THE SUPERSEDING PART EXISTS IN THE DB
      * IF THE SUPERSEDING PART EXISTS IN THE DB:
      *    1. UPDATE ALL OF THE DETAIL-PART-XREF ROWS WITH THE OLD PART
      *       SKEY TO EQUAL THE NEW PART SKEY AND SET SUPERSESSION MOD
      *       FLAG TO 'Y'.
      *    2. DELETE THE OLD PART
      *    3. UPDATE ALL OF THE PART-ALTPART-XREF ROWS WITH THE OLD PART
      *       SKEY TO EQUAL THE NEW PART SKEY.
      * IF THE SUPERSEDING PART DOES NOT EXIST IN THE DB:
      *    1.  UPDATE THE PART ROW WITH THE OLD PART SKEY TO EQUAL THE
      *        NEW PART NUMBER, BLANK, ZERO, NULL PRICE/DATE VALUES.
      *    2.  SET THE SUPERSESSION MOD FLAG TO 'Y' IN THE DETAIL-PART-XREF
      *        ROWS WITH OLD PART SKEY
      *    3.  GET ALTERNATE PARTS IMPACT COUNT
      *     ADD # OF LINES UPDATED (FOUND IN SQLERRD) TO CTRS.
      *     NOTE: TWO UPDATES PERFORMED (ONE FOR FWD POINTED LINES;
      *           THE OTHER FOR NON-FWD POINTED LINES) SO THAT
      *           UPDATE COUNT WILL BE ACCURATE.
      *----------------------------------------------------------------------

      *** FIND OUT IF THE SUPERSEDING PART IS ALREADY IN THE DB
           MOVE SPACES TO WS-PART-NUMBER-OUT.
           MOVE SPACE TO WS-PART-SW.
           PERFORM R2000-READ-PART THRU R2000-EXIT.

      *  PROCESS THE SUPERSESSION BASED ON WHETHER IT EXISTS IN THE DB OR NOT
           IF VALID-PART
              ADD 1 TO WS-SUPER-EXISTS-DB-CTR
              PERFORM R4100-SUPER-SKEY-UPDATE THRU R4100-EXIT
           ELSE
              PERFORM R4150-PART-SKEY-UPDATE THRU R4150-EXIT.

       C2000-EXIT. EXIT.

      ***************************************************************
      * E1000-INIT-RESTART-WSTG                                     *
      *     1. INITIALIZE WORKING STORAGE RESTART AND REPORT AREAS  *
      ***************************************************************
       E1000-INIT-RESTART-WSTG.
           MOVE "E1000-INIT-RESTART-WSTG" TO WS-PARAGRAPH.

           INITIALIZE RESTART-RECORD
                      REPLACING ALPHANUMERIC DATA BY SPACES
                                NUMERIC DATA BY ZEROES.

       E1000-EXIT. EXIT.

      ***************************************************************
      * F0000-COMMIT:                                               *
      *     1. "UPDATE" RESTART TABLE                               *
      *        THE FIRST TIME THAT A COMMIT IS PERFORMED, THE       *
      *        RESTART ROWS ARE INSERTED. SUBSEQUENT COMMITS INVOKE *
      *        AN UPDATE TO THE RESTART TABLE. AT THE END OF THE    *
      *        RUN, THE RESTART ROWS ARE DELETED.                   *
      *     2. COMMIT Oracle TABLE ACTIVITY                         *
      ***************************************************************
       F0000-COMMIT.
           MOVE "F0000-COMMIT" TO WS-PARAGRAPH.

           IF RESTART-READ-WRITTEN
              PERFORM F1000-BUILD-RESTART-REC THRU F1000-EXIT
              PERFORM R8200-UPDATE-RESTART    THRU R8200-EXIT
           ELSE
              PERFORM F1000-BUILD-RESTART-REC THRU F1000-EXIT
              PERFORM R8100-INSERT-RESTART    THRU R8100-EXIT.

           EXEC SQL
             COMMIT
           END-EXEC.

           MOVE 0 TO WS-DB-ROW-CTR.

       F0000-EXIT. EXIT.

      ***************************************************************
      * F1000-BUILD-RESTART-REC:                                    *
      *     1. MOVE INFORMATION TO RESTART RECORD                   *
      ***************************************************************
       F1000-BUILD-RESTART-REC.
           MOVE "F1000-BUILD-RESTART-REC" TO WS-PARAGRAPH.

           MOVE CNTL-EFF-DT          TO RS-EFF-DT.
           MOVE TR-OLD-PART-NUM      TO RS-TR-OLD-PART-NUM.
           MOVE TR-NEW-PART-NUM      TO RS-TR-NEW-PART-NUM.
           MOVE PART-NUMBER OF PART  TO RS-DB-PART-NUM.
           MOVE RESTART-RECORD       TO WS-RESTART-DATA.

       F1000-EXIT. EXIT.

      ***************************************************************
      * G2000-CONTROL-REPORT:                                       *
      *     1. WRITE CONTROL REPORT.                                *
      *     2. BUILD AND INSERT CONTROL REPORT ROWS                 *
      *        W/I ORACLE TABLE.                                    *
      ***************************************************************
       G2000-CONTROL-REPORT.
           MOVE "G2000-CONTROL-REPORT" TO WS-PARAGRAPH.

      * BUILD AND WRITE SUPERSESSION CONTROL REPORT HEADINGS AND
      * TRANS ACTIVITY TOTAL LINE
           MOVE 1 TO HDG-PAGE.
           MOVE 1 TO HDG-RPTNUM, EOR-RPTNUM.
           WRITE REPORT-LINE FROM HEADING1 AFTER PAGE.
           WRITE REPORT-LINE FROM HEADING2 AFTER 1 LINE.
           WRITE REPORT-LINE FROM HEADING3 AFTER 2 LINE.
           WRITE REPORT-LINE FROM SUBHEAD-04-1A AFTER 5 LINES.
           WRITE REPORT-LINE FROM SUBHEAD-04-1B AFTER 1 LINE.
           WRITE REPORT-LINE FROM SUBHEAD-04-2 AFTER 1 LINE.
           MOVE REPORT-NTRANS-DESC  TO RPT04-TRANS-DESC.
           MOVE RS-TRANS-READ-CTR   TO RPT04-TOTAL-READ.
           MOVE RS-PROC-CTR         TO RPT04-PROC-AMT.
           MOVE RS-NOT-PROC-CTR     TO RPT04-NOT-PROC-AMT.
           MOVE RS-PRIOR-SUPE-CTR   TO RPT04-PRIOR-SUPE-AMT.
           MOVE RS-ALREADY-SUPE-CTR TO RPT04-ALREADY-SUPE-AMT.
           MOVE RS-PART-NOT-DB-CTR  TO RPT04-PART-NOT-DB-AMT.
           WRITE REPORT-LINE FROM DETAIL-04A AFTER 1 LINE.

      * BUILD AND INSERT SUPER. TRANS CONTROL REPORT LINE IN Oracle TBl
           MOVE "MPTZ007-04" TO REPORT-NUMBER.
           MOVE SPACES       TO REPORT-SORT-CRITERIA.
           MOVE "N"          TO SRT4-TRANS-TYPE.
           MOVE "A"          TO SRT4-REC-TYPE.
           MOVE 1            TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04A   TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE DATABASE CONTROL SECTION HEADINGS AND
      * DATABASE PART ACTIVITY LINE.
           WRITE REPORT-LINE FROM SUBHEAD-04-3 AFTER 5 LINES.
           WRITE REPORT-LINE FROM SUBHEAD-04-4 AFTER 1 LINE.
           WRITE REPORT-LINE FROM SUBHEAD-04-5 AFTER 1 LINE.
           MOVE REPORT-PART-DESC TO RPT04-DATABASE.
           MOVE RS-PART-READ-CTR    TO RPT04-READ-AMT.
           MOVE RS-PART-INSRT-CTR   TO RPT04-INSRT-AMT.
           MOVE RS-PART-UPDT-CTR    TO RPT04-UPDT-AMT.
           MOVE RS-PART-DLET-CTR    TO RPT04-DLET-AMT.
           ADD RS-PART-READ-CTR, RS-PART-INSRT-CTR,
               RS-PART-UPDT-CTR, RS-PART-DLET-CTR
                  GIVING RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE PART ACTIVITY LINE IN Oracle TABLE
           MOVE "B"         TO SRT4-REC-TYPE.
           MOVE 1           TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B  TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE SUPERSESSION ACTIVITY LINE
           MOVE REPORT-SUPERSESSION-DESC TO RPT04-DATABASE.
           MOVE RS-SUPER-READ-CTR   TO RPT04-READ-AMT.
           MOVE RS-SUPER-INSRT-CTR  TO RPT04-INSRT-AMT.
           MOVE ZEROES              TO RPT04-UPDT-AMT.
           MOVE ZEROES              TO RPT04-DLET-AMT.
           ADD RS-SUPER-READ-CTR, RS-SUPER-INSRT-CTR
               GIVING RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE SUPERSESSION ACTIVITY LINE IN Oracle
      * table
           MOVE 2            TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B   TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE CEG LINES ACTIVITY LINE
           MOVE REPORT-PROD-DESC TO RPT04-DATABASE.
           MOVE RS-CEGLN-READ-CTR   TO RPT04-READ-AMT.
           MOVE ZEROES              TO RPT04-INSRT-AMT.
           MOVE RS-CEGLN-UPDT-CTR   TO RPT04-UPDT-AMT.
           MOVE ZEROES              TO RPT04-DLET-AMT.
           ADD RS-CEGLN-READ-CTR, RS-CEGLN-UPDT-CTR
               GIVING RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE CEG LINES ACTIVITY LINE IN Oracle TBL
           MOVE 3            TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B   TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE WIP LINES ACTIVITY LINE
           MOVE REPORT-WIP-DESC TO RPT04-DATABASE.
           MOVE RS-WIPLN-READ-CTR    TO RPT04-READ-AMT.
           MOVE ZEROES               TO RPT04-INSRT-AMT.
           MOVE RS-WIPLN-UPDT-CTR    TO RPT04-UPDT-AMT.
           MOVE ZEROES               TO RPT04-DLET-AMT.
           ADD RS-WIPLN-READ-CTR, RS-WIPLN-UPDT-CTR
               GIVING RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE WIP LINES ACTIVITY LINE IN Oracle TBL
           MOVE 4                    TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B           TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE ALTPARTS ACTIVITY LINE
           MOVE REPORT-PART-ALTPART-XREF-DESC  TO RPT04-DATABASE.
           MOVE RS-ALTPART-READ-CTR  TO RPT04-READ-AMT.
           MOVE RS-ALTPART-UPDT-CTR  TO RPT04-UPDT-AMT.
           MOVE RS-ALTPART-DLET-CTR  TO RPT04-DLET-AMT.
           MOVE ZEROES               TO RPT04-INSRT-AMT.
           ADD RS-ALTPART-READ-CTR, RS-ALTPART-UPDT-CTR,
               RS-ALTPART-DLET-CTR GIVING RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE ALTPARTS ACTIVITY LINE IN Oracle TBL
           MOVE 6            TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B   TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE ERROR REPORTS ACTIVITY LINE
           MOVE REPORT-ACQ-BATCH-REPORTSE-DESC TO RPT04-DATABASE.
           MOVE ZEROES               TO RPT04-READ-AMT.
           MOVE RS-ERR-RPT-INSRT-CTR TO RPT04-INSRT-AMT.
           MOVE ZEROES               TO RPT04-UPDT-AMT.
           MOVE ZEROES               TO RPT04-DLET-AMT.
           MOVE RS-ERR-RPT-INSRT-CTR TO RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE ERR RPTS ACTIVITY LINE IN Oracle TBL
           MOVE 7           TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B  TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD AND WRITE TRANS REPORTS ACTIVITY LINE
           MOVE REPORT-ACQ-BATCH-REPORTST-DESC TO RPT04-DATABASE.
           MOVE ZEROES               TO RPT04-READ-AMT.
           MOVE RS-TRN-RPT-INSRT-CTR TO RPT04-INSRT-AMT.
           MOVE ZEROES               TO RPT04-UPDT-AMT.
           MOVE ZEROES               TO RPT04-DLET-AMT.
           MOVE RS-TRN-RPT-INSRT-CTR TO RPT04-TOTAL-AMT.
           WRITE REPORT-LINE FROM DETAIL-04B AFTER 1 LINE.

      * BUILD AND INSERT DATABASE TRANS RPTS ACTIVITY LINE IN Oracle TBL
           MOVE 8          TO SRT4-REC-TYPE-CTR.
           MOVE DETAIL-04B TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * WRITE END-OF-REPORT PAGE
           MOVE 2 TO HDG-PAGE.
           WRITE REPORT-LINE FROM HEADING1 AFTER PAGE.
           WRITE REPORT-LINE FROM HEADING2 AFTER 1 LINE.
           WRITE REPORT-LINE FROM HEADING3 AFTER 2 LINES.
           WRITE REPORT-LINE FROM EOR-NOTE AFTER 15 LINES.

      * BUILD & INSERT NEWLY SUPER UPDATE ACTIVITY LINE TO Oracle RPT
      * table
           MOVE "S"             TO SRT4-TRANS-TYPE.
           MOVE "C"             TO SRT4-REC-TYPE.
           MOVE 3               TO SRT4-REC-TYPE-CTR.
           MOVE SUPER-ACTVY-3   TO RPT04-UPDT-ACTVY.
           MOVE RS-NEW-CEG-PCTR TO RPT04-CEG-PRT-CTR.
           MOVE RS-NEW-CEG-LCTR TO RPT04-CEG-LN-CTR.

           MOVE RS-NEW-WIP-PCTR TO RPT04-WIP-PRT-CTR.
           MOVE RS-NEW-WIP-LCTR TO RPT04-WIP-LN-CTR.
           MOVE RS-NEW-PRT-DB-CTR TO RPT04-PRT-DB-CTR.
           MOVE DETAIL-04C      TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD & INSERT PRIOR SUPER UPDATE ACTIVITY LINE TO Oracle RPT
      * table
           MOVE 4               TO SRT4-REC-TYPE-CTR.
           MOVE SUPER-ACTVY-4   TO RPT04-UPDT-ACTVY.
           MOVE RS-PRI-CEG-PCTR TO RPT04-CEG-PRT-CTR.
           MOVE RS-PRI-CEG-LCTR TO RPT04-CEG-LN-CTR.
           MOVE RS-PRI-WIP-PCTR TO RPT04-WIP-PRT-CTR.
           MOVE RS-PRI-WIP-LCTR TO RPT04-WIP-LN-CTR.
           MOVE RS-PRI-PRT-DB-CTR TO RPT04-PRT-DB-CTR.
           MOVE DETAIL-04C      TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

      * BUILD & INSERT PRIOR SUPE (NOT SAME) ACTVY LINE TO Oracle RPT
      * table
           MOVE 5               TO SRT4-REC-TYPE-CTR.
           MOVE SUPER-ACTVY-5   TO RPT04-UPDT-ACTVY.
           MOVE RS-ALR-CEG-PCTR TO RPT04-CEG-PRT-CTR.
           MOVE RS-ALR-CEG-LCTR TO RPT04-CEG-LN-CTR.

           MOVE RS-ALR-WIP-PCTR TO RPT04-WIP-PRT-CTR.
           MOVE RS-ALR-WIP-LCTR TO RPT04-WIP-LN-CTR.
           MOVE RS-ALR-PRT-DB-CTR TO RPT04-PRT-DB-CTR.
           MOVE DETAIL-04C      TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.

       G2000-EXIT. EXIT.

      ***************************************************************
      * G3000-ERROR-ROUTINE:                                        *
      *     THIS ROUTINE ADDS TO THE APPROPRIATE COUNTERS AND IF    *
      *     "ALREADY SUPE" ERROR WILL ALSO WRITE TO THE Oracle      *
      *     ERROR REPORT TABLE.                                     *
      ***************************************************************
       G3000-ERROR-ROUTINE.
           MOVE "G3000-ERROR-ROUTINE" TO WS-PARAGRAPH.

           MOVE SUPERSEDING-PART-NUMBER OF SUPERSESSION
                TO WS-SEL-PART-NUM.

           MOVE WS-PROD-VER-TYPE TO WS-VERSION-TYPE.
           MOVE -1 TO WS-DELETE-FLAG-DATE-IND.
           PERFORM R4000-COUNT-CEGLN THRU R4000-EXIT.
           IF WS-CEGLN-COUNT > 0
             ADD WS-CEGLN-COUNT TO RS-ALR-CEG-LCTR
             ADD 1 TO RS-ALR-CEG-PCTR.

           MOVE WS-WIP-VER-TYPE TO WS-VERSION-TYPE.
           MOVE -1 TO WS-DELETE-FLAG-DATE-IND.
           PERFORM R4000-COUNT-CEGLN THRU R4000-EXIT.
           IF WS-WIPLN-COUNT > 0
             ADD WS-WIPLN-COUNT TO RS-ALR-WIP-LCTR
             ADD 1 TO RS-ALR-WIP-PCTR.

           MOVE "G3000-PRINT.             " TO WS-PARAGRAPH.
           MOVE "MPTZ007-01"     TO REPORT-NUMBER.
           MOVE SPACES TO REPORT-SORT-CRITERIA.
           MOVE "N"               TO SRT1-TRANS-TYPE.
           MOVE TR-OLD-PART-NUM   TO SRT1-PART-NUM-1.
           MOVE TR-NEW-PART-NUM   TO SRT1-PART-NUM-2.

           MOVE "N"               TO RPT01-TRANS.
           MOVE TR-OLD-PART-NUM   TO RPT01-OLD-PART-NUM.
           MOVE TR-NEW-PART-NUM   TO RPT01-NEW-PART-NUM.
           MOVE WS-ERR-MSG        TO RPT01-ERR-MSG.
           MOVE DETAIL-01         TO REPORT-DATA.
           PERFORM R9100-INSERT-REPORT THRU R9100-EXIT.
           ADD 1 TO RS-ERR-RPT-INSRT-CTR.

       G3000-EXIT. EXIT.

      ***************************************************************
      * R1000-READ-OEM:                                             *
      *     1. READ PART-SUPPLIER-COUNTRY & PART-SUPPLIER TABLES    *
      ***************************************************************
       R1000-READ-OEM.
           MOVE "R1000-READ-OEM" TO WS-PARAGRAPH.
           MOVE WS-PARAGRAPH TO WS-PARNAME.
           MOVE "PART-SUPPLIER-COUNTRY" TO WS-TBLNAME.
           MOVE "SELECT " TO WS-FUNCTION.
           MOVE WS-REGION-LIT TO WS-REGION-LIT-X.

           EXEC SQL EXECUTE
             BEGIN
              PKG_SUPPLIER.P_PART_SUPLRCNTRY_SUPLR_SEL_01
                              (:WS-SEL-OEM-NUM,
                               :WS-REGION-LIT-X,
                               :WS-SEL-REGN-CD,
                               :WS-PART-SUPPLIER-NUMBER-OUT,
                               :WS-PART-SUPPLIER-NAME-RGN,
                               :WS-PART-SUPPLIER-NAME,
                               :WS-LAST-ASSY-DATE,
                               :WS-LAST-ASSY-IND,
                               :WS-LAST-COMPONENT-DATE,
                               :WS-LAST-COMPONENT-IND,
                               :WS-LAST-SUPERSESSION-DATE,
                               :WS-LAST-SUPER-IND,
                               :WS-LAST-DISCONTINUED-DATE,
                               :WS-LAST-DISC-IND,
                               :WS-LAST-PRICE-DATE,
                               :WS-LAST-PRICE-IND,
                               :WS-DISCONTINUED-TRAN-FLAG,
                               :WS-DISCONTINUED-MONTHLY-COUNT,
                               :WS-PART-COUNT,
