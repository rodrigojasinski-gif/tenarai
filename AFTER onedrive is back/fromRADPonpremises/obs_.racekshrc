######### shared COBOL stuff *********
export stage_sinc=/stage/race/share/inc
export stage_slib=/stage/race/share/lib
alias stage_sinc="cd $stage_sinc"
alias stage_slib="cd $stage_slib"
#
########## system-oriuented aliases #########
export gbin=/$ACT_LVL/race/bin             # shared by other race developers
alias  gbin="cd $gbin"                  # shared by other race developers
export sysbin=/mdev/util/share/bin      # shared by other Mitchell projects
alias  sysbin="cd $sysbin"              # shared by other Mitchell projects
#
########## unix aliases ##########
alias d='ls -aF'
alias rm='echo \	uh, use rmi '
alias rmi='/bin/rm -i'
alias vi='stty erase ^?;/usr/bin/vi'
alias hogs='ps aux | head -10'
#

######### rsh aliases ###########

alias  race_term="xterm -bg black -fg yellow -title race -e rsh race &"
alias media1_term="xterm -bg black -fg yellow -title media1 -e rsh media1 &"

alias media1="rsh media1"
alias  b8400="rsh b8400"
alias  a8400="rsh a8400"
alias  x8400="rsh x8400"
alias  y8400="rsh x8400"
alias media2="rsh media2"
alias race="rsh race"
alias raced="rsh raced"
#
# Make sort use /tmp
alias sort='sort -T /tmp'
